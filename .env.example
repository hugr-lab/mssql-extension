# MSSQL Extension Test Environment Configuration
# Copy this file to .env and modify as needed
# Used by docker-compose.yml and Makefile

# SQL Server connection parameters
MSSQL_TEST_HOST=localhost
MSSQL_TEST_PORT=1433
MSSQL_TEST_USER=sa
MSSQL_TEST_PASS=TestPassword1
MSSQL_TEST_DB=master

# TLS encryption (set to "true", "1", or "yes" to enable)
# Default: false (plaintext connection for backward compatibility)
MSSQL_TEST_ENCRYPT=false

# Debug logging (set to 1 or 2 for verbose output)
# 0 = disabled, 1 = basic debug, 2 = verbose row-level logging
MSSQL_DEBUG=0

#===----------------------------------------------------------------------===#
# Azure AD Authentication (Spec 032)
#
# Consumed by `make azure-test`, which passes through only the variables that
# are NON-EMPTY. Everything here is commented out on purpose: a `require-env`
# gate is satisfied by an empty or placeholder value just as well as by a real
# one, so leaving `AZURE_APP_ID=your-app-id` uncommented turns a clean skip into
# a live OAuth2 rejection in azure_auth_test_function_with_credentials.test.
# Uncomment a block only once you have real values for it.
#===----------------------------------------------------------------------===#

# Azure SQL Database connection info
# (these exact names are what test/sql/azure/*.test gates on)
# AZURE_SQL_DB_HOST=myserver.database.windows.net
# AZURE_SQL_DB=mydatabase

# Service Principal credentials (for service_principal provider)
# AZURE_APP_ID=your-app-id
# AZURE_DIRECTORY_ID=your-tenant-id
# AZURE_APP_SECRET=your-client-secret

# Azure SDK standard environment variables (for credential_chain with 'env' provider)
# These are the same values as above, using Azure SDK naming convention
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-app-id
# AZURE_CLIENT_SECRET=your-client-secret

# Pre-obtained access token (for ACCESS_TOKEN option testing)
# Get with: az account get-access-token --resource https://database.windows.net/ --query accessToken -o tsv
# AZURE_ACCESS_TOKEN=eyJ...

# Azure SQL DSN for the incremental-catalog-cache test (azure_lazy_loading.test).
# AZURE_SQL_DDL_OK is a SECOND, deliberate gate on the same file: it CREATEs,
# ALTERs and DROPs tables in `dbo` on whatever the DSN points at, so the DSN
# alone does not authorise that.
# AZURE_SQL_TEST_DSN=Server=myserver.database.windows.net;Database=mydb;User Id=me;Password=...;Encrypt=true
# AZURE_SQL_DDL_OK=1

# Microsoft Fabric warehouse (test/sql/fabric/fabric_types.test)
# Token: az account get-access-token --resource https://database.windows.net/ --query accessToken -o tsv
# AZURE_WH_HOST=xyz.datawarehouse.fabric.microsoft.com
# AZURE_WH_NAME=my_warehouse
# AZURE_WH_TOKEN=eyJ...

#===----------------------------------------------------------------------===#
# Other opt-in test gates
#
# Not read by any make target — export them in your shell when you want the
# file they gate to run. Listed here so the names exist somewhere outside
# test/sql (scripts/ci/check_require_env.sh enforces that).
#===----------------------------------------------------------------------===#

# Named-instance resolution via the SQL Server Browser, UDP 1434
# (test/sql/named_instance/named_instance_resolve.test)
# MSSQL_NAMED_INSTANCE_HOST=myhost\SQLEXPRESS

# Windows SSPI integrated auth (test/sql/integrated_auth/winsspi_basic.test);
# the POSIX peer is MSSQL_KERBEROS_TEST
# MSSQL_WINSSPI_TEST=1

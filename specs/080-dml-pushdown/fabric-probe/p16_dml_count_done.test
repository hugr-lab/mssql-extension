# name: p16_dml_count_done
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

statement ok
SELECT mssql_exec('wh', 'DROP TABLE IF EXISTS dbo.p080_c; CREATE TABLE dbo.p080_c (id INT NOT NULL, v INT); INSERT INTO dbo.p080_c VALUES (1,10),(2,20),(3,30)');

query I
SELECT mssql_exec('wh', 'UPDATE dbo.p080_c SET v = 0 WHERE id >= 2');
----
X

# name: p14_intersect_form
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

query I
SELECT * FROM mssql_scan_unsafe('wh', 'SELECT COUNT(*) AS c FROM (VALUES (1, NULL), (NULL, NULL), (2, 2)) AS x(a, b) WHERE EXISTS (SELECT x.a INTERSECT SELECT x.b)', columns := {'c': 'INTEGER'});
----
X

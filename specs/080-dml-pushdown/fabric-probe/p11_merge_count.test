# name: p11_merge_count
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

statement ok
SELECT mssql_exec('wh', 'DROP TABLE IF EXISTS dbo.p080_m2; CREATE TABLE dbo.p080_m2 (id INT NOT NULL, v INT); INSERT INTO dbo.p080_m2 VALUES (1,10),(2,20),(3,30)');

query I
SELECT mssql_exec('wh', 'CREATE TABLE #s (id int, v int); INSERT INTO #s VALUES (1, 1), (2, 2); MERGE dbo.p080_m2 AS t USING #s AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET v = s.v;');
----
X

# name: p17_server_properties
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

query IIII
SELECT * FROM mssql_scan_unsafe('wh', 'SELECT CAST(SERVERPROPERTY(''EngineEdition'') AS int) AS engine_edition, CAST(SERVERPROPERTY(''ProductMajorVersion'') AS nvarchar(20)) AS major, CAST(@@VERSION AS nvarchar(400)) AS version, DB_NAME() AS db', columns := {'engine_edition': 'INTEGER', 'major': 'VARCHAR', 'version': 'VARCHAR', 'db': 'VARCHAR'});
----
X	X	X	X

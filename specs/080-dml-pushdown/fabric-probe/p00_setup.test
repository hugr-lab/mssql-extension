# name: p00_setup
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

statement ok
SELECT mssql_exec('wh', 'DROP TABLE IF EXISTS dbo.p080_t; CREATE TABLE dbo.p080_t (id INT NOT NULL, v INT); INSERT INTO dbo.p080_t VALUES (1,10),(2,20),(3,30)');

query II
SELECT * FROM wh.dbo.p080_t ORDER BY id;
----
1	10
2	20
3	30

# name: p15_bulk_into_temp
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

statement ok
CREATE TEMP TABLE src AS SELECT range::INTEGER AS id, (range * 10)::INTEGER AS v FROM range(1000);

statement ok
BEGIN;

statement ok
SELECT mssql_exec('wh', 'CREATE TABLE #stage (id int, v int)');

statement ok
COPY src TO 'mssql://wh//#stage' (FORMAT 'bcp', CREATE_TABLE false);

query I
SELECT * FROM mssql_scan_unsafe('wh', 'SELECT COUNT(*) AS c FROM #stage', columns := {'c': 'INTEGER'});
----
X

statement ok
COMMIT;

# name: p04_out_param
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

statement ok
SELECT mssql_exec('wh', 'DROP TABLE IF EXISTS dbo.p080_04_t; CREATE TABLE dbo.p080_04_t (id INT NOT NULL, v INT); INSERT INTO dbo.p080_04_t VALUES (1,10),(2,20),(3,30)');

query I
SELECT * FROM mssql_scan_unsafe('wh', 'DECLARE @rc bigint; EXEC sp_executesql N''UPDATE dbo.p080_04_t SET v = v + 1 WHERE id IN (1, 2, 3); SET @rc = ROWCOUNT_BIG()'', N''@rc bigint OUTPUT'', @rc = @rc OUTPUT; SELECT @rc AS rc', columns := {'rc': 'BIGINT'});
----
X

statement ok
SELECT mssql_exec('wh', 'DROP TABLE IF EXISTS dbo.p080_04_t');

# name: p01_output
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

statement ok
SELECT mssql_exec('wh', 'DROP TABLE IF EXISTS dbo.p080_01_t; CREATE TABLE dbo.p080_01_t (id INT NOT NULL, v INT); INSERT INTO dbo.p080_01_t VALUES (1,10),(2,20),(3,30)');

query II
SELECT * FROM mssql_scan_unsafe('wh', 'UPDATE dbo.p080_01_t SET v = v + 1 OUTPUT inserted.id, inserted.v WHERE id = 1', columns := {'id': 'INTEGER', 'v': 'INTEGER'});
----
X

statement ok
SELECT mssql_exec('wh', 'DROP TABLE IF EXISTS dbo.p080_01_t');

# name: p01_output
# group: [fabric_probe]

require mssql

require-env AZURE_WH_HOST

require-env AZURE_WH_NAME

require-env AZURE_WH_TOKEN

statement ok
ATTACH 'Server={AZURE_WH_HOST};Database={AZURE_WH_NAME}' AS wh (TYPE mssql, ACCESS_TOKEN '{AZURE_WH_TOKEN}');

query II
SELECT * FROM mssql_scan_unsafe('wh', 'UPDATE dbo.p080_t SET v = v + 1 OUTPUT inserted.id, inserted.v WHERE id = 1', columns := {'id': 'INTEGER', 'v': 'INTEGER'});
----

# name: test/ephyra/repro/filter_two_collations.test
# description: a WHERE comparing two string columns of different collations fails with SQL Server error 468 on the catalog scan (found with ephyra, property dmldiff / qdiff)
# group: [catalog]

# Expected: a filter the server cannot answer as DuckDB would stays in DuckDB (CLAUDE.md,
# filter pushdown; the remote-pushdown writer already does this: "strings of one collation,
# else 468"). DuckDB's answer on the same rows is k = 2.
# Actual (4128e1ac), default settings: "SQL Server error [468, severity 16]: Cannot resolve
# the collation conflict between "Latin1_General_100_BIN2_UTF8" and "Latin1_General_100_BIN2"
# in the less than operation." -- SELECT, DELETE and UPDATE alike.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS ephc (TYPE mssql);

statement ok
SELECT mssql_exec('ephc', 'DROP TABLE IF EXISTS dbo.eph_cc; CREATE TABLE dbo.eph_cc (k int NOT NULL PRIMARY KEY, u varchar(20) COLLATE Latin1_General_100_BIN2_UTF8, v varchar(20) COLLATE Latin1_General_100_BIN2, n int); INSERT INTO dbo.eph_cc VALUES (1, ''a'', ''b'', 0), (2, ''b'', ''a'', 0), (3, ''a'', ''a'', 0)');

query I
SELECT k FROM ephc.dbo.eph_cc WHERE v < u;
----
2

statement ok
UPDATE ephc.dbo.eph_cc SET n = 1 WHERE v < u;

query II
SELECT k, n FROM ephc.dbo.eph_cc ORDER BY k;
----
1	0
2	1
3	0

statement ok
DELETE FROM ephc.dbo.eph_cc WHERE v < u;

query I
SELECT k FROM ephc.dbo.eph_cc ORDER BY k;
----
1
3

statement ok
SELECT mssql_exec('ephc', 'DROP TABLE dbo.eph_cc');

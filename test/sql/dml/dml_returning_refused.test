# name: test/sql/dml/dml_returning_refused.test
# description: UPDATE / DELETE ... RETURNING are refused by name, not an InternalException that invalidates the database (spec 080 PR 1)
# group: [dml]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS drr (TYPE mssql);

statement ok
SELECT mssql_exec('drr', 'DROP TABLE IF EXISTS dbo.drr_t; CREATE TABLE dbo.drr_t (id int PRIMARY KEY, v int); INSERT INTO dbo.drr_t VALUES (1, 10), (2, 20)');

statement error
UPDATE drr.dbo.drr_t SET v = v + 1 WHERE id = 1 RETURNING id, v;
----
UPDATE ... RETURNING is not supported yet

statement error
DELETE FROM drr.dbo.drr_t WHERE id = 2 RETURNING *;
----
DELETE ... RETURNING is not supported yet

# Refused before anything was sent, and the database is still usable.
query II
SELECT id, v FROM drr.dbo.drr_t ORDER BY id;
----
1	10
2	20

# INSERT ... RETURNING still works.
query I
INSERT INTO drr.dbo.drr_t VALUES (3, 30) RETURNING id;
----
3

statement ok
SELECT mssql_exec('drr', 'DROP TABLE dbo.drr_t');

statement ok
DETACH drr;

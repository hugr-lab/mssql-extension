# name: test/sql/dml/merge_staged.test
# description: MERGE INTO an MSSQL table through #src -- DuckDB computes the source, one T-SQL MERGE on the server writes it (spec 080 D4, PR 4b), in autocommit and in a transaction
# group: [dml]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database

require mssql

require-env MSSQL_TESTDB_DSN

# A MERGE whose source is in the same catalog goes to the server whole since
# spec 080 PR 4a (test/sql/pushdown/remote_pushdown_merge.test); off here, every
# MERGE below is staged: its source rows go into a session #src by INSERT BULK
# and one MERGE ... USING #src runs on the server (PR 4b). The native path, each
# action through PlanUpdate / PlanDelete / PlanInsert, is gone.
statement ok
SET mssql_dml_pushdown = false;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS mgn (TYPE mssql);

statement ok
SELECT mssql_exec('mgn', 'DROP TABLE IF EXISTS dbo.mgn_t; DROP TABLE IF EXISTS dbo.mgn_s; CREATE TABLE dbo.mgn_t (id int PRIMARY KEY, v int); CREATE TABLE dbo.mgn_s (id int PRIMARY KEY, w int); INSERT INTO dbo.mgn_t VALUES (1, 10), (2, 20), (3, 30); INSERT INTO dbo.mgn_s VALUES (2, 200), (3, NULL), (4, 400)');

# A DuckDB source: UPDATE, DELETE and INSERT actions in one statement.
query I
MERGE INTO mgn.dbo.mgn_t AS t
USING (SELECT * FROM (VALUES (1, 11), (2, NULL), (9, 90)) AS x(id, w)) AS s ON t.id = s.id
WHEN MATCHED AND s.w IS NULL THEN DELETE
WHEN MATCHED THEN UPDATE SET v = s.w
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.w);
----
3

query II
SELECT id, v FROM mgn.dbo.mgn_t ORDER BY id;
----
1	11
3	30
9	90

# A source in the same catalog, in a transaction: the scan is materialised and
# #src and the MERGE share the pinned connection.
statement ok
BEGIN;

query I
MERGE INTO mgn.dbo.mgn_t AS t USING mgn.dbo.mgn_s AS s ON t.id = s.id
WHEN MATCHED AND s.w IS NULL THEN DELETE
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.w);
----
3

query II
SELECT id, v FROM mgn.dbo.mgn_t ORDER BY id;
----
1	11
2	200
4	400
9	90

statement ok
ROLLBACK;

query II
SELECT id, v FROM mgn.dbo.mgn_t ORDER BY id;
----
1	11
3	30
9	90

# A transaction on a pool of many, threads on, a source of 3000 rows: #src is
# filled in several bulk-load batches (mssql_copy_flush_rows) on the one pinned
# connection.
statement ok
SET threads = 4;

statement ok
SET mssql_copy_flush_rows = 700;

statement ok
SELECT mssql_exec('mgn', 'DROP TABLE IF EXISTS dbo.mgn_big; CREATE TABLE dbo.mgn_big (id int PRIMARY KEY, v int); INSERT INTO dbo.mgn_big SELECT value, 0 FROM GENERATE_SERIES(1, 800)');

statement ok
BEGIN;

query I
MERGE INTO mgn.dbo.mgn_big AS t USING (SELECT i::INTEGER AS id FROM range(1, 3001) r(i)) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = 1
WHEN NOT MATCHED THEN INSERT VALUES (s.id, 2);
----
3000

query II
SELECT count(*) FILTER (WHERE v = 1), count(*) FILTER (WHERE v = 2) FROM mgn.dbo.mgn_big;
----
800	2200

statement ok
COMMIT;

query I
SELECT count(*) FROM mgn.dbo.mgn_big;
----
3000

statement ok
RESET threads;

statement ok
RESET mssql_copy_flush_rows;

# An INSERT action that names some columns: the others keep their server-side
# values -- identity, DEFAULT, computed -- as for a plain INSERT. DuckDB binds
# the action full width, so the rewrite leaves out every column whose value is
# a copy of its bound default (review of #423: a server DEFAULT was written
# NULL, an identity column refused).
statement ok
SELECT mssql_exec('mgn', 'DROP TABLE IF EXISTS dbo.mgn_def; CREATE TABLE dbo.mgn_def (id int IDENTITY(1,1) PRIMARY KEY, code int NOT NULL UNIQUE, v int NULL, created datetime2 NULL DEFAULT SYSDATETIME(), tag nvarchar(10) NOT NULL DEFAULT N''dflt'', twice AS (v * 2)); INSERT INTO dbo.mgn_def (code, v) VALUES (10, 1), (20, 2)');

query I
MERGE INTO mgn.dbo.mgn_def AS t USING (SELECT * FROM (VALUES (10, 100), (30, 300), (40, 400)) AS x(code, v)) AS s ON t.code = s.code
WHEN MATCHED THEN UPDATE SET v = s.v
WHEN NOT MATCHED THEN INSERT (code, v) VALUES (s.code, s.v);
----
3

query IIIIII
SELECT code, v, id IS NOT NULL, created IS NOT NULL, tag, twice FROM mgn.dbo.mgn_def ORDER BY code;
----
10	100	true	true	dflt	200
20	2	true	true	dflt	4
30	300	true	true	dflt	600
40	400	true	true	dflt	800

# The same inside a transaction, the INSERT action past one batch.
statement ok
BEGIN;

query I
MERGE INTO mgn.dbo.mgn_def AS t USING (SELECT (i + 1000)::INTEGER AS code FROM range(0, 1200) r(i)) AS s ON t.code = s.code
WHEN NOT MATCHED THEN INSERT (code) VALUES (s.code);
----
1200

query III
SELECT count(*), count(*) FILTER (WHERE tag = 'dflt' AND created IS NOT NULL AND v IS NULL), count(DISTINCT id) FROM mgn.dbo.mgn_def WHERE code >= 1000;
----
1200	1200	1200

statement ok
ROLLBACK;

# A NULL the INSERT action names is a NULL, not the column's DEFAULT: the
# NOT NULL column refuses it.
statement error
MERGE INTO mgn.dbo.mgn_def AS t USING (SELECT 70 AS code) AS s ON t.code = s.code
WHEN NOT MATCHED THEN INSERT (code, tag) VALUES (s.code, NULL);
----
NULL

# An INSERT action that names the identity column is refused by name: a MERGE
# runs without IDENTITY_INSERT. Nothing is sent.
statement error
MERGE INTO mgn.dbo.mgn_def AS t USING (SELECT * FROM (VALUES (10, 7, 9001), (50, 5, 9050)) AS x(code, v, id)) AS s ON t.code = s.code
WHEN MATCHED THEN UPDATE SET v = s.v
WHEN NOT MATCHED THEN INSERT (id, code, v) VALUES (s.id, s.code, s.v);
----
an INSERT naming the identity column 'id'

query I
SELECT count(*) FROM mgn.dbo.mgn_def WHERE id IN (9060, 9061);
----
0

# INSERT … DEFAULT VALUES has no statement form yet: refused by name as an
# INSERT (it sent an empty column list, error 102). As a MERGE action it is
# T-SQL's INSERT DEFAULT VALUES: here the NOT NULL code column has no default,
# and the server says so -- the whole MERGE is rolled back.
statement error
INSERT INTO mgn.dbo.mgn_def DEFAULT VALUES;
----
DEFAULT VALUES is not supported yet

statement error
MERGE INTO mgn.dbo.mgn_def AS t USING (SELECT 99 AS code) AS s ON t.code = s.code
WHEN NOT MATCHED THEN INSERT DEFAULT VALUES;
----
Cannot insert the value NULL into column 'code'

# A target row matched twice is an error on the server too (8672), as in
# DuckDB; the MERGE is rolled back whole.
statement error
MERGE INTO mgn.dbo.mgn_t AS t USING (SELECT * FROM (VALUES (1, 1), (1, 2)) AS x(id, w)) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.w;
----
more than once

query II
SELECT id, v FROM mgn.dbo.mgn_t ORDER BY id;
----
1	11
3	30
9	90

# =============================================================================
# The statement EXPLAIN shows: the match, the conditions and the writes in
# T-SQL, over the #src columns DuckDB computes.
# =============================================================================

query II
EXPLAIN MERGE INTO mgn.dbo.mgn_t AS t USING (SELECT * FROM (VALUES (1, 11)) AS x(id, w)) AS s ON t.id = s.id
WHEN MATCHED AND s.w > 5 THEN UPDATE SET v = t.v + s.w
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.w);
----
physical_plan	<REGEX>:.*Mssql Staged Merge.*MERGE \[dbo\]\.\[mgn_t\] AS \[t\] USING \[#src_[0-9a-f]+\] AS \[s\] ON \(\[s\]\.\[c0\] = \[t\]\.\[id\]\) WHEN MATCHED AND \(\[s\]\.\[c1\] = 1\) THEN UPDATE SET \[v\] = \(\[t\]\.\[v\] \+ \[s\]\.\[c2\]\) WHEN NOT MATCHED BY TARGET THEN INSERT \(\[id\], \[v\]\) VALUES \(\[s\]\.\[c3\], \[s\]\.\[c2\]\);.*

# =============================================================================
# WHEN NOT MATCHED BY SOURCE: alone (DuckDB's RIGHT join, planned as a LEFT
# one with its sides swapped) and beside BY TARGET (a FULL join).
# =============================================================================

statement ok
SELECT mssql_exec('mgn', 'DROP TABLE IF EXISTS dbo.mgn_x; CREATE TABLE dbo.mgn_x (id int PRIMARY KEY, v int NOT NULL); INSERT INTO dbo.mgn_x VALUES (1, 10), (2, 20), (3, 30)');

query I
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT * FROM (VALUES (2, 200), (4, 400)) AS x(id, w)) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.w
WHEN NOT MATCHED BY SOURCE AND t.v > 15 THEN DELETE
WHEN NOT MATCHED BY SOURCE THEN UPDATE SET v = t.v * 2;
----
3

query II
SELECT id, v FROM mgn.dbo.mgn_x ORDER BY id;
----
1	20
2	200

statement ok
SELECT mssql_exec('mgn', 'DELETE FROM dbo.mgn_x; INSERT INTO dbo.mgn_x VALUES (1, 10), (2, 20), (3, 30)');

query I
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT * FROM (VALUES (2, 200), (4, 400)) AS x(id, w)) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.w
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.w)
WHEN NOT MATCHED BY SOURCE AND t.v > 15 THEN DELETE;
----
3

query II
SELECT id, v FROM mgn.dbo.mgn_x ORDER BY id;
----
1	10
2	200
4	400

# An empty source: with a BY SOURCE clause the MERGE still runs, against an
# empty #src, and every target row is unmatched; without one nothing is sent.
query I
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT 1 AS id WHERE false) AS s ON t.id = s.id
WHEN MATCHED THEN DELETE;
----
0

query I
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT 1 AS id WHERE false) AS s ON t.id = s.id
WHEN NOT MATCHED BY SOURCE AND t.id > 1 THEN DELETE;
----
2

query II
SELECT id, v FROM mgn.dbo.mgn_x ORDER BY id;
----
1	10

# =============================================================================
# What DuckDB computes and what the server does: a source-only expression of
# any DuckDB function goes into #src; one that reads the target is written in
# T-SQL; a volatile one is evaluated per source row.
# =============================================================================

statement ok
SELECT mssql_exec('mgn', 'DELETE FROM dbo.mgn_x; INSERT INTO dbo.mgn_x VALUES (1, 10), (2, 20), (3, 30)');

query I
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT * FROM (VALUES (1, 'a,b,c'), (2, 'x'), (3, 'p,q')) AS x(id, csv)) AS s ON t.id = s.id
WHEN MATCHED AND len(string_split(s.csv, ',')) > 1 THEN UPDATE SET v = CASE WHEN t.v > 15 THEN t.v + len(string_split(s.csv, ',')) ELSE 0 END;
----
2

query II
SELECT id, v FROM mgn.dbo.mgn_x ORDER BY id;
----
1	0
2	20
3	32

query I
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT * FROM (VALUES (1), (2)) AS x(id)) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = (random() * 0)::INTEGER + 5;
----
2

query II
SELECT id, v FROM mgn.dbo.mgn_x ORDER BY id;
----
1	5
2	5
3	32

# Every action DO NOTHING: a no-op, as DuckDB's own MERGE ran it -- nothing is
# sent, the count is 0 (review of #478).
query I
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT * FROM (VALUES (1), (5)) AS x(id)) AS s ON t.id = s.id
WHEN MATCHED THEN DO NOTHING
WHEN NOT MATCHED THEN DO NOTHING;
----
0

query II
EXPLAIN MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT 1 AS id) AS s ON t.id = s.id WHEN MATCHED THEN DO NOTHING;
----
physical_plan	<REGEX>:.*Mssql Staged Merge.*every action is DO NOTHING.*

query II
SELECT id, v FROM mgn.dbo.mgn_x ORDER BY id;
----
1	5
2	5
3	32

# UPDATE with no SET list (every column, by position): T-SQL has no such form,
# but bound it is a SET of each column and is written so.
query I
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT 3 AS id, 33 AS w) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE;
----
1

query II
SELECT id, v FROM mgn.dbo.mgn_x WHERE id = 3;
----
3	33

statement ok
SELECT mssql_exec('mgn', 'UPDATE dbo.mgn_x SET v = 32 WHERE id = 3');

# A condition on the target alone in ON: under a LEFT join (a WHEN NOT MATCHED
# clause) DuckDB filters the target's side before the match, and so does the
# server's ON. A source row whose target row fails it is not matched.
statement ok
SELECT mssql_exec('mgn', 'DROP TABLE IF EXISTS dbo.mgn_k; CREATE TABLE dbo.mgn_k (k int NOT NULL, v int NOT NULL); INSERT INTO dbo.mgn_k VALUES (1, 10), (2, 20)');

query I
MERGE INTO mgn.dbo.mgn_k AS t USING (SELECT * FROM (VALUES (1, 100), (2, 200), (3, -1)) AS x(k, w)) AS s ON t.k = s.k AND t.v > 15 AND s.w > 0
WHEN MATCHED THEN UPDATE SET v = s.w
WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w);
----
3

query II
SELECT k, v FROM mgn.dbo.mgn_k ORDER BY k, v;
----
1	10
1	100
2	200
3	-1

# A string compared under the column's collation, the server's (D4): 'ABC'
# matches 'abc' under a case-insensitive one.
statement ok
SELECT mssql_exec('mgn', 'DROP TABLE IF EXISTS dbo.mgn_ci; CREATE TABLE dbo.mgn_ci (code nvarchar(10) COLLATE Latin1_General_CI_AS NOT NULL PRIMARY KEY, n int NOT NULL); INSERT INTO dbo.mgn_ci VALUES (N''ABC'', 0)');

query I
MERGE INTO mgn.dbo.mgn_ci AS t USING (SELECT 'abc' AS code) AS s ON t.code = s.code
WHEN MATCHED THEN UPDATE SET n = n + 1
WHEN NOT MATCHED THEN INSERT VALUES (s.code, 100);
----
1

query TI
SELECT code, n FROM mgn.dbo.mgn_ci;
----
ABC	1

# The ON condition split between the sides: under an INNER join (WHEN MATCHED
# only) the binder filters the source in DuckDB; under a FULL one every part
# stays in the server's ON; with WHEN NOT MATCHED BY SOURCE alone a condition on
# the target alone stays in ON too. Each as DuckDB's own MERGE decides.
statement ok
SELECT mssql_exec('mgn', 'DELETE FROM dbo.mgn_k; INSERT INTO dbo.mgn_k VALUES (1, 10), (2, 20), (3, 30)');

query I
MERGE INTO mgn.dbo.mgn_k AS t USING (SELECT * FROM (VALUES (1, 50), (2, 150)) AS x(k, w)) AS s ON t.k = s.k AND s.w > 100
WHEN MATCHED THEN UPDATE SET v = s.w;
----
1

query I
MERGE INTO mgn.dbo.mgn_k AS t USING (SELECT * FROM (VALUES (1, 100), (2, 200), (4, -5)) AS x(k, w)) AS s ON t.k = s.k AND s.w > 0 AND t.v > 15
WHEN MATCHED THEN UPDATE SET v = s.w
WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.w)
WHEN NOT MATCHED BY SOURCE THEN DELETE;
----
5

query II
SELECT k, v FROM mgn.dbo.mgn_k ORDER BY k;
----
1	100
2	200
4	-5

query I
MERGE INTO mgn.dbo.mgn_k AS t USING (SELECT * FROM (VALUES (1), (2), (4)) AS x(k)) AS s ON t.k = s.k AND t.v > 150
WHEN NOT MATCHED BY SOURCE THEN UPDATE SET v = 0;
----
2

query II
SELECT k, v FROM mgn.dbo.mgn_k ORDER BY k;
----
1	0
2	200
4	0

statement ok
SELECT mssql_exec('mgn', 'DELETE FROM dbo.mgn_k; INSERT INTO dbo.mgn_k VALUES (1, 10), (1, 100), (2, 200), (3, -1)');

# A string compared with a varchar under a code-page collation is compared in
# Unicode, as DuckDB compares it: 'Łukasz' is not 'Lukasz' and '日本' is not
# '??', though the code page would turn the first into the second of each.
statement ok
SELECT mssql_exec('mgn', 'DROP TABLE IF EXISTS dbo.mgn_cp; CREATE TABLE dbo.mgn_cp (name varchar(20) COLLATE SQL_Latin1_General_CP1_CI_AS NULL, n int NULL); INSERT INTO dbo.mgn_cp VALUES (''Lukasz'', 1), (''??'', 2)');

query I
MERGE INTO mgn.dbo.mgn_cp AS t USING (SELECT * FROM (VALUES ('Łukasz'), ('日本'), ('lukasz')) AS x(name)) AS s ON t.name = s.name
WHEN MATCHED THEN UPDATE SET n = n + 10
WHEN NOT MATCHED THEN INSERT (name, n) VALUES (s.name, 9);
----
3

query II
SELECT count(*) FILTER (WHERE n = 9), count(*) FILTER (WHERE n = 11 OR n = 2) FROM mgn.dbo.mgn_cp;
----
2	2

# A volatile value is one per use: two uuid() calls are two values.
statement ok
SELECT mssql_exec('mgn', 'DROP TABLE IF EXISTS dbo.mgn_u; CREATE TABLE dbo.mgn_u (id int NOT NULL, a uniqueidentifier NULL, b uniqueidentifier NULL)');

query I
MERGE INTO mgn.dbo.mgn_u AS t USING (SELECT * FROM (VALUES (1), (2)) AS x(id)) AS s ON t.id = s.id
WHEN NOT MATCHED THEN INSERT (id, a, b) VALUES (s.id, gen_random_uuid(), gen_random_uuid());
----
2

query II
SELECT count(*), count(*) FILTER (WHERE a = b) FROM mgn.dbo.mgn_u;
----
2	0

# =============================================================================
# One statement, atomic: a failing row rolls back every other.
# =============================================================================

statement error
MERGE INTO mgn.dbo.mgn_x AS t USING (SELECT * FROM (VALUES (1, 7), (2, NULL)) AS x(id, w)) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.w;
----
Cannot insert the value NULL into column 'v'

query II
SELECT id, v FROM mgn.dbo.mgn_x ORDER BY id;
----
1	5
2	5
3	32

# =============================================================================
# A pool of one connection: a source in the same catalog (not pushed here), in
# autocommit and in a transaction. The scan is materialised before #src takes
# the connection.
# =============================================================================

statement ok
SET mssql_connection_limit = 1;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS mgn1 (TYPE mssql);

statement ok
RESET mssql_connection_limit;

query I
MERGE INTO mgn1.dbo.mgn_x AS t USING (SELECT k, max(v) AS v FROM mgn1.dbo.mgn_k GROUP BY k) AS s ON t.id = s.k
WHEN MATCHED THEN UPDATE SET v = s.v;
----
3

statement ok
BEGIN;

query I
MERGE INTO mgn1.dbo.mgn_x AS t USING (SELECT k + 1 AS k, min(v) AS v FROM mgn1.dbo.mgn_k GROUP BY k) AS s ON t.id = s.k
WHEN MATCHED THEN UPDATE SET v = s.v
WHEN NOT MATCHED THEN INSERT VALUES (s.k, s.v);
----
3

query II
SELECT id, v FROM mgn1.dbo.mgn_x ORDER BY id;
----
1	100
2	10
3	200
4	-1

statement ok
ROLLBACK;

query II
SELECT id, v FROM mgn1.dbo.mgn_x ORDER BY id;
----
1	100
2	200
3	-1

statement ok
DETACH mgn1;

statement ok
SELECT mssql_exec('mgn', 'DROP TABLE dbo.mgn_x; DROP TABLE dbo.mgn_k; DROP TABLE dbo.mgn_ci; DROP TABLE dbo.mgn_cp; DROP TABLE dbo.mgn_u');

statement ok
SELECT mssql_exec('mgn', 'DROP TABLE dbo.mgn_t; DROP TABLE dbo.mgn_s; DROP TABLE dbo.mgn_big; DROP TABLE dbo.mgn_def');

statement ok
DETACH mgn;

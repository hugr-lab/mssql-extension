# name: test/sql/dml/dml_unmaterialised_scan_refused.test
# description: With the extension's optimizer disabled the scan feeding a DML in a transaction is not materialised; a batch sent then is refused by name instead of clearing the scan's receive buffer (review of #423)
# group: [dml]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS dus (TYPE mssql);

statement ok
SELECT mssql_exec('dus', 'DROP TABLE IF EXISTS dbo.dus_t; CREATE TABLE dbo.dus_t (id int PRIMARY KEY, v int); INSERT INTO dbo.dus_t SELECT value, 0 FROM GENERATE_SERIES(1, 3000)');

statement ok
SET enable_optimizer = false;

statement ok
BEGIN;

# Past one batch (500 rows): the first batch would be sent while the scan still
# streams on the pinned connection.
statement error
UPDATE dus.dbo.dus_t SET v = 1 WHERE id <= 2000;
----
the transaction's connection is busy

statement ok
ROLLBACK;

statement ok
RESET enable_optimizer;

# Nothing was changed, and the catalog reads correctly afterwards.
query II
SELECT count(*), count(*) FILTER (WHERE v = 0) FROM dus.dbo.dus_t;
----
3000	3000

# With the optimizer on, the same statement runs.
statement ok
BEGIN;

query I
UPDATE dus.dbo.dus_t SET v = 1 WHERE id <= 2000;
----
2000

statement ok
ROLLBACK;

statement ok
SELECT mssql_exec('dus', 'DROP TABLE dbo.dus_t');

statement ok
DETACH dus;

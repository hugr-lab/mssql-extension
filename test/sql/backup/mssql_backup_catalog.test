# name: test/sql/backup/mssql_backup_catalog.test
# description: mssql_backup_catalog over the committed samples: a table of schema sys read by the scan, as any table
# group: [mssql]
#
# The samples are synthetic (test/backup/gen/samples.sql). No SQL Server is needed. Owner, 2026-11-22: every
# table of the database is read, whoever made it and however it is stored -- a system base table (S), an
# internal one (IT), a heap, a non-unique clustered key, a compressed one -- by the one scan:
# mssql_backup_catalog(path, t) is mssql_backup_scan(path, 'sys', t), and an attached backup's bk.sys.t.

require mssql

# A big-endian hex string of n bytes, as its little-endian byte order.
statement ok
CREATE MACRO le(h, n) AS list_reduce(list_transform(range(n), lambda i: substr(h, (n - i - 1) * 2 + 1, 2)), lambda a, b: a || b);

# The tables of schema sys are listed by mssql_backup_tables, every one readable.
query III
SELECT count(*), count(*) FILTER (WHERE decodable), count(row_count) FROM mssql_backup_tables('test/data/backup/full.bak')
WHERE schema_name = 'sys';
----
115	115	115

# Each reads whole: its count the rowset's.
query T
SELECT bool_and(l.row_count = (SELECT count(*) FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysowners')))
FROM mssql_backup_tables('test/data/backup/full.bak') l WHERE l.schema_name = 'sys' AND l.table_name = 'sysowners';
----
true

query T
SELECT bool_and(l.row_count = (SELECT count(*) FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysschobjs')))
FROM mssql_backup_tables('test/data/backup/full.bak') l WHERE l.schema_name = 'sys' AND l.table_name = 'sysschobjs';
----
true

# The same rows as the scan of schema sys.
query I
SELECT count(*) FROM (SELECT *, _mssql_rid FROM mssql_backup_catalog('test/data/backup/full.bak', 'syscolpars')
                      EXCEPT SELECT *, _mssql_rid FROM mssql_backup_scan('test/data/backup/full.bak', 'sys', 'syscolpars'));
----
0

# Two tables in one statement each read their own (the calls differ by their parameters).
query II
SELECT (SELECT count(*) FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysschobjs')),
       (SELECT count(*) FROM mssql_backup_catalog('test/data/backup/full.bak', 'syscolpars'));
----
2909	1280

# Rows typed as TYPE mssql reads them: a char(2) trimmed, as the scan reads one.
query TIT
SELECT name, nsid, type FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysschobjs')
WHERE name IN ('items', 'events') AND nsid = 1 ORDER BY name;
----
events	1	U
items	1	U

# The virtual columns: not in SELECT *, there when named. _mssql_page is '01' + file + page (14 hex
# digits); _mssql_rid is the scan's -- 0x01 then the key: sysschobjs' is id, an int (u16 length 4 + its 4
# bytes).
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysschobjs'))
WHERE column_name LIKE '\_mssql\_%' ESCAPE '\';
----
0

query TTT
SELECT bool_and(_mssql_page SIMILAR TO '01[0-9A-F]{12}'), bool_and(octet_length(_mssql_rid) = 7),
       bool_and(hex(_mssql_rid) = '010400' || substr(h, 7, 2) || substr(h, 5, 2) || substr(h, 3, 2) || substr(h, 1, 2))
FROM (SELECT *, printf('%08X', id::BIGINT & 4294967295) AS h, _mssql_page, _mssql_rid
      FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysschobjs'));
----
true	true	true

# A composite key, byte for byte: sysrscols' (rsid bigint, hbcolid int).
query T
SELECT bool_and(hex(_mssql_rid) = '010800' || le(printf('%016X', rsid), 8) || '0400' || le(printf('%08X', hbcolid::BIGINT & 4294967295), 4))
FROM (SELECT *, _mssql_rid FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysrscols'));
----
true

# _mssql_rid identifies a row: one per key.
query T
SELECT count(DISTINCT _mssql_rid) = count(*) FROM mssql_backup_catalog('test/data/backup/full_xpress.bak', 'syscolpars');
----
true

# The datetimes as mssql_backup_tables reads them (one conversion).
query T
SELECT o.created = t.created
FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysschobjs') o
JOIN mssql_backup_tables('test/data/backup/full.bak') t ON t.object_id = o.id WHERE t.table_name = 'items';
----
true

# sysobjvalues whole: all 242 rows, module source included (whoever holds the backup may read it).
query I
SELECT count(*) FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysobjvalues');
----
242

# Its sql_variant column, value, read as a VARIANT of the stored base types (spec 093 T8b): bit, int,
# bigint and nvarchar values, and NULLs. A pin of what the reader reads from the committed full.bak: the
# oracle lane compares user tables with the server, not this one (read through the DAC only). No value
# is refused: a refused one is NULL too, so the log must say nothing of the column.
statement ok
SET enable_logging = true;

statement ok
CALL truncate_duckdb_logs();

query TII
SELECT variant_typeof(value), count(*), count(value)
FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysobjvalues') GROUP BY 1 ORDER BY 1;
----
BOOL_FALSE	1	1
BOOL_TRUE	1	1
INT32	20	20
INT64	198	198
VARCHAR	20	20
VARIANT_NULL	2	0

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE '%(sql_variant) holds%';
----
0

statement ok
SET enable_logging = false;

query IIIITT
SELECT valclass, objid, subobjid, valnum, variant_typeof(value), value::VARCHAR
FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysobjvalues')
WHERE (valclass = 7 AND objid IN (101, 1010, 1037, 1038)) OR (valclass = 10 AND objid = 1)
ORDER BY valclass, objid, subobjid, valnum;
----
7	101	34	0	INT32	1525580473
7	1010	0	1	VARIANT_NULL	NULL
7	1037	0	1	BOOL_TRUE	true
7	1038	0	1	BOOL_FALSE	false
10	1	1	1	VARCHAR	microsoft.sqlserver.types.dll
10	1	1	2	VARIANT_NULL	NULL

# A heap is read as the scan reads one, its rows identified by their place (0x00, then page, file, slot):
# sysfiles1 has no clustered key (the reader used to refuse it, and sysxmitqueue beside it).
query TIT
SELECT table_name, row_count, shape FROM mssql_backup_tables('test/data/backup/full.bak')
WHERE table_name IN ('sysfiles1', 'sysxmitqueue') ORDER BY 1;
----
sysfiles1	2	heap
sysxmitqueue	0	clustered

query IT
SELECT count(*), bool_and(octet_length(_mssql_rid) = 9 AND substr(hex(_mssql_rid), 1, 2) = '00')
FROM (SELECT _mssql_rid FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysfiles1'));
----
2	true

# An internal table (Query Store's), its text stored off row read whole.
query I
SELECT count(*) FROM mssql_backup_catalog('test/data/backup/full.bak', 'plan_persist_query_text')
WHERE query_sql_text LIKE 'WITH n AS (SELECT TOP (2000)%INSERT INTO dbo.items%';
----
1

# A name that is no table of schema sys is refused by name, as the scan's.
statement error
SELECT * FROM mssql_backup_catalog('test/data/backup/full.bak', 'sysnothing');
----
mssql_backup_catalog: the backup has no table or indexed view sys.sysnothing

statement error
SELECT * FROM mssql_backup_catalog('test/data/backup/full.bak', NULL::VARCHAR);
----
mssql_backup_catalog: the schema and the table must not be NULL

statement error
SELECT * FROM mssql_backup_catalog('test/data/backup/log.trn', 'sysschobjs');
----
is a log backup

# name: test/sql/backup/mssql_backup_lob_changes.test
# description: mssql_backup_table_changes over values stored off row changed every way (spec 085 PR 4c-3, the LOB tail)
# group: [mssql]
#
# test/data/backup/lob_changes (test/backup/gen/lob_changes.sql, SQL Server 2025, compressed): a full, a
# differential after the changes, and one after a shrink that moves the LOB pages and rewrites the
# records it moves (both over the full). The forms: root pointers (a varchar(max) replaced, appended,
# overwritten in place; UPDATETEXT; a varbinary(max) replaced at its length), a small value grown off row,
# in-row roots (replaced, appended, overwritten, set to itself, a row deleted, one inserted), row-overflow
# (replaced at its length, shortened back in row, the fixed column alone, the other replaced, set to
# itself), values under 8,000 bytes (replaced, overwritten, set to itself, to NULL, from NULL), text
# (WRITETEXT, UPDATETEXT inserting and deleting), a varchar(max) and a char(200) dropped before the full,
# a column copied into a new one and dropped between the two (every row updated), a bit added with a
# default and the table rebuilt (no change), columns added (one nullable, one with a default) and one
# dropped between the two, one row's new column set (that row alone, however the shrink moves the
# rest). Each result is checked against a whole comparison of the two states' rows (EXCEPT ALL both
# ways). No SQL Server is needed.

require mssql

foreach diff diff shrink

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'lobs', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
update_postimage=5,update_preimage=5

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'inrow', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
update_postimage=1,update_preimage=1

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'inroot', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
delete=1,insert=1,update_postimage=3,update_preimage=3

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'overflow', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
update_postimage=4,update_preimage=4

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'small', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
update_postimage=4,update_preimage=4

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'texts', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
update_postimage=3,update_preimage=3

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'dropped', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
update_postimage=1,update_preimage=1

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'dropped_inrow', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
none

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'renamed', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
update_postimage=4,update_preimage=4

query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'defaults', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
none


query T
SELECT coalesce(string_agg(change_type || '=' || n, ',' ORDER BY change_type), 'none') FROM (SELECT change_type, count(*) n FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'evolved', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak') GROUP BY 1);
----
update_postimage=1,update_preimage=1

# On the columns the older state has and the one it gained (x NULL there, as the preimages give it); y's
# default stands for every row in the newer state, never a change.
query II
WITH o AS (SELECT id, l, NULL::INTEGER AS x FROM mssql_backup_scan('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'evolved')),
  n AS (SELECT id, l, x FROM mssql_backup_scan('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'evolved', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak')),
  c AS (SELECT * FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'evolved', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak')),
  c_new AS (SELECT id, l, x FROM c WHERE change_type IN ('insert', 'update_postimage')),
  c_old AS (SELECT id, l, x FROM c WHERE change_type IN ('delete', 'update_preimage')),
  t_new AS (SELECT * FROM n EXCEPT ALL SELECT * FROM o),
  t_old AS (SELECT * FROM o EXCEPT ALL SELECT * FROM n)
SELECT (SELECT count(*) FROM (SELECT * FROM t_new EXCEPT ALL SELECT * FROM c_new)) + (SELECT count(*) FROM (SELECT * FROM c_new EXCEPT ALL SELECT * FROM t_new)),
  (SELECT count(*) FROM (SELECT * FROM t_old EXCEPT ALL SELECT * FROM c_old)) + (SELECT count(*) FROM (SELECT * FROM c_old EXCEPT ALL SELECT * FROM t_old));
----
0	0

endloop

foreach diff diff shrink

foreach t lobs inrow inroot overflow small texts dropped dropped_inrow defaults

query II
WITH o AS (SELECT * FROM mssql_backup_scan('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', '{t}')),
  n AS (SELECT * FROM mssql_backup_scan('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', '{t}', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak')),
  c AS (SELECT * FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', '{t}', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak')),
  c_new AS (SELECT * EXCLUDE (change_type, _mssql_rid) FROM c WHERE change_type IN ('insert', 'update_postimage')),
  c_old AS (SELECT * EXCLUDE (change_type, _mssql_rid) FROM c WHERE change_type IN ('delete', 'update_preimage')),
  t_new AS (SELECT * FROM n EXCEPT ALL SELECT * FROM o),
  t_old AS (SELECT * FROM o EXCEPT ALL SELECT * FROM n)
SELECT (SELECT count(*) FROM (SELECT * FROM t_new EXCEPT ALL SELECT * FROM c_new)) + (SELECT count(*) FROM (SELECT * FROM c_new EXCEPT ALL SELECT * FROM t_new)),
  (SELECT count(*) FROM (SELECT * FROM t_old EXCEPT ALL SELECT * FROM c_old)) + (SELECT count(*) FROM (SELECT * FROM c_old EXCEPT ALL SELECT * FROM t_old));
----
0	0

endloop

# The column copied and dropped: the older rows on the newer columns (c NULL), every row updated.
query II
WITH o AS (SELECT id, l, NULL::VARCHAR AS c FROM mssql_backup_scan('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'renamed')),
  n AS (SELECT id, l, c FROM mssql_backup_scan('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'renamed', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak')),
  c AS (SELECT * FROM mssql_backup_table_changes('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'renamed', diff := 'test/data/backup/lob_changes/lob_changes_{diff}.bak')),
  c_new AS (SELECT id, l, c FROM c WHERE change_type IN ('insert', 'update_postimage')),
  c_old AS (SELECT id, l, c FROM c WHERE change_type IN ('delete', 'update_preimage')),
  t_new AS (SELECT * FROM n EXCEPT ALL SELECT * FROM o),
  t_old AS (SELECT * FROM o EXCEPT ALL SELECT * FROM n)
SELECT (SELECT count(*) FROM (SELECT * FROM t_new EXCEPT ALL SELECT * FROM c_new)) + (SELECT count(*) FROM (SELECT * FROM c_new EXCEPT ALL SELECT * FROM t_new)),
  (SELECT count(*) FROM (SELECT * FROM t_old EXCEPT ALL SELECT * FROM c_old)) + (SELECT count(*) FROM (SELECT * FROM c_old EXCEPT ALL SELECT * FROM t_old));
----
0	0

endloop

# A row's values stored off row are reserved before the row is staged (spec 085 D17): a row whose values
# cannot fit the scan's half of max_memory beside a chunk's decoding is refused by name -- the row by
# its _mssql_rid and its place, and what it holds off row. (A chunk that cannot fit at all is
# mssql_backup_scan.test's.)
statement error
SELECT * FROM mssql_backup_scan('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'inroot', max_memory := '300KB');
----
dbo.inroot: the row of _mssql_rid 0x01040001000000 (page 1:1000 slot 0), whose values stored off row (dbo.inroot.v (19.5 KiB)), need up to

# Given the room, the same rows are read.
query I
SELECT count(*) > 0 FROM (SELECT * FROM mssql_backup_scan('test/data/backup/lob_changes/lob_changes_full.bak', 'dbo', 'inroot', max_memory := '64MB'));
----
true

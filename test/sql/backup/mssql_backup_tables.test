# name: test/sql/backup/mssql_backup_tables.test
# description: mssql_backup_tables / mssql_backup_views over the committed samples (spec 085 PR 2b)
# group: [mssql]
#
# The samples are synthetic (test/backup/gen/samples.sql): dbo.items (a clustered primary key) and
# dbo.events (a heap), no view. The column types are the ones TYPE mssql gives (spec 085 D6). The
# catalog fixture's richer shapes are compared with the server's own catalog in the oracle lane
# (test/backup/compare_catalog.py). No SQL Server is needed.

require mssql

query TTITTIITTI
SELECT schema_name, table_name, object_id > 0, shape, compression, partition_count, row_count, decodable, reason,
       len(columns)
FROM mssql_backup_tables('test/data/backup/full.bak') ORDER BY table_name;
----
dbo	events	1	heap	none	1	3000	true	NULL	4
dbo	items	1	clustered	none	1	2000	true	NULL	7

# Every form of the full lists the same tables.
query TI
SELECT table_name, row_count FROM mssql_backup_tables(['test/data/backup/stripe_zstd_1.bak', 'test/data/backup/stripe_zstd_2.bak'])
ORDER BY table_name;
----
events	3000
items	2000

query ITTTTITTT
SELECT c.column_id, c.name, c.sql_type, c.duckdb_type, c.collation, c.code_page, c.is_nullable, c.decodable, c.reason
FROM (SELECT unnest(columns) AS c FROM mssql_backup_tables('test/data/backup/full_xpress.bak') WHERE table_name = 'items');
----
1	id	int	INTEGER	NULL	NULL	false	true	NULL
2	name	nvarchar(40)	VARCHAR	SQL_Latin1_General_CP1_CI_AS	1252	false	true	NULL
3	code	varchar(12)	VARCHAR	SQL_Latin1_General_CP1_CI_AS	1252	true	true	NULL
4	price	decimal(12,2)	DECIMAL(12,2)	NULL	NULL	false	true	NULL
5	created	datetime2(3)	TIMESTAMP_MS	NULL	NULL	false	true	NULL
6	flag	bit	BOOLEAN	NULL	NULL	false	true	NULL
7	blob	varbinary(64)	BLOB	NULL	NULL	true	true	NULL

# The schemas, as sys.schemas lists them (spec 085 PR 2d), with the tables and views in each.
query ITII
SELECT * FROM mssql_backup_schemas('test/data/backup/full.bak') WHERE schema_id < 16384 ORDER BY schema_id;
----
1	dbo	2	0
2	guest	0	0
3	INFORMATION_SCHEMA	0	0
4	sys	0	0

query I
SELECT count(*) FROM mssql_backup_schemas('test/data/backup/full.bak') WHERE schema_name LIKE 'db\_%' ESCAPE '\';
----
9

# A table's allocation units: one in-row unit, its IAM chain's first page named; no live-page count
# before the scan walks the chain (DQ-40).
query TITTT
SELECT a.type, a.index_id, a.first_iam_page IS NOT NULL, a.au_id > 0, a.live_pages IS NULL
FROM (SELECT unnest(allocation_units) AS a FROM mssql_backup_tables('test/data/backup/full.bak') WHERE table_name = 'events');
----
IN_ROW_DATA	0	true	true	true

# The dates: created before modified or with it, within the day the samples were made.
query T
SELECT bool_and(created <= modified AND created >= TIMESTAMP '2026-01-01') FROM mssql_backup_tables('test/data/backup/full.bak');
----
true

# Not yet located: NULL, never guessed. The samples' tables are not partitioned: no partitioning, one
# partition on PRIMARY.
query TTTT
SELECT bool_and(fuzzy_status IS NULL), bool_and(open_transactions IS NULL), bool_and(stale_transactions IS NULL),
       bool_and(partitioning IS NULL)
FROM mssql_backup_tables('test/data/backup/full.bak');
----
true	true	true	true

query TITT
SELECT table_name, p.partition_number, p.filegroup, p.compression
FROM (SELECT table_name, unnest(partitions) AS p FROM mssql_backup_tables('test/data/backup/full.bak')) ORDER BY table_name;
----
events	1	PRIMARY	none
items	1	PRIMARY	none

query I
SELECT count(*) FROM mssql_backup_views('test/data/backup/full.bak');
----
0

# A differential is read over its full (not yet), and a log backup holds no data pages.
statement error
SELECT * FROM mssql_backup_tables('test/data/backup/diff.bak');
----
is a differential backup

statement error
SELECT * FROM mssql_backup_views('test/data/backup/log.trn');
----
mssql_backup_views: backup file "test/data/backup/log.trn" is a log backup

statement error
SELECT * FROM mssql_backup_tables(NULL::VARCHAR);
----
the path is NULL

# Task 16e: a filter on schema_name / table_name / view_name narrows the objects the catalog model is
# built for; DuckDB still applies every filter, so the rows are those of the unfiltered listing.
query T
SELECT table_name FROM mssql_backup_tables('test/data/backup/full.bak') WHERE table_name = 'items';
----
items

query T
SELECT table_name FROM mssql_backup_tables('test/data/backup/full.bak')
WHERE table_name IN ('items', 'events', 'nothing') AND schema_name = 'dbo' ORDER BY 1;
----
events
items

query T
SELECT table_name FROM mssql_backup_tables('test/data/backup/full.bak')
WHERE table_name = 'items' OR table_name = 'events' ORDER BY 1;
----
events
items

# A filter the pushdown does not read narrows nothing, and still filters.
query T
SELECT table_name FROM mssql_backup_tables('test/data/backup/full.bak') WHERE lower(table_name) = 'items';
----
items

query I
SELECT count(*) FROM mssql_backup_tables('test/data/backup/full.bak') WHERE table_name = 'items' AND table_name = 'events';
----
0

query I
SELECT count(*) FROM mssql_backup_tables('test/data/backup/full.bak') WHERE table_name = NULL;
----
0

# Through an unnest of the columns, and on the schemas' counts (narrowed by schema only).
query I
SELECT count(*) FROM (SELECT table_name, unnest(columns) FROM mssql_backup_tables('test/data/backup/full.bak'))
WHERE table_name = 'items';
----
7

query TII
SELECT schema_name, table_count, view_count FROM mssql_backup_schemas('test/data/backup/full.bak') WHERE schema_name = 'dbo';
----
dbo	2	0

query I
SELECT count(*) FROM mssql_backup_views('test/data/backup/full.bak') WHERE view_name = 'v';
----
0

# The scope a call describes, in EXPLAIN (task 16e): the filters narrow it.
query II
EXPLAIN SELECT * FROM mssql_backup_tables('test/data/backup/full.bak') WHERE table_name IN ('items', 'events') AND schema_name = 'dbo';
----
physical_plan	<REGEX>:.*schemas \{dbo\}; tables \{events, items\}; no views.*

query II
EXPLAIN SELECT * FROM mssql_backup_tables('test/data/backup/full.bak') WHERE lower(table_name) = 'items';
----
physical_plan	<REGEX>:.*Describes: no views.*

query II
EXPLAIN SELECT * FROM mssql_backup_views('test/data/backup/full.bak') WHERE view_name = 'v' OR view_name = 'w';
----
physical_plan	<REGEX>:.*no tables; views \{v, w\}.*

query II
EXPLAIN SELECT * FROM mssql_backup_schemas('test/data/backup/full.bak') WHERE schema_name = 'dbo';
----
physical_plan	<REGEX>:.*Describes: schemas \{dbo\}.*

query II
EXPLAIN SELECT * FROM mssql_backup_columns('test/data/backup/full.bak', 'dbo') WHERE table_name = 'items';
----
physical_plan	<REGEX>:.*schemas \{dbo\}; tables \{items\}; no views.*

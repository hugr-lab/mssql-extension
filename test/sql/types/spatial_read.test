# A LineString of 5000 points, and a NULL in each table.
statement ok
SELECT mssql_exec('sp', 'INSERT INTO dbo.SpatialReadM (id, name, g) SELECT 100, ''line_5000'', geometry::STGeomFromText(''LINESTRING('' + STRING_AGG(CAST(CONCAT(n, '' '', n % 97, ''.5'') AS varchar(max)), '', '') WITHIN GROUP (ORDER BY n) + '')'', 0) FROM (SELECT TOP (5000) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n FROM sys.all_objects a CROSS JOIN sys.all_objects b) s;
	INSERT INTO dbo.SpatialReadM (id, name, g) VALUES (99, ''null'', NULL);
	INSERT INTO dbo.SpatialReadG (id, name, g) VALUES (99, ''null'', NULL)');

statement ok
SELECT mssql_invalidate_cache('sp');

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS sp_wkb (TYPE mssql, geometry_as 'wkb');

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS sp_nat (TYPE mssql, geometry_as 'native');

# =============================================================================
# The types
# =============================================================================

query TTTTTT
SELECT typeof(m.g), typeof(g.g), typeof(mw.g), typeof(gw.g), typeof(mn.g), typeof(gn.g)
FROM sp.dbo.SpatialReadM m, sp.dbo.SpatialReadG g, sp_wkb.dbo.SpatialReadM mw, sp_wkb.dbo.SpatialReadG gw,
	sp_nat.dbo.SpatialReadM mn, sp_nat.dbo.SpatialReadG gn
WHERE m.id = 1 AND g.id = 1 AND mw.id = 1 AND gw.id = 1 AND mn.id = 1 AND gn.id = 1;
----
GEOMETRY	GEOMETRY('OGC:CRS84')	BLOB	BLOB	BLOB	BLOB

statement error
ATTACH '{MSSQL_TESTDB_DSN}' AS sp_bad (TYPE mssql, geometry_as 'blob');
----
the ATTACH option geometry_as must be 'geometry'

# =============================================================================
# geometry_as 'wkb': every value is the server's AsBinaryZM(), the curves and FullGlobe included
# =============================================================================

query II
SELECT count(*), count(*) FILTER (WHERE t.g IS NOT DISTINCT FROM s.zm)
FROM sp_wkb.dbo.SpatialReadM t JOIN mssql_scan('sp', 'SELECT id, g.AsBinaryZM() AS zm FROM dbo.SpatialReadM') s USING (id)
WHERE t.name NOT IN ('point_empty', 'mpoint_with_empty', 'gc_with_empty', 'mpoint_z_empty');
----
43	43

query II
SELECT count(*), count(*) FILTER (WHERE t.g IS NOT DISTINCT FROM s.zm)
FROM sp_wkb.dbo.SpatialReadG t JOIN mssql_scan('sp', 'SELECT id, g.AsBinaryZM() AS zm FROM dbo.SpatialReadG') s USING (id)
WHERE t.name <> 'g_point_empty';
----
19	19

# POINT EMPTY is DuckDB's: a point of two NaN, kept as a MULTIPOINT's or a collection's member
query TT
SELECT name, hex(g) FROM sp_wkb.dbo.SpatialReadM WHERE name IN ('point_empty', 'mpoint_with_empty', 'gc_with_empty') ORDER BY name;
----
gc_with_empty	0107000000020000000101000000000000000000F87F000000000000F87F0101000000000000000000F03F0000000000000040
mpoint_with_empty	0104000000020000000101000000000000000000F03F00000000000000400101000000000000000000F87F000000000000F87F
point_empty	0101000000000000000000F87F000000000000F87F

# FullGlobe as the server writes it: type 126
query T
SELECT hex(g) FROM sp_wkb.dbo.SpatialReadG WHERE name = 'g_fullglobe';
----
017E000000

# =============================================================================
# geometry_as 'native': the stored bytes, CAST(g AS varbinary(max)) (G2)
# =============================================================================

query II
SELECT count(*), count(*) FILTER (WHERE t.g IS NOT DISTINCT FROM s.raw)
FROM sp_nat.dbo.SpatialReadM t JOIN mssql_scan('sp', 'SELECT id, CAST(g AS varbinary(max)) AS raw FROM dbo.SpatialReadM') s USING (id);
----
47	47

query II
SELECT count(*), count(*) FILTER (WHERE t.g IS NOT DISTINCT FROM s.raw)
FROM sp_nat.dbo.SpatialReadG t JOIN mssql_scan('sp', 'SELECT id, CAST(g AS varbinary(max)) AS raw FROM dbo.SpatialReadG') s USING (id);
----
20	20

# =============================================================================
# geometry_as 'geometry' (the default): a GEOMETRY, a curve or FullGlobe NULL
# =============================================================================

query II
SELECT count(*), count(*) FILTER (WHERE t.g::BLOB IS NOT DISTINCT FROM s.zm)
FROM sp.dbo.SpatialReadM t JOIN mssql_scan('sp', 'SELECT id, g.AsBinaryZM() AS zm FROM dbo.SpatialReadM') s USING (id)
WHERE t.name NOT IN ('point_empty', 'mpoint_with_empty', 'gc_with_empty', 'mpoint_z_empty', 'circ', 'circ_empty', 'compound', 'curvepoly', 'gc_curve', 'gc_curvepoly', 'curvepoly_hole');
----
36	36

query II
SELECT count(*), count(*) FILTER (WHERE t.g::BLOB IS NOT DISTINCT FROM s.zm)
FROM sp.dbo.SpatialReadG t JOIN mssql_scan('sp', 'SELECT id, g.AsBinaryZM() AS zm FROM dbo.SpatialReadG') s USING (id)
WHERE t.name NOT IN ('g_point_empty', 'g_circ', 'g_compound', 'g_curvepoly', 'g_fullglobe');
----
15	15

# IS NULL is the server's (owner, 2026-11-20): true NULLs only, the curves, read as NULL here, not matched --
# so a DELETE ... WHERE g IS NULL leaves them alone.
query T
SELECT name FROM sp.dbo.SpatialReadM WHERE g IS NULL ORDER BY name;
----
null

query T
SELECT name FROM sp.dbo.SpatialReadG WHERE g IS NULL ORDER BY name;
----
null

# ... and IS NOT NULL / count(g) too: the server counts a curve, which DuckDB read as NULL. Evaluated by DuckDB
# (an expression over the column, never pushed) the count is of what DuckDB read.
query II
SELECT count(*), count(g) FROM sp.dbo.SpatialReadM;
----
47	46

query I
SELECT count(g::BLOB) FROM sp.dbo.SpatialReadM;
----
39

# read as BLOB, a curve is a value: IS NULL is pushed and answers as the server does
query I
SELECT count(*) FROM sp_wkb.dbo.SpatialReadM WHERE g IS NULL;
----
1

# Z and M kept, geography longitude first, POINT EMPTY as DuckDB's, the SRID not checked (DQ-45)
query TT
SELECT name, g::VARCHAR FROM sp.dbo.SpatialReadM WHERE name IN ('point_zm', 'point_m', 'line_zm', 'gc_z', 'point_empty', 'mpoint_with_empty', 'gc_with_empty', 'mpoint_z_empty', 'point_3857') ORDER BY name;
----
gc_with_empty	GEOMETRYCOLLECTION (POINT EMPTY, POINT (1 2))
gc_z	GEOMETRYCOLLECTION Z (POINT Z (1 2 3), LINESTRING Z (0 0 1, 1 1 2))
line_zm	LINESTRING ZM (0 0 1 5, 1 1 2 6)
mpoint_with_empty	MULTIPOINT (1 2, EMPTY)
mpoint_z_empty	MULTIPOINT Z (1 2 3, EMPTY, 4 5 6)
point_3857	POINT (1000 2000)
point_empty	POINT EMPTY
point_m	POINT M (1 2 4)
point_zm	POINT ZM (1 2 3 4)

query TT
SELECT name, g::VARCHAR FROM sp.dbo.SpatialReadG WHERE name IN ('g_point', 'g_point_api', 'g_point_z', 'g_srid4269', 'g_unit_sphere', 'g_point_empty') ORDER BY name;
----
g_point	POINT (10 50)
g_point_api	POINT (10 50)
g_point_empty	POINT EMPTY
g_point_z	POINT Z (10 50 100)
g_srid4269	POINT (10 50)
g_unit_sphere	POINT (10 50)

# a filter on a BLOB of WKB runs in DuckDB, over the bytes read (the server would compare the column)
query T
SELECT name FROM sp_wkb.dbo.SpatialReadM WHERE g = unhex('0101000000000000000000F03F0000000000000040');
----
point

# =============================================================================
# The WARNING: once per column per scan, as the scan meets a value it reads as NULL
# =============================================================================

statement ok
SET enable_logging = true;

statement ok
SELECT * FROM sp.dbo.SpatialReadM;

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%column "g" (geometry) holds values a GEOMETRY cannot hold%read as NULL; attach with geometry_as ''wkb''%''native''%';
----
1

statement ok
SELECT * FROM sp.dbo.SpatialReadG;

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%column "g" (geography) holds values a GEOMETRY cannot hold%';
----
1

# a scan stopped early still says it: the warning is logged as it is met
statement ok
SELECT g FROM sp.dbo.SpatialReadM WHERE name = 'circ' LIMIT 1;

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%column "g" (geometry) holds values a GEOMETRY cannot hold%';
----
2

# nothing to say under 'wkb' / 'native', nor for a table with no curve
statement ok
SELECT * FROM sp_wkb.dbo.SpatialReadM;

statement ok
SELECT * FROM sp_nat.dbo.SpatialReadG;

statement ok
SELECT * FROM sp.dbo.SpatialReadM WHERE name = 'point';

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%a GEOMETRY cannot hold%';
----
3

statement ok
SET enable_logging = false;

# =============================================================================
# A raw scan: the UDT_INFO's type name, the catalog's geometry_as
# =============================================================================

query TTT
SELECT typeof(p), typeof(q), q::VARCHAR FROM mssql_scan('sp', 'SELECT geometry::Point(1, 2, 0) AS p, geography::Point(50, 10, 4326) AS q');
----
GEOMETRY	GEOMETRY('OGC:CRS84')	POINT (10 50)

query TT
SELECT typeof(p), typeof(q) FROM mssql_scan('sp_wkb', 'SELECT geometry::Point(1, 2, 0) AS p, geography::Point(50, 10, 4326) AS q');
----
BLOB	BLOB

query T
SELECT hex(q) FROM mssql_scan('sp_nat', 'SELECT geography::Point(50, 10, 4326) AS q');
----
E6100000010C00000000000049400000000000002440

# prepared := true, and a batch the server cannot describe (run at bind), type it alike
query TT
SELECT typeof(g), g::VARCHAR FROM mssql_scan('sp', 'SELECT g FROM dbo.SpatialReadG WHERE name = ''g_point''', prepared := true);
----
GEOMETRY('OGC:CRS84')	POINT (10 50)

query TT
SELECT typeof(g), g::VARCHAR FROM mssql_scan('sp', 'SELECT g INTO #sp_t FROM dbo.SpatialReadG WHERE name = ''g_point''; SELECT g FROM #sp_t');
----
GEOMETRY('OGC:CRS84')	POINT (10 50)

# column_types reads a geography as a plain GEOMETRY (the same WKB)
query T
SELECT typeof(g) FROM mssql_scan('sp', 'SELECT g FROM dbo.SpatialReadG WHERE name = ''g_point''', column_types := ['GEOMETRY']);
----
GEOMETRY

# a raw scan reads what the catalog reads, the curves NULL alike
query I
SELECT count(*) FROM (SELECT id, g::BLOB FROM sp.dbo.SpatialReadM EXCEPT ALL SELECT id, g::BLOB FROM mssql_scan('sp', 'SELECT id, g FROM dbo.SpatialReadM'));
----
0

query I
SELECT count(*) FROM (SELECT id, g FROM mssql_scan('sp_wkb', 'SELECT id, g FROM dbo.SpatialReadG') EXCEPT ALL SELECT id, g FROM sp_wkb.dbo.SpatialReadG);
----
0

# =============================================================================
# Pushed whole (spec 079): the catalog's types, the same values
# =============================================================================

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS sp_off (TYPE mssql, remote_pushdown false);

statement ok
CREATE TEMP TABLE sp_via_on AS SELECT id, g FROM sp.dbo.SpatialReadG ORDER BY id LIMIT 100;

query T
SELECT data_type FROM duckdb_columns() WHERE table_name = 'sp_via_on' AND column_name = 'g';
----
GEOMETRY('OGC:CRS84')

query I
SELECT count(*) FROM (SELECT id, g::BLOB FROM sp_via_on EXCEPT ALL SELECT id, g::BLOB FROM sp_off.dbo.SpatialReadG);
----
0

query II
EXPLAIN SELECT id, g FROM sp.dbo.SpatialReadG ORDER BY id LIMIT 100;
----
physical_plan	<!REGEX>:.*STAsBinary.*

# =============================================================================
# RETURNING, and a value written back (writes are spec 093 T6's: STGeomFromWKB keeps Z / M, G7)
# =============================================================================

statement ok
SET mssql_dml_pushdown = false;

statement ok
INSERT INTO sp.dbo.SpatialReadW (id, g) SELECT 1, g FROM sp.dbo.SpatialReadM WHERE name = 'point_zm';

statement ok
RESET mssql_dml_pushdown;

query T
SELECT * FROM mssql_scan('sp', 'SELECT g.AsTextZM() AS t FROM dbo.SpatialReadW WHERE id = 1');
----
POINT (1 2 3 4)

query IT
INSERT INTO sp.dbo.SpatialReadW (id, g) VALUES (2, 'LINESTRING Z (0 0 1, 1 1 2)'::GEOMETRY) RETURNING id, g::VARCHAR;
----
2	LINESTRING Z (0 0 1, 1 1 2)

query IT
DELETE FROM sp.dbo.SpatialReadW WHERE id = 1 RETURNING id, g::VARCHAR;
----
1	POINT ZM (1 2 3 4)

# Under geometry_as 'native' the values are the stored bytes, which the write path (STGeomFromWKB) does not
# take: an INSERT or UPDATE of such a column is refused by name, nothing sent.
statement error
INSERT INTO sp_nat.dbo.SpatialReadW (id, g) VALUES (5, unhex('00000000010C000000000000F03F0000000000000040'));
----
the catalog is attached with geometry_as 'native'

statement ok
SET mssql_dml_pushdown = false;

statement error
UPDATE sp_nat.dbo.SpatialReadW SET g = NULL WHERE id = 2;
----
the catalog is attached with geometry_as 'native'

statement ok
RESET mssql_dml_pushdown;

# an INSERT ... SELECT pushed whole copies the column on the server, the curve included
query I
INSERT INTO sp_nat.dbo.SpatialReadW (id, g) SELECT 3, g FROM sp_nat.dbo.SpatialReadM WHERE name = 'circ';
----
1

query T
SELECT * FROM mssql_scan('sp', 'SELECT g.AsTextZM() AS t FROM dbo.SpatialReadW WHERE id = 3');
----
CIRCULARSTRING (0 0, 1 1, 2 0)

# A geography column is GEOMETRY('OGC:CRS84'), so what is written into it is cast to that: a source with no
# CRS or with OGC:CRS84 is written as before; one labelled with another CRS is refused by DuckDB's binder,
# which reprojects nothing (review of #594: until T5 the column was a plain GEOMETRY and took it, relabelled).
# The way through is the cast that drops the label.
statement ok
INSERT INTO sp.dbo.SpatialReadG (id, name, g) SELECT 200, 'no crs', 'POINT(10 50)'::GEOMETRY;

statement ok
INSERT INTO sp.dbo.SpatialReadG (id, name, g) SELECT 201, 'crs84', 'POINT(10 50)'::GEOMETRY('OGC:CRS84');

statement error

statement ok
SELECT mssql_exec('sp', 'INSERT INTO dbo.SpatialReadG (id, name, g) VALUES
	(1, ''g_point'', geography::STGeomFromText(''POINT(10 50)'', 4326)),
	(2, ''g_point_z'', geography::STGeomFromText(''POINT(10 50 100)'', 4326)),

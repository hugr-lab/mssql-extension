# name: test/sql/types/spatial_read.test
# description: Spec 093 T5 (D6) -- geometry / geography read bare and decoded on the client into ISO WKB, against the server's own AsBinaryZM(); geometry_as 'geometry' / 'wkb' / 'native'; the curves NULL with a WARNING; a raw scan
# group: [sql]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# The values are experiment G1's (specs/093-type-kernels/measured/G1.md): every OGC type, EMPTY of each,
# holes, collections, Z / M / ZM, a missing Z, the curves and FullGlobe, an invalid instance, geography in
# SRIDs 4326, 4269 and 104001, and a LineString of 5000 points (80 KB, past a TDS packet). The kernel
# gives AsBinaryZM() byte for byte, except where a POINT EMPTY is stored (the value, a MULTIPOINT member, a
# collection member): DuckDB's POINT EMPTY there, a point of NaN coordinates (owner, 2026-11-20), where the
# server writes MULTIPOINT EMPTY or leaves the member out. A curve or FullGlobe is NULL under
# geometry_as 'geometry', with one WARNING per column per scan; 'wkb' reads it as its ISO WKB, 'native' as
# the stored bytes (CAST(g AS varbinary(max))). The kernel's own check of every value is
# test/cpp/codec/test_ssclrt.cpp.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS sp (TYPE mssql);

statement ok
SELECT mssql_exec('sp', 'DROP TABLE IF EXISTS dbo.SpatialReadM; DROP TABLE IF EXISTS dbo.SpatialReadG; DROP TABLE IF EXISTS dbo.SpatialReadW;
	CREATE TABLE dbo.SpatialReadM (id int NOT NULL PRIMARY KEY, name varchar(40) NOT NULL, g geometry NULL);
	CREATE TABLE dbo.SpatialReadG (id int NOT NULL PRIMARY KEY, name varchar(40) NOT NULL, g geography NULL);
	CREATE TABLE dbo.SpatialReadW (id int NOT NULL PRIMARY KEY, g geometry NULL)');


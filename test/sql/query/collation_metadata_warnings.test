# name: test/sql/query/collation_metadata_warnings.test
# description: Non-UTF-8 single-byte text columns warn once per query, and server INFO messages surface (issue #224)
# group: [mssql]
# issue: 224

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# #224 is settled as documented-but-not-enforced: a CHAR/VARCHAR/TEXT column
# whose collation is not a UTF-8 one is handed back as code-page bytes in a
# DuckDB VARCHAR, and validating that per value would cost the scan's hot path
# to make a hand-written query fail loudly. So it is said ONCE PER QUERY over
# COLMETADATA instead, which costs nothing per row.
#
# The predicate is the fUTF8 flag, bit 0x40 of the collation flags byte, which
# lands at 0x04000000 in the 4-byte word the extension stores. Verified against
# a live server rather than read off MS-TDS.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS coll (TYPE mssql);

statement ok
SET logging_storage = 'memory';

statement ok
SET enable_logging = true;

# Server INFO tokens log at INFO, not WARNING -- see the PRINT section below for
# why severity cannot be used to separate the useful ones from the routine ones.
statement ok
SET logging_level = 'INFO';

# =============================================================================
# Windows collations: the fUTF8 bit decides, and only the single-byte text
# columns are candidates at all.
# =============================================================================

query I
SELECT count(*) FROM mssql_scan('coll', '
    SELECT CAST(''a'' AS VARCHAR(10)) COLLATE Cyrillic_General_CI_AS         AS w_cp1251,
           CAST(''b'' AS VARCHAR(10)) COLLATE Latin1_General_CI_AS           AS w_cp1252,
           CAST(''c'' AS VARCHAR(10)) COLLATE Latin1_General_100_BIN2_UTF8   AS w_utf8,
           CAST(N''d'' AS NVARCHAR(10))                                      AS w_nvarchar');
----
1

# Exactly the two non-UTF-8 varchars. A UTF-8 collation is already what DuckDB
# wants, and NVARCHAR is UTF-16 on the wire and always transcoded.
query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%non-UTF-8 collation%' AND message LIKE '%w_cp1251%';
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%non-UTF-8 collation%' AND message LIKE '%w_cp1252%';
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%non-UTF-8 collation%' AND message LIKE '%w_utf8%';
----
0

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%non-UTF-8 collation%' AND message LIKE '%w_nvarchar%';
----
0

# =============================================================================
# The 5th collation byte earns its place here: both of these SQL_* collations
# carry LCID 0x0409, so the first four bytes cannot tell them apart. The SortId
# is what names the code page -- 52 is CP1252, 106 is CP1251.
# =============================================================================

query I
SELECT count(*) FROM mssql_scan('coll', '
    SELECT CAST(''a'' AS VARCHAR(10)) COLLATE SQL_Latin1_General_CP1_CI_AS     AS s_cp1252,
           CAST(''b'' AS VARCHAR(10)) COLLATE SQL_Latin1_General_CP1251_CI_AS  AS s_cp1251');
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%s_cp1252%' AND message LIKE '%LCID 0x0409, SortId 52%';
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%s_cp1251%' AND message LIKE '%LCID 0x0409, SortId 106%';
----
1

# =============================================================================
# INFO tokens. The stream has collected these since the token parser was
# written and SurfaceWarnings dropped every one of them -- PRINT output,
# RAISERROR at severity 10 or below, and anything a procedure reports about
# itself.
#
# They log at INFO, not WARNING, so that server chatter does not dilute the
# collation warning above, which is a real warning about possibly corrupt data.
# Severity cannot be used to make that split, which is worth recording because
# it is the obvious idea: measured against SQL Server 2025, PRINT is severity 0
# and 5701 "Changed database context" is ALSO 0 on the wire (sys.messages calls
# it 10; severity 10 is sent as class 0), while anything above 10 arrives as an
# ERROR token and never reaches here at all.
#
# The `mssql: [` prefix is what separates our rows from the harness's own
# query-text logging, which is at INFO too and quotes these same strings.
# =============================================================================

query I
SELECT count(*) FROM mssql_scan('coll', 'PRINT ''surfaced from the server''; SELECT 1 AS a');
----
1

query I
SELECT count(*) FROM duckdb_logs
WHERE log_level = 'INFO' AND message LIKE 'mssql: [%' AND message LIKE '%surfaced from the server%';
----
1

# The severity is carried in the message, and it is really read rather than
# hard-coded: RAISERROR below 10 reports the level it was given.
statement ok
SELECT mssql_exec('coll', 'RAISERROR(''sev seven here'', 7, 1)');

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'mssql: [50000 sev 7]%sev seven here%';
----
1

# =============================================================================
# A query that stops early. This is the shape most likely to meet a code-page
# column for the first time, and it is the one that said nothing until the
# warning moved to init: the executor simply stops asking for chunks, the stream
# is closed undrained, and the drain-end call is never reached.
#
# TOP 5000 on the server against LIMIT 1 on the client, so the stream really is
# abandoned with rows outstanding rather than finishing inside one chunk.
# =============================================================================

query I
SELECT count(*) FROM (
    SELECT v FROM mssql_scan('coll', '
        SELECT TOP 5000 CAST(''x'' AS VARCHAR(50)) COLLATE Cyrillic_General_CI_AS AS v
        FROM sys.all_objects a CROSS JOIN sys.all_objects b') LIMIT 1);
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%non-UTF-8 collation%' AND message LIKE '%"v"%';
----
1

# Exactly one, not two. SurfaceWarnings is deliberately called twice per stream
# now -- once when COLMETADATA is known and once at the drain -- so the column
# half has to be one-shot. A fully drained stream is the case where both calls
# actually happen.
query I
SELECT count(*) FROM mssql_scan('coll', '
    SELECT CAST(''y'' AS VARCHAR(50)) COLLATE Cyrillic_General_CI_AS AS drained');
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE log_level = 'WARNING' AND message LIKE '%non-UTF-8 collation%' AND message LIKE '%"drained"%';
----
1

# =============================================================================
# mssql_exec() runs on a different path -- MSSQLSimpleQuery, which has no
# ClientContext by design because every catalog metadata query goes through it
# too -- and its token loop said `case Info: // Ignore informational messages`.
# Running a procedure that PRINTs was dropping every line of it.
# =============================================================================

statement ok
SELECT mssql_exec('coll', 'PRINT ''printed by mssql_exec''');

query I
SELECT count(*) FROM duckdb_logs
WHERE log_level = 'INFO' AND message LIKE 'mssql: [%' AND message LIKE '%printed by mssql_exec%';
----
1

# The notices of a batch that ultimately FAILED are the ones most worth reading,
# so they are logged before the error is raised rather than lost with it.
statement error
SELECT mssql_exec('coll', 'PRINT ''reached step one''; RAISERROR(''deliberate'', 16, 1)');
----
deliberate

query I
SELECT count(*) FROM duckdb_logs
WHERE log_level = 'INFO' AND message LIKE 'mssql: [%' AND message LIKE '%reached step one%';
----
1

# =============================================================================
# The off switch. The trigger IS the majority configuration --
# SQL_Latin1_General_CP1_CI_AS is the SQL Server installation default -- so a
# raw mssql_scan() over such a server logs one line per varchar column per
# query, forever, including for data that is pure ASCII and therefore already
# valid UTF-8. Someone who has read it once needs a way to stop hearing it.
# =============================================================================

statement ok
SET mssql_warn_non_utf8_collation = false;

query I
SELECT count(*) FROM mssql_scan('coll', '
    SELECT CAST(''q'' AS VARCHAR(50)) COLLATE Cyrillic_General_CI_AS AS silenced');
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE '%"silenced"%' AND message LIKE '%non-UTF-8 collation%';
----
0

statement ok
SET mssql_warn_non_utf8_collation = true;

query I
SELECT count(*) FROM mssql_scan('coll', '
    SELECT CAST(''q'' AS VARCHAR(50)) COLLATE Cyrillic_General_CI_AS AS audible');
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE '%"audible"%' AND message LIKE '%non-UTF-8 collation%';
----
1

statement ok
DETACH coll;

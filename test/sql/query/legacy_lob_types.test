# name: test/sql/query/legacy_lob_types.test
# description: TEXT / NTEXT / IMAGE are readable — catalog scan and mssql_scan (issue #197)
# group: [mssql]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database

require mssql

require-env MSSQL_TESTDB_DSN

# =============================================================================
# Issue #197: NTEXT and IMAGE columns had NO decoder — the scan emitted no CAST
# for them (both are "known" types, NTEXT short-circuited on is_unicode, IMAGE
# is not a text type), so their native LOB wire forms (0x63 / 0x22, the
# text-pointer framing nothing else uses) reached a codec that threw, and the
# connection died with "Connection closed while waiting for COLMETADATA".
#
# Fixed as the spec-055 phase-1 ride-along (legacy LONGLEN readers added while
# the value-read dispatch was being restructured, as the design doc planned),
# but nothing pinned it — this file is that pin, on the shapes that framing
# gets wrong: NULL text pointers, values above one PLP/packet worth, and
# non-ASCII through the UCS-2 wire form.
# =============================================================================

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS lob (TYPE mssql);

statement ok
SET mssql_exec_invalidate_cache = true;

statement ok
SELECT mssql_exec('lob', 'IF OBJECT_ID(''dbo.LegacyLob'') IS NOT NULL DROP TABLE dbo.LegacyLob;
CREATE TABLE dbo.LegacyLob (id int, nt NTEXT NULL, tx TEXT NULL, im IMAGE NULL)');

statement ok
SELECT mssql_exec('lob', 'INSERT INTO dbo.LegacyLob VALUES
(1, N''hello ntext Привет 漢字'', ''plain text'', 0x0102DEAD),
(2, NULL, NULL, NULL),
(3, REPLICATE(CAST(N''long'' AS nvarchar(max)), 3000),
    REPLICATE(CAST(''t'' AS varchar(max)), 9000),
    CAST(REPLICATE(CAST(''ab'' AS varchar(max)), 5000) AS varbinary(max)))');

# Wire-form coverage note: NTEXT (0x63) and IMAGE (0x22) are pinned on their
# LEGACY wire forms below. TEXT is asserted readable but travels as PLP — the
# catalog scan CASTs it to NVARCHAR(MAX) server-side unconditionally (its
# code-page decode without the cast is issue #224's territory), so the 0x23
# reader arm is exercised only by raw mssql_scan with no CAST, deliberately
# not pinned here.

# The catalog scan: values, NULLs and lengths — a framing slip in the
# text-pointer form shows up as a dead connection, not a wrong value, so the
# lengths are the assertion that the large row actually crossed the wire.
query ITTI
SELECT id, nt, tx, octet_length(im) FROM lob.dbo.LegacyLob WHERE id = 1;
----
1	hello ntext Привет 漢字	plain text	4

query IIII
SELECT id, length(nt), length(tx), octet_length(im) FROM lob.dbo.LegacyLob ORDER BY id;
----
1	21	10	4
2	NULL	NULL	NULL
3	12000	9000	10000

# Raw mssql_scan takes the no-CAST path by definition — the native wire types
# reach the decoder directly, which is exactly the path #197 reported dead.
query II
SELECT length(nt) AS nt_len, octet_length(im) AS im_len
FROM mssql_scan('lob', 'SELECT nt, im FROM dbo.LegacyLob WHERE id = 3');
----
12000	10000

statement ok
SELECT mssql_exec('lob', 'DROP TABLE dbo.LegacyLob');

statement ok
DETACH lob;

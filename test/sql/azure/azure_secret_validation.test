# name: test/sql/azure/azure_secret_validation.test
# description: MSSQL secret validation for the azure_secret parameter (no credentials needed)
# group: [azure]
#
# Everything here asserts src/mssql_secret.cpp's own validation and needs no
# Azure credentials and no azure extension. It used to live above a
# `require azure` / `require-env AZURE_APP_ID` block in the same file, and a
# `require` that fails mid-file aborts and marks the WHOLE file skipped -- so
# these four assertions reported as skipped, not passed, in every environment
# without Azure credentials, and a regression in MSSQLSecret validation was
# invisible in every lane. The credentialed half is now
# azure_secret_validation_with_credentials.test. Gates go at the top of a file
# or they retroactively discard what sits above them; scripts/ci/check_require_env.sh
# enforces that.

require mssql

# Test: MSSQL secret without user/password and without azure_secret fails
statement error
CREATE SECRET test_mssql_no_auth (
    TYPE mssql,
    HOST 'myserver.database.windows.net',
    PORT 1433,
    DATABASE 'mydb'
);
----
Either user/password or azure_secret required

# Test: MSSQL secret with only user (no password) and no azure_secret fails
statement error
CREATE SECRET test_mssql_user_only (
    TYPE mssql,
    HOST 'myserver.database.windows.net',
    PORT 1433,
    DATABASE 'mydb',
    USER 'testuser'
);
----
Missing required field 'password'

# Test: Traditional SQL auth still works (backward compatibility)
statement ok
CREATE SECRET test_mssql_sql_auth (
    TYPE mssql,
    HOST 'myserver.database.windows.net',
    PORT 1433,
    DATABASE 'mydb',
    USER 'testuser',
    PASSWORD 'testpass'
);

# Verify secret was created
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'test_mssql_sql_auth';
----
1

# Clean up
statement ok
DROP SECRET IF EXISTS test_mssql_sql_auth;

# Test: MSSQL secret with non-existent azure_secret fails
statement error
CREATE SECRET test_mssql_missing_azure (
    TYPE mssql,
    HOST 'myserver.database.windows.net',
    PORT 1433,
    DATABASE 'mydb',
    AZURE_SECRET 'nonexistent_azure'
);
----
Azure secret 'nonexistent_azure' not found

# name: test/sql/azure/azure_auth_test_function.test
# description: mssql_azure_auth_test() error paths (no credentials needed)
# group: [azure]
#
# Same split as azure_secret_validation.test: these two assertions are on this
# extension's own function and need neither credentials nor the azure
# extension, but they sat above a `require-env` / `require azure` block, and a
# gate that fails mid-file marks the whole file skipped -- so they never
# reported as passed anywhere without Azure credentials. The credentialed half
# is azure_auth_test_function_with_credentials.test.

require mssql

# Test: Empty secret name returns error
query I
SELECT mssql_azure_auth_test('');
----
Error: Secret name required

# Test: Non-existent secret returns error
query I
SELECT mssql_azure_auth_test('nonexistent_azure_secret');
----
Error: Azure secret 'nonexistent_azure_secret' not found

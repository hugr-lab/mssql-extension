# name: test/sql/tds_connection/pool_stats_no_credentials.test
# description: Spec 047 (US-SEC / FR-011 hardening / SC-005 extension / T046h)
#              — mssql_pool_stats() output must not contain any value that
#              was supplied as a credential in the ATTACH connection string.
#              The pool_stats schema has TWO VARCHAR columns: `db` (catalog
#              alias + GetDBPath form `mssql://host:port/database`) and,
#              since spec 073, `last_create_error` — the factory's or the
#              server's own text for the last failed connection creation,
#              arbitrary and queryable. Numeric columns physically cannot
#              contain a string sentinel; both VARCHAR columns are grepped,
#              and the second is provoked non-empty below so the grep is not
#              vacuous.
# group: [tds_connection]

require mssql

require-env MSSQL_TEST_HOST

require-env MSSQL_TEST_PORT

require-env MSSQL_TEST_USER

require-env MSSQL_TEST_PASS

# SQL-auth path: ATTACH with the real password (any sentinel-password
# would fail the eager validation from US2 — which itself proves the
# password is not echoed in the error message, separate gate). We use
# the real password but assert against a known-unique sentinel substring
# that the password contains. The MSSQL_TEST_PASS value in the test
# docker container is `TestPassword1`, so the sentinel substring
# `TestPassword1` is exactly the password. If a future regression
# started concatenating the connection string into `pool_stats.db`
# (or anywhere else queryable), this substring would surface.
statement ok
ATTACH 'Server={MSSQL_TEST_HOST},{MSSQL_TEST_PORT};Database=master;User Id={MSSQL_TEST_USER};Password={MSSQL_TEST_PASS};TrustServerCertificate=yes' AS pool_stats_sentinel (TYPE mssql);

# Touch the pool once so it has at least one connection to report on.
statement ok
SELECT * FROM mssql_scan('pool_stats_sentinel', 'SELECT 1');

# Core assertion: neither VARCHAR column contains the password. SC-005 grep gate.
query I
SELECT COUNT(*) FROM mssql_pool_stats('pool_stats_sentinel')
WHERE db LIKE '%' || '{MSSQL_TEST_PASS}' || '%'
   OR last_create_error LIKE '%' || '{MSSQL_TEST_PASS}' || '%';
----
0

# Also confirm we DID get a row (otherwise the COUNT=0 would be vacuous).
query I
SELECT COUNT(*) FROM mssql_pool_stats('pool_stats_sentinel');
----
1

# And the all-pools variant: same redaction invariant.
query I
SELECT COUNT(*) FROM mssql_pool_stats()
WHERE db LIKE '%' || '{MSSQL_TEST_PASS}' || '%'
   OR last_create_error LIKE '%' || '{MSSQL_TEST_PASS}' || '%';
----
0

statement ok
DETACH pool_stats_sentinel;

# `last_create_error` is only ever non-empty after a creation has failed, so
# provoke one: a sentinel password that the server rejects, with the login
# deferred to the POOL by lazy_validation (spec 073 -- the failure is
# reported at once, with the server's reason). The sentinel is a credential;
# it must not appear in either column.
statement ok
ATTACH 'Server={MSSQL_TEST_HOST},{MSSQL_TEST_PORT};Database=master;User Id={MSSQL_TEST_USER};Password=SENTINEL_pw_9f3a7c;TrustServerCertificate=yes' AS pool_stats_bad (TYPE mssql, lazy_validation true);

statement error
SELECT * FROM mssql_scan('pool_stats_bad', 'SELECT 1');
----
could not create a connection

# Non-vacuous: the column now carries the server's text ...
query I
SELECT COUNT(*) FROM mssql_pool_stats('pool_stats_bad') WHERE last_create_error <> '';
----
1

# ... and that text does not contain the credential.
query I
SELECT COUNT(*) FROM mssql_pool_stats()
WHERE db LIKE '%SENTINEL_pw_9f3a7c%' OR last_create_error LIKE '%SENTINEL_pw_9f3a7c%';
----
0

statement ok
DETACH pool_stats_bad;

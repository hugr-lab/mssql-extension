# name: test/sql/pushdown/remote_pushdown_dml_agreement.test
# description: Spec 080 W8, the agreement harness: UPDATE / DELETE shapes run through a pushing alias and through `remote_pushdown false`, on the same data, end in the same rows with the same count
# group: [pushdown]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# One DSN, two aliases: `ag` pushes (mssql_dml), `ag_sh` never does (the ATTACH
# option `remote_pushdown false`). For each shape the table is seeded, the
# statement runs through `ag`, the table is read through `ag_sh` (whose reads
# are never pushed either); then seeded again, run through `ag_sh`, read
# again, and the two states and counts compared. The same for Fabric's forms
# (emulated: `agf` pushes the single-table form, `agf_sh` takes the staged
# subquery form). Generated from one list of shapes: the blocks differ only in
# the statement, its count and whether it is pushed.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS ag (TYPE mssql);

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS ag_sh (TYPE mssql, remote_pushdown 'false');

statement ok
SET mssql_test_dml_platform = 'fabric';

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS agf (TYPE mssql);

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS agf_sh (TYPE mssql, remote_pushdown 'false');

statement ok
RESET mssql_test_dml_platform;

statement ok
SELECT mssql_exec('ag', 'DROP TABLE IF EXISTS dbo.ag_t; DROP TABLE IF EXISTS dbo.ag_src; DROP TABLE IF EXISTS dbo.ag_dup; CREATE TABLE dbo.ag_t (id int PRIMARY KEY, a int NOT NULL, b nvarchar(10) NULL, c decimal(10,2) NULL, e nvarchar(10) NULL); CREATE TABLE dbo.ag_src (id int PRIMARY KEY, w int NOT NULL); INSERT INTO dbo.ag_src VALUES (2, 200), (4, 400), (11, 1100); CREATE TABLE dbo.ag_dup (id int NOT NULL); INSERT INTO dbo.ag_dup VALUES (3), (3), (5)');

statement ok
SELECT mssql_invalidate_cache('ag');

statement ok
SELECT mssql_invalidate_cache('ag_sh');

statement ok
SELECT mssql_invalidate_cache('agf');

statement ok
SELECT mssql_invalidate_cache('agf_sh');

# --- 1: two SET columns, a range

statement ok
SELECT mssql_exec('ag', 'DELETE FROM dbo.ag_t; INSERT INTO dbo.ag_t VALUES (1, 1, N''x'', 1.25, N''e1''), (2, 2, N''x'', NULL, NULL), (3, 3, N''y'', 3.75, N''e3''), (4, 4, N''ab'', NULL, N''e4''), (5, 5, N''AB'', 6.25, NULL), (6, 6, N''Ab'', NULL, N''e6''), (7, 7, NULL, 8.75, N''e7''), (8, 8, NULL, NULL, NULL), (9, 9, N''y'', 11.25, N''e9''), (10, 10, N''Yz'', NULL, N''e10'')');

query II
EXPLAIN UPDATE ag.dbo.ag_t SET a = a + 1, b = 'k' WHERE id BETWEEN 3 AND 7;
----
physical_plan	<REGEX>:.*Mssql Dml.*

query I
UPDATE ag.dbo.ag_t SET a = a + 1, b = 'k' WHERE id BETWEEN 3 AND 7;
----
5

statement ok
CREATE OR REPLACE TEMP TABLE s_push AS SELECT * FROM ag_sh.dbo.ag_t;

statement ok
SELECT mssql_exec('ag', 'DELETE FROM dbo.ag_t; INSERT INTO dbo.ag_t VALUES (1, 1, N''x'', 1.25, N''e1''), (2, 2, N''x'', NULL, NULL), (3, 3, N''y'', 3.75, N''e3''), (4, 4, N''ab'', NULL, N''e4''), (5, 5, N''AB'', 6.25, NULL), (6, 6, N''Ab'', NULL, N''e6''), (7, 7, NULL, 8.75, N''e7''), (8, 8, NULL, NULL, NULL), (9, 9, N''y'', 11.25, N''e9''), (10, 10, N''Yz'', NULL, N''e10'')');

query II
EXPLAIN UPDATE ag_sh.dbo.ag_t SET a = a + 1, b = 'k' WHERE id BETWEEN 3 AND 7;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

query I
UPDATE ag_sh.dbo.ag_t SET a = a + 1, b = 'k' WHERE id BETWEEN 3 AND 7;
----
5

statement ok
CREATE OR REPLACE TEMP TABLE s_ship AS SELECT * FROM ag_sh.dbo.ag_t;

query I
SELECT count(*) FROM ((SELECT * FROM s_push EXCEPT ALL SELECT * FROM s_ship) UNION ALL (SELECT * FROM s_ship EXCEPT ALL SELECT * FROM s_push));
----
0

# --- 2: a decimal times a constant: not pushed (a decimal beside a constant has a type DuckDB and the server may not agree on)

statement ok
SELECT mssql_exec('ag', 'DELETE FROM dbo.ag_t; INSERT INTO dbo.ag_t VALUES (1, 1, N''x'', 1.25, N''e1''), (2, 2, N''x'', NULL, NULL), (3, 3, N''y'', 3.75, N''e3''), (4, 4, N''ab'', NULL, N''e4''), (5, 5, N''AB'', 6.25, NULL), (6, 6, N''Ab'', NULL, N''e6''), (7, 7, NULL, 8.75, N''e7''), (8, 8, NULL, NULL, NULL), (9, 9, N''y'', 11.25, N''e9''), (10, 10, N''Yz'', NULL, N''e10'')');

query II

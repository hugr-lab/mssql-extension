# name: test/sql/pushdown/remote_pushdown_composition.test
# description: Spec 079 PR E1 -- a statement that does not go whole has its nested parts pushed, each its own mssql_scan; a node that gains nothing is handed back to the scan path
# group: [pushdown]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# RemoteExecute decides the gain (PushesMoreThanScan), the dry run only
# renderability: the rewriter asks about every nested node too, and a refusal
# there poisons the statement. A node that gains nothing is handed back as
# itself (tables re-qualified), and the scan path still takes the filters
# from above it. A node that does not render whole -- EXCLUDE / REPLACE, a
# construct the writer has no form for -- has every nested part that renders
# and gains replaced by `SELECT * FROM <mssql_scan(...)>`.

require mssql

require-env MSSQL_TESTDB_DSN

# The comparison catalog: pushdown off (on by default since PR E2).
statement ok
SET mssql_remote_pushdown = false;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rc_off (TYPE mssql);

statement ok
SET mssql_remote_pushdown = true;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rc_on (TYPE mssql);

statement ok
SET mssql_remote_pushdown = false;

statement ok
SELECT mssql_exec('rc_off', 'DROP TABLE IF EXISTS dbo.rc_t;
	CREATE TABLE dbo.rc_t (id int NOT NULL PRIMARY KEY, n int NULL, g int NOT NULL);
	INSERT INTO dbo.rc_t VALUES (1, 10, 1), (2, 20, 1), (3, NULL, 2), (4, 40, 3)');

statement ok
CREATE TABLE loc AS SELECT 1 AS g, 'one' AS name UNION ALL SELECT 2, 'two';

#
# A part pushed under an outer node the writer does not take.
#

# EXCLUDE over a subquery: the subquery's TOP goes, EXCLUDE stays in DuckDB.
query II
EXPLAIN SELECT * EXCLUDE (n) FROM (SELECT id, n, g FROM rc_on.dbo.rc_t ORDER BY id LIMIT 2) s;
----
physical_plan	<REGEX>:.*SELECT TOP \(2\) \[id\], \[n\], \[g\] FROM \[dbo\]\.\[rc_t\] ORDER BY \[rc_t\]\.\[id\] ASC.*

query II
SELECT * EXCLUDE (n) FROM (SELECT id, n, g FROM rc_on.dbo.rc_t ORDER BY id LIMIT 2) s;
----
1	1
2	1

# A CTE body: the aggregate goes, integer sum cast back to HUGEINT.
query II
EXPLAIN WITH q AS (SELECT g, count(*) AS c, sum(n) AS s FROM rc_on.dbo.rc_t GROUP BY g) SELECT * EXCLUDE (c) FROM q ORDER BY g;
----
physical_plan	<REGEX>:.*GROUP BY \[g\].*

query IIT
WITH q AS (SELECT g, count(*) AS c, sum(n) AS s FROM rc_on.dbo.rc_t GROUP BY g) SELECT * EXCLUDE (c), typeof(s) FROM q ORDER BY g;
----
1	30	HUGEINT
2	NULL	HUGEINT
3	40	HUGEINT

# Two grouped subqueries joined on their GROUP BY key: bounded (a derived
# table's GROUP BY columns are its key), one statement.
query II
EXPLAIN SELECT a.g FROM (SELECT g FROM rc_on.dbo.rc_t GROUP BY g) a JOIN (SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g) b USING (g);
----
physical_plan	<REGEX>:.*GROUP BY \[g\]\) AS \[r1\] INNER JOIN \(SELECT .* GROUP BY \[g\]\) AS \[r2\].*

query I rowsort
SELECT a.g FROM (SELECT g FROM rc_on.dbo.rc_t GROUP BY g) a JOIN (SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g) b USING (g);
----
1
2
3

# A subquery in an expression: IN over a HAVING (the statement goes whole
# since subquery expressions are rendered).
query I
SELECT id FROM rc_on.dbo.rc_t WHERE g IN (SELECT g FROM rc_on.dbo.rc_t GROUP BY g HAVING count(*) > 1) ORDER BY id;
----
1
2

query I
SELECT id FROM rc_off.dbo.rc_t WHERE g IN (SELECT g FROM rc_off.dbo.rc_t GROUP BY g HAVING count(*) > 1) ORDER BY id;
----
1
2

# A set operation at a statement's top: never pushed whole (DuckDB combines
# the parts), each child that gains goes.
query II
EXPLAIN SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g, count(*) AS c FROM rc_on.dbo.rc_t WHERE id > 1 GROUP BY g;
----
physical_plan	<REGEX>:.*Union.*Mssql Scan.*Mssql Scan Params.*GROUP BY \[g\].*WHERE \(\[id\] > @p0\) GROUP BY \[g\].*

query II rowsort
SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g, count(*) AS c FROM rc_on.dbo.rc_t WHERE id > 1 GROUP BY g;
----
1	1
1	2
2	1
2	1
3	1
3	1

query II rowsort
SELECT g, count(*) AS c FROM rc_off.dbo.rc_t GROUP BY g UNION ALL SELECT g, count(*) AS c FROM rc_off.dbo.rc_t WHERE id > 1 GROUP BY g;
----
1	1
1	2
2	1
2	1
3	1
3	1

#
# Handed back: a node that gains nothing stays with the scan path, which
# takes the filters from above it.
#

query II
EXPLAIN SELECT * FROM rc_on.dbo.rc_t WHERE id = 2;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query III
SELECT * FROM rc_on.dbo.rc_t WHERE id = 2;
----
2	20	1

# A CTE reference is not a table: it is not re-qualified by the catalog.
query I
WITH q AS (SELECT g, n FROM rc_on.dbo.rc_t) SELECT * EXCLUDE (n) FROM q WHERE g = 3;
----
3

#
# Names: a node handed back gets every table name back exactly as the query
# wrote it -- the rewriter strips the catalog in place, and `rc_on.rc_t` loses
# it to a bare `rc_t`. A LOCAL table of the same name makes a wrong bind visible
# (it holds one row, id 100).
#

statement ok
CREATE TABLE rc_t AS SELECT 100 AS id, 0 AS n, 9 AS g;

# A subquery in ORDER BY / LIMIT / GROUP BY of a handed-back node (review of
# E1: those were not restored and bound to the local rc_t).
query I
SELECT * EXCLUDE (n, g) FROM (SELECT id, n, g FROM rc_on.dbo.rc_t ORDER BY id LIMIT 3) s ORDER BY id * ((SELECT max(id) FROM rc_on.dbo.rc_t) - 50);
----
3
2
1

query I
SELECT * EXCLUDE (n, g) FROM (SELECT id, n, g FROM rc_on.dbo.rc_t ORDER BY id LIMIT 4) s ORDER BY id LIMIT (SELECT count(*) FROM rc_on.rc_t);
----
1
2
3
4

query II
SELECT * EXCLUDE (c) FROM (SELECT g, count(*) AS c, (SELECT max(id) FROM rc_on.rc_t) AS m FROM rc_on.dbo.rc_t GROUP BY g) s ORDER BY g;
----
1	4
2	4
3	4

# A CTE named like a table: the 2-part table name must not bind to the CTE.
query I
WITH rc_t AS (SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g) SELECT x.* EXCLUDE (n, g) FROM rc_on.rc_t x ORDER BY id;
----
1
2
3
4

# A prepared statement's parameter in the outer node and in a pushed part.
statement ok
PREPARE rc_q AS SELECT * EXCLUDE (c) FROM (SELECT g, count(*) AS c FROM rc_on.dbo.rc_t WHERE id > $1 GROUP BY g) s WHERE g < $2 ORDER BY g;

query I
EXECUTE rc_q(1, 3);
----
1
2

statement ok
DEALLOCATE rc_q;

# Two vehicles in one statement (a set operation at the top: DuckDB combines
# the parts) inside a transaction, on the pinned connection -- and at a pool
# of one connection in autocommit, where a vehicle materialises at init.
query II
EXPLAIN SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g, count(*) AS c FROM rc_on.dbo.rc_t WHERE id > 1 GROUP BY g;
----
physical_plan	<REGEX>:.*Mssql Scan.*Mssql Scan.*

statement ok
BEGIN;

query II rowsort
SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g, count(*) AS c FROM rc_on.dbo.rc_t WHERE id > 1 GROUP BY g;
----
1	1
1	2
2	1
2	1
3	1
3	1

statement ok
COMMIT;

statement ok
SET mssql_connection_limit = 1;

query II rowsort
SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g, count(*) AS c FROM rc_on.dbo.rc_t WHERE id > 1 GROUP BY g;
----
1	1
1	2
2	1
2	1
3	1
3	1

# One part pushed, the other on the catalog scan, on the one connection.
query II rowsort
SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g, n FROM rc_on.dbo.rc_t WHERE id > 3;
----
1	2
2	1
3	1
3	40

statement ok
RESET mssql_connection_limit;

# A set operation ordered by an expression binds it against its children's
# own select lists, so they are not replaced by vehicles (review of E1: a
# binder error); a bare result name still lets them go.
query I
SELECT g + 1 AS x FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g + 1 FROM rc_on.dbo.rc_t GROUP BY g ORDER BY g + 1;
----
2
2
3
3
4
4

# A bare name that is not a result name binds against the children too
# (`g` under the aliases x / y), and through a nested set operation.
query I
SELECT g AS x FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g AS y FROM rc_on.dbo.rc_t GROUP BY g ORDER BY g;
----
1
1
2
2
3
3

query I
SELECT g AS x FROM rc_off.dbo.rc_t GROUP BY g UNION ALL SELECT g AS y FROM rc_off.dbo.rc_t GROUP BY g ORDER BY g;
----
1
1
2
2
3
3

query I
SELECT g + 1 AS x FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g + 1 FROM rc_on.dbo.rc_t GROUP BY g EXCEPT SELECT 100 ORDER BY g + 1;
----
2
3
4

query II
EXPLAIN SELECT g + 1 AS x FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g + 1 FROM rc_on.dbo.rc_t GROUP BY g ORDER BY x;
----
physical_plan	<REGEX>:.*Mssql Scan.*Mssql Scan.*

query I
SELECT g + 1 AS x FROM rc_on.dbo.rc_t GROUP BY g UNION ALL SELECT g + 1 FROM rc_on.dbo.rc_t GROUP BY g ORDER BY x;
----
2
2
3
3
4
4

# An INSERT whose WITH clause holds the query: DuckDB's rewriter does not
# finish a node under a CTE-holding parent (its FinishPushdown FIXME), so the
# aggregate runs in DuckDB; the rows are right and the statement stays an
# INSERT.
statement ok
CREATE TABLE rc_counts (g INTEGER, c BIGINT);

statement ok
WITH q AS (SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g) INSERT INTO rc_counts SELECT * FROM q;

query II
SELECT * FROM rc_counts ORDER BY g;
----
1	2
2	1
3	1

# A nested node that names a CTE of an enclosing scope is not pushed: the name
# is the CTE, not the table of that name (review of E1: the CTE's filter was
# lost -- the open rows are 2 and 3, the first is 2).
statement ok
SELECT mssql_exec('rc_off', 'DROP TABLE IF EXISTS dbo.rc_o; CREATE TABLE dbo.rc_o (id int NOT NULL, st varchar(10) NOT NULL);
	INSERT INTO dbo.rc_o VALUES (1, ''closed''), (2, ''open''), (3, ''open'')');

query I
WITH rc_o AS (SELECT * FROM rc_on.dbo.rc_o WHERE st = 'open') SELECT * EXCLUDE (st) FROM (SELECT id, st FROM rc_o ORDER BY id LIMIT 1) s;
----
2

# A `*` over a join could repeat a name, which a node handed back (a subquery)
# would deduplicate (`n, n` -> `n, n_1`): such a statement is not decomposed,
# and keeps DuckDB's names.
# (Through a table: DESCRIBE is not rewritten by the rewriter at all.)
statement ok
CREATE TEMP TABLE rc_names AS SELECT * FROM (SELECT id, n FROM rc_on.dbo.rc_t ORDER BY id LIMIT 2) x JOIN (SELECT id, n FROM rc_on.dbo.rc_t ORDER BY id LIMIT 3) y USING (id);

statement ok
CREATE TEMP TABLE rc_names_off AS SELECT * FROM (SELECT id, n FROM rc_off.dbo.rc_t ORDER BY id LIMIT 2) x JOIN (SELECT id, n FROM rc_off.dbo.rc_t ORDER BY id LIMIT 3) y USING (id);

query I
SELECT count(*) FROM (SELECT column_index, column_name FROM duckdb_columns() WHERE table_name = 'rc_names' EXCEPT SELECT column_index, column_name FROM duckdb_columns() WHERE table_name = 'rc_names_off');
----
0

# (CTAS itself makes the names unique, on both paths alike: this pins that
# the pushed statement's columns match the scan path's, not the guard.)
query T
SELECT column_name FROM duckdb_columns() WHERE table_name = 'rc_names' ORDER BY column_index;
----
id
n
n_1

statement ok
SELECT mssql_exec('rc_off', 'DROP TABLE dbo.rc_o');

#
# Waiting on duckdb/duckdb#26280: with a local table in the statement, the
# rewriter finishes neither a FROM subquery nor a CTE body on its own, so the
# aggregate runs in DuckDB over a plain scan. The rows are right; when DuckDB
# finishes the nested node, RemoteExecute pushes it with no change here.
#

query II
EXPLAIN WITH a AS (SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g) SELECT l.name, a.c FROM loc l JOIN a USING (g);
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query TI
WITH a AS (SELECT g, count(*) AS c FROM rc_on.dbo.rc_t GROUP BY g) SELECT l.name, a.c FROM loc l JOIN a USING (g) ORDER BY l.name;
----
one	2
two	1

statement ok
SELECT mssql_exec('rc_off', 'DROP TABLE dbo.rc_t');

statement ok
DETACH rc_on;

statement ok
DETACH rc_off;

# name: test/sql/pushdown/remote_pushdown_joins.test
# description: Spec 079 PR D -- joins of one catalog's tables pushed to SQL Server as one statement; both paths agree on rows and types
# group: [pushdown]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# As in remote_pushdown_single_table.test: every pushed shape is pinned by
# EXPLAIN, every veto by EXPLAIN showing the catalog scan, and the same
# statement against a catalog attached with the setting OFF returns the same
# rows with the same types.

require mssql

require-env MSSQL_TESTDB_DSN

# The comparison catalog: pushdown off (on by default since PR E2).
statement ok
SET mssql_remote_pushdown = false;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rj_off (TYPE mssql);

statement ok
SET mssql_remote_pushdown = true;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rj_on (TYPE mssql);

statement ok
SET mssql_remote_pushdown = false;

# a: 1..4; b references some of them, one row references nothing, one a has
# no b -- so every outer join has a NULL-supplied side.
statement ok
SELECT mssql_exec('rj_off', 'DROP TABLE IF EXISTS dbo.rj_a, dbo.rj_b;
	CREATE TABLE dbo.rj_a (id int NOT NULL PRIMARY KEY, name nvarchar(20) NULL, g int NOT NULL);
	CREATE TABLE dbo.rj_b (id int NOT NULL PRIMARY KEY, a_id int NULL, label nvarchar(20) NULL, qty int NULL, wide bigint NULL);
	INSERT INTO dbo.rj_a VALUES (1, N''one'', 1), (2, N''two'', 1), (3, N''three'', 2), (4, NULL, 2);
	INSERT INTO dbo.rj_b VALUES (10, 1, N''x'', 5, 1), (11, 1, N''y'', 7, 1), (12, 3, N''z'', NULL, 3), (13, NULL, N''orphan'', 2, NULL), (2, 2, N''same-id'', 1, 2)');

statement ok
CREATE TABLE loc AS SELECT 1 AS id;

#
# Pushed.
#

query II
EXPLAIN SELECT a.name, b.label FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.a_id = a.id;
----
physical_plan	<REGEX>:.*SELECT \[r1\]\.\[name\] AS \[name\], \[r2\]\.\[label\] AS \[label\] FROM \[dbo\]\.\[rj_a\] AS \[r1\] INNER JOIN \[dbo\]\.\[rj_b\] AS \[r2\] ON \(\[r2\]\.\[a_id\] = \[r1\]\.\[id\]\).*

# Inner, left, right and full joins, with a WHERE: the same rows and types on
# both paths. Each is its own CTAS / INSERT, whose query the rewriter pushes
# on its own (a UNION of them would be one remote set operation, which the
# catalog refuses as a whole and nothing would be pushed).
statement ok
CREATE TEMP TABLE j_on AS SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.a_id = a.id WHERE a.g = 1;

statement ok
INSERT INTO j_on SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_on.dbo.rj_a a LEFT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id;

statement ok
INSERT INTO j_on SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_on.dbo.rj_a a RIGHT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id;

statement ok
INSERT INTO j_on SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_on.dbo.rj_a a FULL JOIN rj_on.dbo.rj_b b ON b.a_id = a.id;

statement ok
CREATE TEMP TABLE j_off AS SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_off.dbo.rj_a a JOIN rj_off.dbo.rj_b b ON b.a_id = a.id WHERE a.g = 1;

statement ok
INSERT INTO j_off SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_off.dbo.rj_a a LEFT JOIN rj_off.dbo.rj_b b ON b.a_id = a.id;

statement ok
INSERT INTO j_off SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_off.dbo.rj_a a RIGHT JOIN rj_off.dbo.rj_b b ON b.a_id = a.id;

statement ok
INSERT INTO j_off SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_off.dbo.rj_a a FULL JOIN rj_off.dbo.rj_b b ON b.a_id = a.id;

# Each of those queries was pushed (the comparison below would pass on the
# scan path too).
query II
EXPLAIN SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.a_id = a.id WHERE a.g = 1;
----
physical_plan	<REGEX>:.*INNER JOIN \[dbo\]\.\[rj_b\] AS \[r2\] ON \(\[r2\]\.\[a_id\] = \[r1\]\.\[id\]\) WHERE.*

query II
EXPLAIN SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_on.dbo.rj_a a LEFT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id;
----
physical_plan	<REGEX>:.*LEFT JOIN \[dbo\]\.\[rj_b\] AS \[r2\].*

query II
EXPLAIN SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_on.dbo.rj_a a RIGHT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id;
----
physical_plan	<REGEX>:.*RIGHT JOIN \[dbo\]\.\[rj_b\] AS \[r2\].*

# 3 inner + 5 left + 5 right + 6 full.
query I
SELECT count(*) FROM j_on;
----
19

query I
SELECT count(*) FROM (SELECT * FROM j_on EXCEPT ALL SELECT * FROM j_off UNION ALL (SELECT * FROM j_off EXCEPT ALL SELECT * FROM j_on));
----
0

query TT
SELECT a.column_name, a.data_type FROM duckdb_columns() a JOIN duckdb_columns() b USING (column_name)
WHERE a.table_name = 'j_on' AND b.table_name = 'j_off' AND a.data_type = b.data_type ORDER BY a.column_index;
----
aid	INTEGER
name	MSSQL_NVARCHAR(20)
bid	INTEGER
label	MSSQL_NVARCHAR(20)
qty	INTEGER

query II
EXPLAIN SELECT a.id AS aid, a.name, b.id AS bid, b.label, b.qty FROM rj_on.dbo.rj_a a FULL JOIN rj_on.dbo.rj_b b ON b.a_id = a.id;
----
physical_plan	<REGEX>:.*FROM \[dbo\]\.\[rj_a\] AS \[r1\] FULL JOIN \[dbo\]\.\[rj_b\] AS \[r2\] ON.*

# USING: one condition; `*` lists the column once, from the left.
query II
EXPLAIN SELECT * FROM rj_on.dbo.rj_a JOIN rj_on.dbo.rj_b USING (id);
----
physical_plan	<REGEX>:.*INNER JOIN \[dbo\]\.\[rj_b\] AS \[r2\] ON \(\[r1\]\.\[id\] = \[r2\]\.\[id\]\).*

query ITIITII
SELECT * FROM rj_on.dbo.rj_a JOIN rj_on.dbo.rj_b USING (id);
----
2	two	1	2	same-id	1	2

query ITIITII
SELECT * FROM rj_off.dbo.rj_a JOIN rj_off.dbo.rj_b USING (id);
----
2	two	1	2	same-id	1	2

# Aggregates over a join, the top-N shape.
query II
EXPLAIN SELECT a.name, sum(b.qty) AS s FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.a_id = a.id GROUP BY a.name ORDER BY s DESC LIMIT 2;
----
physical_plan	<REGEX>:.*SELECT TOP \(2\) \[r1\]\.\[name\] AS \[name\], SUM\(CAST\(\[r2\]\.\[qty\] AS decimal\(38,0\)\)\) AS \[s\].*GROUP BY \[r1\]\.\[name\].*

query TI
SELECT a.name, sum(b.qty) AS s FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.a_id = a.id GROUP BY a.name ORDER BY s DESC LIMIT 2;
----
one	12
two	1

# The NULL-supplying side of an outer join is nullable whatever it declares:
# b.id is NOT NULL, yet a LEFT JOIN gives it NULLs, placed last as DuckDB
# places them.
query II
SELECT a.id, b.id AS bid FROM rj_on.dbo.rj_a a LEFT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY b.id LIMIT 6;
----
2	2
1	10
1	11
3	12
4	NULL

query II
EXPLAIN SELECT a.id, b.id AS bid FROM rj_on.dbo.rj_a a LEFT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY b.id LIMIT 6;
----
physical_plan	<REGEX>:.*ORDER BY CASE WHEN \[r2\]\.\[id\] IS NULL THEN 1 ELSE 0 END, \[r2\]\.\[id\] ASC.*

# A self-join through aliases; DISTINCT over a join with its ORDER BY key.
query II rowsort
SELECT DISTINCT x.g, y.name FROM rj_on.dbo.rj_a x JOIN rj_on.dbo.rj_a y ON x.g = y.g AND y.name IS NOT NULL ORDER BY x.g LIMIT 10;
----
1	one
1	two
2	three

query II
EXPLAIN SELECT DISTINCT x.g, y.name FROM rj_on.dbo.rj_a x JOIN rj_on.dbo.rj_a y ON x.g = y.g AND y.name IS NOT NULL ORDER BY x.g LIMIT 10;
----
physical_plan	<REGEX>:.*SELECT DISTINCT TOP \(10\) \[r1\]\.\[g\] AS \[g\], \[r2\]\.\[name\] AS \[name\].*ORDER BY \[r1\]\.\[g\] ASC.*

# SEMI / ANTI: EXISTS / NOT EXISTS. rj_b holds a NULL a_id, which would empty
# a NOT IN; the ANTI join keeps a 4, which has no b, on both paths.
query II
EXPLAIN SELECT a.id FROM rj_on.dbo.rj_a a ANTI JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY a.id;
----
physical_plan	<REGEX>:.*WHERE \(NOT EXISTS \(SELECT 1 FROM \[dbo\]\.\[rj_b\] AS \[r2\] WHERE \(\[r2\]\.\[a_id\] = \[r1\]\.\[id\]\)\)\).*

query I
SELECT a.id FROM rj_on.dbo.rj_a a ANTI JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY a.id;
----
4

query I
SELECT a.id FROM rj_off.dbo.rj_a a ANTI JOIN rj_off.dbo.rj_b b ON b.a_id = a.id ORDER BY a.id;
----
4

# A SEMI join keeps each matching row once (a 1 has two b rows).
query II
EXPLAIN SELECT a.id, a.name FROM rj_on.dbo.rj_a a SEMI JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY a.id;
----
physical_plan	<REGEX>:.*WHERE EXISTS \(SELECT 1 FROM \[dbo\]\.\[rj_b\] AS \[r2\].*

query IT
SELECT a.id, a.name FROM rj_on.dbo.rj_a a SEMI JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY a.id;
----
1	one
2	two
3	three

query IT
SELECT a.id, a.name FROM rj_off.dbo.rj_a a SEMI JOIN rj_off.dbo.rj_b b ON b.a_id = a.id ORDER BY a.id;
----
1	one
2	two
3	three

# The PR E1 gain check. rj_b.a_id is no key: a self-join on it is
# many-to-many and could send more rows than the scans. With the threshold
# under the tables' cached counts it stays with the scan path; a join on a
# key (rj_a.id) goes whatever the threshold.
statement ok
SET mssql_pushdown_join_rows_threshold = 2;

query II
EXPLAIN SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id ORDER BY xid, yid;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

# (and no vehicle carries the join: the regex above would match a plan split
# into a vehicle and a scan too)
query II
EXPLAIN SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id ORDER BY xid, yid;
----
physical_plan	<!REGEX>:.*JOIN \[dbo\].*

# Wrapped in a derived table or a CTE, the join is checked all the same
# (review of E1: the wrapper skipped the check).
query II
EXPLAIN SELECT * FROM (SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id) s ORDER BY 1, 2;
----
physical_plan	<!REGEX>:.*JOIN \[dbo\].*

query II
EXPLAIN WITH s AS (SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id) SELECT * FROM s ORDER BY 1, 2;
----
physical_plan	<!REGEX>:.*JOIN \[dbo\].*

query II
SELECT * FROM (SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id) s ORDER BY 1, 2;
----
2	2
10	10
10	11
11	10
11	11
12	12

# A derived table's GROUP BY columns are its key: a join on them is bounded,
# and goes without a LIMIT.
query II
EXPLAIN SELECT b.id, s.c FROM rj_on.dbo.rj_b b JOIN (SELECT a_id, count(*) AS c FROM rj_on.dbo.rj_b GROUP BY a_id) s ON s.a_id = b.a_id ORDER BY b.id;
----
physical_plan	<REGEX>:.*INNER JOIN \(SELECT .* GROUP BY .*\) AS \[r2\].*

query II
SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id ORDER BY xid, yid;
----
2	2
10	10
10	11
11	10
11	11
12	12

query II
EXPLAIN SELECT a.name, b.label FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY b.id;
----
physical_plan	<REGEX>:.*INNER JOIN \[dbo\]\.\[rj_b\] AS \[r2\].*

# A GROUP BY keeping both sides' keys has a row per joined row: not bounded.
query II
EXPLAIN SELECT x.id AS xid, y.id AS yid, count(*) AS c FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id GROUP BY x.id, y.id;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query II
EXPLAIN SELECT x.id AS xid, y.id AS yid, count(*) AS c FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id GROUP BY x.id, y.id;
----
physical_plan	<!REGEX>:.*JOIN \[dbo\].*

# A comma join on a key is bounded by WHERE's equality: pushed.
query II
EXPLAIN SELECT a.name, b.label FROM rj_on.dbo.rj_a a, rj_on.dbo.rj_b b WHERE b.a_id = a.id ORDER BY b.id;
----
physical_plan	<REGEX>:.*CROSS JOIN \[dbo\]\.\[rj_b\] AS \[r2\] WHERE.*

# A view has no row count of its own (sys.partitions has none): its size is
# unknown, never small -- the many-to-many self-join stays with the scan.
statement ok
SELECT mssql_exec('rj_off', 'DROP VIEW IF EXISTS dbo.rj_v; EXEC(''CREATE VIEW dbo.rj_v AS SELECT id, a_id FROM dbo.rj_b'')');

statement ok
SELECT mssql_invalidate_cache('rj_on');

query II
EXPLAIN SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_v x JOIN rj_on.dbo.rj_v y ON x.a_id = y.a_id ORDER BY xid, yid;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query II
EXPLAIN SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_v x JOIN rj_on.dbo.rj_v y ON x.a_id = y.a_id ORDER BY xid, yid;
----
physical_plan	<!REGEX>:.*JOIN \[dbo\].*

statement ok
SELECT mssql_exec('rj_off', 'DROP VIEW dbo.rj_v');

# An aggregate over it bounds what crosses the wire: pushed.
query II
EXPLAIN SELECT x.a_id, count(*) AS c FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id GROUP BY x.a_id;
----
physical_plan	<REGEX>:.*GROUP BY \[r1\]\.\[a_id\].*

# Inside a transaction it is trusted (no check).
statement ok
BEGIN;

query II
EXPLAIN SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id ORDER BY xid, yid;
----
physical_plan	<REGEX>:.*INNER JOIN \[dbo\]\.\[rj_b\] AS \[r2\].*

statement ok
COMMIT;

# 0 disables the check.
statement ok
SET mssql_pushdown_join_rows_threshold = 0;

query II
EXPLAIN SELECT x.id AS xid, y.id AS yid FROM rj_on.dbo.rj_b x JOIN rj_on.dbo.rj_b y ON x.a_id = y.a_id ORDER BY xid, yid;
----
physical_plan	<REGEX>:.*INNER JOIN \[dbo\]\.\[rj_b\] AS \[r2\].*

statement ok
RESET mssql_pushdown_join_rows_threshold;

#
# Vetoes: the statement stays on the scan path, with the right rows.
#

# A RIGHT / FULL join over a SEMI join is not pushed: the SEMI join's EXISTS
# moves to WHERE, which the rows the RIGHT join brings (its left side NULL)
# would not survive.
query II
EXPLAIN SELECT b.id AS bid, a.id FROM rj_on.dbo.rj_a a SEMI JOIN rj_on.dbo.rj_a c ON c.id = a.id RIGHT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY bid;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query II
SELECT b.id AS bid, a.id FROM rj_on.dbo.rj_a a SEMI JOIN rj_on.dbo.rj_a c ON c.id = a.id RIGHT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id ORDER BY bid;
----
2	2
10	1
11	1
12	3
13	NULL

# A LEFT join before it keeps the EXISTS exact: pushed, the same rows.
query II
EXPLAIN SELECT a.id, b.id AS bid FROM rj_on.dbo.rj_a a LEFT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id SEMI JOIN rj_on.dbo.rj_a c ON c.id = a.id ORDER BY a.id, bid LIMIT 10;
----
physical_plan	<REGEX>:.*LEFT JOIN \[dbo\]\.\[rj_b\] AS \[r2\].*WHERE EXISTS.*

query II
SELECT a.id, b.id AS bid FROM rj_on.dbo.rj_a a LEFT JOIN rj_on.dbo.rj_b b ON b.a_id = a.id SEMI JOIN rj_on.dbo.rj_a c ON c.id = a.id ORDER BY a.id, bid LIMIT 10;
----
1	10
1	11
2	2
3	12
4	NULL

query II
SELECT a.id, b.id AS bid FROM rj_off.dbo.rj_a a LEFT JOIN rj_off.dbo.rj_b b ON b.a_id = a.id SEMI JOIN rj_off.dbo.rj_a c ON c.id = a.id ORDER BY a.id, bid LIMIT 10;
----
1	10
1	11
2	2
3	12
4	NULL

# A join with a local table, or with another catalog: not one server's.
query II
EXPLAIN SELECT a.id FROM rj_on.dbo.rj_a a JOIN loc ON loc.id = a.id;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query II
EXPLAIN SELECT a.id FROM rj_on.dbo.rj_a a JOIN rj_off.dbo.rj_b b ON b.a_id = a.id;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

# int = bigint: DuckDB and the server promote differently.
query II
EXPLAIN SELECT a.id FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.wide = a.id;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query I
SELECT a.id FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.wide = a.id ORDER BY a.id;
----
1
1
2
3

# A CROSS JOIN alone sends more rows than the two scans.
query II
EXPLAIN SELECT a.id, b.id AS bid FROM rj_on.dbo.rj_a a CROSS JOIN rj_on.dbo.rj_b b;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

# An ambiguous column is DuckDB's binder error, not the server's.
statement error
SELECT id FROM rj_on.dbo.rj_a a JOIN rj_on.dbo.rj_b b ON b.a_id = a.id;
----
Ambiguous reference

statement ok
SELECT mssql_exec('rj_off', 'DROP TABLE dbo.rj_a, dbo.rj_b');

statement ok
DETACH rj_on;

statement ok
DETACH rj_off;

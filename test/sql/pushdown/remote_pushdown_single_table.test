# name: test/sql/pushdown/remote_pushdown_single_table.test
# description: Spec 079 PR B -- DuckDB's remote-pushdown rewriter sends a single-table SELECT to SQL Server as one statement; both paths agree on rows and types
# group: [pushdown]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# A result cannot tell which path ran it, so every pushed shape is pinned by
# EXPLAIN (the vehicle, mssql_scan / mssql_scan_params, shows the statement it
# sends) and every veto by EXPLAIN showing the catalog scan. The same
# statements run against a catalog attached with the setting OFF and must
# return the same rows with the same types (spec 079 W5).

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rp_off (TYPE mssql);

# Read at ATTACH (D6): rp_on answers the rewriter, rp_off never does.
statement ok
SET mssql_remote_pushdown = true;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rp_on (TYPE mssql);

statement ok
SET mssql_remote_pushdown = false;

# The fixture covers what the catalog scan reads through an expression: a
# varchar under a non-UTF-8 collation holding non-ASCII (read as its NVARCHAR
# cast), a geometry (STAsBinary), a datetime2(7) with 100 ns ticks (read as
# TIMESTAMP_NS), a UTF-8 varchar (ordered as its bytes), nullable keys.
statement ok
SELECT mssql_exec('rp_off', 'DROP TABLE IF EXISTS dbo.rp_t;
	CREATE TABLE dbo.rp_t (
		id int NOT NULL PRIMARY KEY,
		n int NULL,
		name nvarchar(50) NULL,
		code varchar(20) COLLATE Latin1_General_100_BIN2_UTF8 NULL,
		legacy varchar(20) COLLATE SQL_Latin1_General_CP1_CI_AS NULL,
		amount decimal(10,2) NULL,
		day date NULL,
		ts datetime2(7) NULL,
		g geometry NULL,
		tiny tinyint NULL,
		flag bit NULL);
	INSERT INTO dbo.rp_t VALUES
		(1, 30, N''alpha'', ''b'', ''caf'' + CHAR(233), 1.50, ''2024-01-01'', ''2024-01-01 00:00:00.1234567'', geometry::STGeomFromText(''POINT (1 2)'', 0), 255, 1),
		(2, NULL, N''Beta'', ''a'', ''plain'', 2.00, ''2024-02-01'', ''2024-02-01 00:00:00.0000001'', NULL, 1, 0),
		(3, 10, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
		(4, 20, N''gamma'', ''B'', ''x'', 4.25, ''2024-04-01'', ''2024-04-01 12:00:00'', geometry::STGeomFromText(''POINT (3 4)'', 0), 7, 1),
		(5, NULL, N''delta'', ''ab'', ''y'', 5.00, ''2024-05-01'', ''2024-05-01 00:00:00.9999999'', NULL, 0, 0)');

statement ok
CREATE TABLE loc AS SELECT 99 AS id;

#
# Pushed: the whole node is one statement, visible in EXPLAIN.
#

query II
EXPLAIN SELECT id, n FROM rp_on.dbo.rp_t ORDER BY id DESC LIMIT 3;
----
physical_plan	<REGEX>:.*SELECT TOP \(3\) \[id\], \[n\] FROM \[dbo\]\.\[rp_t\] ORDER BY \[rp_t\]\.\[id\] DESC.*

# Constants are parameters declared from the column (spec 076 / #361).
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE id >= 2 AND day < '2024-05-01' ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*Mssql Scan Params.*WHERE \(\(\[id\] >= @p0\) AND \(\[day\] < @p1\)\).*

# The two-part name resolves through the default schema (the rewriter asks
# for schema `main`, the catalog answers with dbo).
query II
EXPLAIN SELECT id FROM rp_on.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*SELECT TOP \(1\) \[id\] FROM \[dbo\]\.\[rp_t\].*

# The NULL placement DuckDB asks for is emulated under a LIMIT.
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t ORDER BY n LIMIT 5;
----
physical_plan	<REGEX>:.*ORDER BY CASE WHEN \[rp_t\]\.\[n\] IS NULL THEN 1 ELSE 0 END, \[rp_t\]\.\[n\] ASC.*

#
# The same rows on both paths.
#

# Each pair below is compared only after its pushed half is shown pushed: an
# agreement that a silent veto would also produce proves nothing.
query II
EXPLAIN SELECT id, n FROM rp_on.dbo.rp_t ORDER BY n, id LIMIT 5;
----
physical_plan	<REGEX>:.*Mssql Scan.*TOP \(5\).*

query II
SELECT id, n FROM rp_on.dbo.rp_t ORDER BY n, id LIMIT 5;
----
3	10
4	20
1	30
2	NULL
5	NULL

query II
SELECT id, n FROM rp_off.dbo.rp_t ORDER BY n, id LIMIT 5;
----
3	10
4	20
1	30
2	NULL
5	NULL

query II
EXPLAIN SELECT id, n FROM rp_on.dbo.rp_t ORDER BY n DESC NULLS FIRST, id LIMIT 3;
----
physical_plan	<REGEX>:.*Mssql Scan.*TOP \(3\).*

query II
SELECT id, n FROM rp_on.dbo.rp_t ORDER BY n DESC NULLS FIRST, id LIMIT 3;
----
2	NULL
5	NULL
1	30

query II
SELECT id, n FROM rp_off.dbo.rp_t ORDER BY n DESC NULLS FIRST, id LIMIT 3;
----
2	NULL
5	NULL
1	30

# A UTF-8 varchar is ordered by its bytes -- DuckDB's order -- under a LIMIT.
query II
EXPLAIN SELECT id, code FROM rp_on.dbo.rp_t ORDER BY code LIMIT 5;
----
physical_plan	<REGEX>:.*CAST\(\[rp_t\]\.\[code\] AS varbinary\(20\)\).*

query II
SELECT id, code FROM rp_on.dbo.rp_t ORDER BY code LIMIT 5;
----
4	B
2	a
5	ab
1	b
3	NULL

query II
SELECT id, code FROM rp_off.dbo.rp_t ORDER BY code LIMIT 5;
----
4	B
2	a
5	ab
1	b
3	NULL

query II
EXPLAIN SELECT id AS k, amount FROM rp_on.dbo.rp_t WHERE amount > 1.5 ORDER BY 1 LIMIT 2 OFFSET 1;
----
physical_plan	<REGEX>:.*OFFSET 1 ROWS FETCH NEXT 2 ROWS ONLY.*

query II
SELECT id AS k, amount FROM rp_on.dbo.rp_t WHERE amount > 1.5 ORDER BY 1 LIMIT 2 OFFSET 1;
----
4	4.25
5	5.00

query II
SELECT id AS k, amount FROM rp_off.dbo.rp_t WHERE amount > 1.5 ORDER BY 1 LIMIT 2 OFFSET 1;
----
4	4.25
5	5.00

# Strings compare under the column's collation on the server (D4): the
# default collation is case-insensitive, so 'BETA' finds 'Beta'. The scan path
# pushes the same comparison, so both paths agree.
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE name = 'BETA' ORDER BY id LIMIT 5;
----
physical_plan	<REGEX>:.*Mssql Scan Params.*\(\[name\] = @p0\).*

query I
SELECT id FROM rp_on.dbo.rp_t WHERE name = 'BETA' ORDER BY id LIMIT 5;
----
2

query I
SELECT id FROM rp_off.dbo.rp_t WHERE name = 'BETA' ORDER BY id LIMIT 5;
----
2

# A select-list alias named like another column: DuckDB orders by the table
# column, and so must the server, where a bare ORDER BY name is the alias.
query II
EXPLAIN SELECT id AS n FROM rp_on.dbo.rp_t ORDER BY rp_t.n DESC, id LIMIT 2;
----
physical_plan	<REGEX>:.*AS \[n\].*ORDER BY \[rp_t\]\.\[n\] DESC.*

query I
SELECT id AS n FROM rp_on.dbo.rp_t ORDER BY rp_t.n DESC, id LIMIT 3;
----
1
4
3

query I
SELECT id AS n FROM rp_off.dbo.rp_t ORDER BY rp_t.n DESC, id LIMIT 3;
----
1
4
3

# Two pushed children of one set operation naming the same table in different
# schemas: each is written against its own schema. The rewriter looks both up
# before it pushes either, so a match on the bare name would read the wrong one.
statement ok
SELECT mssql_exec('rp_off', 'IF SCHEMA_ID(''rp_s'') IS NULL EXEC(''CREATE SCHEMA rp_s'');
	DROP TABLE IF EXISTS rp_s.rp_t; CREATE TABLE rp_s.rp_t (id int NOT NULL, other int);
	INSERT INTO rp_s.rp_t VALUES (100, 1), (200, 2)');

statement ok
SELECT mssql_invalidate_cache('rp_on');

# No ORDER BY on the whole: DuckDB pushes the children of a set operation one
# by one only when the set operation itself has no modifiers.
query II
EXPLAIN (SELECT id FROM rp_on.rp_t ORDER BY id LIMIT 1) UNION ALL (SELECT id FROM rp_on.rp_s.rp_t ORDER BY id DESC LIMIT 1)
UNION ALL (SELECT id FROM loc);
----
physical_plan	<REGEX>:.*FROM \[dbo\]\.\[rp_t\].*FROM \[rp_s\]\.\[rp_t\].*

query I rowsort
(SELECT id FROM rp_on.rp_t ORDER BY id LIMIT 1) UNION ALL (SELECT id FROM rp_on.rp_s.rp_t ORDER BY id DESC LIMIT 1)
UNION ALL (SELECT id FROM loc);
----
1
200
99

# `USE db`: an unqualified name binds in the default schema, as the rewriter
# looks it up -- pushed.
statement ok
USE rp_on;

query II
EXPLAIN SELECT id FROM rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*FROM \[dbo\]\.\[rp_t\].*

# `USE db.rp_s`: the binder reads rp_s.rp_t, but the rewriter looks the name up
# in `main`, answered with dbo -- so it is not pushed (it read dbo.rp_t before
# the search-path check), and the scan path reads rp_s.
statement ok
USE rp_on.rp_s;

query II
EXPLAIN SELECT id FROM rp_t ORDER BY id LIMIT 5;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query I
SELECT id FROM rp_t ORDER BY id LIMIT 5;
----
100
200

# `db.t` too: the binder reads it through the catalog's search-path entry
# (review of E1: it was pushed reading dbo.rp_t).
query II
EXPLAIN SELECT id FROM rp_on.rp_t ORDER BY id LIMIT 5;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query I
SELECT id FROM rp_on.rp_t ORDER BY id LIMIT 5;
----
100
200

# A schema written is that schema, whatever the search path says.
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t ORDER BY id LIMIT 5;
----
physical_plan	<REGEX>:.*FROM \[dbo\]\.\[rp_t\].*

statement ok
USE memory;

# The `default_schema` ATTACH option is where a two-part name resolves.
statement ok
SET mssql_remote_pushdown = true;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rp_ds (TYPE mssql, default_schema 'rp_s');

statement ok
SET mssql_remote_pushdown = false;

query II
EXPLAIN SELECT id FROM rp_ds.rp_t ORDER BY id LIMIT 5;
----
physical_plan	<REGEX>:.*FROM \[rp_s\]\.\[rp_t\].*

query I
SELECT id FROM rp_ds.rp_t ORDER BY id LIMIT 5;
----
100
200

statement ok
DETACH rp_ds;

statement ok
SELECT mssql_exec('rp_off', 'DROP TABLE rp_s.rp_t; DROP SCHEMA rp_s');

statement ok
SELECT mssql_invalidate_cache('rp_on');

# A server schema named like the ATTACH alias: `rp_on.rp_on.rp_t` is that
# schema, not the default one.
statement ok
SELECT mssql_exec('rp_off', 'IF SCHEMA_ID(''rp_on'') IS NULL EXEC(''CREATE SCHEMA rp_on'');
	DROP TABLE IF EXISTS rp_on.rp_t; CREATE TABLE rp_on.rp_t (id int NOT NULL); INSERT INTO rp_on.rp_t VALUES (7)');

statement ok
SELECT mssql_invalidate_cache('rp_on');

query II
EXPLAIN SELECT id FROM rp_on.rp_on.rp_t ORDER BY id LIMIT 5;
----
physical_plan	<REGEX>:.*FROM \[rp_on\]\.\[rp_t\].*

query I
SELECT id FROM rp_on.rp_on.rp_t ORDER BY id LIMIT 5;
----
7

statement ok
SELECT mssql_exec('rp_off', 'DROP TABLE rp_on.rp_t; DROP SCHEMA rp_on');

statement ok
SELECT mssql_invalidate_cache('rp_on');

# A prepared statement is rewritten when it binds, and again on re-execution.
statement ok
PREPARE rp_q AS SELECT id FROM rp_on.dbo.rp_t WHERE id >= 2 ORDER BY id LIMIT 2;

query I
EXECUTE rp_q;
----
2
3

query I
EXECUTE rp_q;
----
2
3

statement ok
DEALLOCATE rp_q;

#
# Arithmetic (PR C): same-type operands keep their type on both sides, a
# constant is typed from its peer, a computed column is named as DuckDB names
# it and typed by the server's describe. The WHERE compares two computed
# values: `n * 2 > 15` alone is not pushed (PR D full review), since DuckDB
# moves the constant across (`n > 7`) and never computes `n * 2`.
#

query II
EXPLAIN SELECT id, n + 1, amount + amount AS twice, -n AS neg, n % 7 AS m FROM rp_on.dbo.rp_t WHERE n * 2 > n + 5 ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*\(\[n\] \+ @p0\) AS \[\(n \+ 1\)\], \(\[amount\] \+ \[amount\]\) AS \[twice\], \(-\[n\]\) AS \[neg\], \(\[n\] % @p1\) AS \[m\].*WHERE \(\(\[n\] \* @p2\) > \(\[n\] \+ @p3\)\).*

query II
EXPLAIN CREATE TEMP TABLE ar_on AS SELECT id, n + 1, amount + amount AS twice, -n AS neg, n % 7 AS m FROM rp_on.dbo.rp_t WHERE n * 2 > n + 5 ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*Mssql Scan Params.*AS \[neg\].*AS \[m\].*

statement ok
CREATE TEMP TABLE ar_on AS SELECT id, n + 1, amount + amount AS twice, -n AS neg, n % 7 AS m FROM rp_on.dbo.rp_t WHERE n * 2 > n + 5 ORDER BY id LIMIT 10;

statement ok
CREATE TEMP TABLE ar_off AS SELECT id, n + 1, amount + amount AS twice, -n AS neg, n % 7 AS m FROM rp_off.dbo.rp_t WHERE n * 2 > n + 5 ORDER BY id LIMIT 10;

query IIIII
SELECT * FROM ar_on ORDER BY id;
----
1	31	3.00	-30	2
3	11	NULL	-10	3
4	21	8.50	-20	6

query I
SELECT count(*) FROM (SELECT * FROM ar_on EXCEPT ALL SELECT * FROM ar_off);
----
0

# The same names and the same types on both paths.
query TT
SELECT a.column_name, a.data_type FROM duckdb_columns() a JOIN duckdb_columns() b USING (column_name)
WHERE a.table_name = 'ar_on' AND b.table_name = 'ar_off' AND a.data_type = b.data_type ORDER BY a.column_index;
----
id	INTEGER
(n + 1)	INTEGER
twice	DECIMAL(11,2)
neg	INTEGER
m	INTEGER

# Overflow is an error on both paths: tinyint + tinyint stays tinyint.
query II
EXPLAIN SELECT id, tiny + 1 FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*\(\[tiny\] \+ @p0\).*

statement error
SELECT id, tiny + 1 FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
<REGEX>:.*8115.*overflow.*tinyint.*

statement error
SELECT id, tiny + 1 FROM rp_off.dbo.rp_t ORDER BY id LIMIT 1;
----
<REGEX>:.*Overflow.*

# Vetoes: mixed types (the promotions differ), a decimal product compared
# (its type differs), % on a decimal (T-SQL rejects it).
query II
EXPLAIN SELECT id, n + amount FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE amount * amount > 1 ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query II
EXPLAIN SELECT id, amount % 2 FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

#
# Division, casts, CASE, COALESCE, NULLIF (PR C): one type for every branch,
# widening casts only, DuckDB's floating `/`.
#

query II
EXPLAIN SELECT id, n / 4 AS q, CAST(n AS BIGINT) AS b, CAST(amount AS DOUBLE) AS d, CASE WHEN n > 15 THEN n ELSE 0 END AS c, coalesce(n, -1) AS co FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*NULLIF\(CAST\(@p0 AS float\), 0\)\) AS \[q\], CAST\(\[n\] AS bigint\) AS \[b\], CAST\(\[amount\] AS float\) AS \[d\], CASE WHEN .*COALESCE\(\[n\], @p.\) AS \[co\].*

query II
EXPLAIN CREATE TEMP TABLE bc_on AS SELECT id, n / 4 AS q, CAST(n AS BIGINT) AS b, CAST(amount AS DOUBLE) AS d, CASE WHEN n > 15 THEN n ELSE 0 END AS c, coalesce(n, -1) AS co FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*Mssql Scan Params.*AS \[q\].*AS \[co\].*

statement ok
CREATE TEMP TABLE bc_on AS SELECT id, n / 4 AS q, CAST(n AS BIGINT) AS b, CAST(amount AS DOUBLE) AS d, CASE WHEN n > 15 THEN n ELSE 0 END AS c, coalesce(n, -1) AS co FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;

statement ok
CREATE TEMP TABLE bc_off AS SELECT id, n / 4 AS q, CAST(n AS BIGINT) AS b, CAST(amount AS DOUBLE) AS d, CASE WHEN n > 15 THEN n ELSE 0 END AS c, coalesce(n, -1) AS co FROM rp_off.dbo.rp_t ORDER BY id LIMIT 10;

query IRIRII
SELECT * FROM bc_on ORDER BY id;
----
1	7.5	30	1.5	30	30
2	NULL	NULL	2.0	0	-1
3	2.5	10	NULL	0	10
4	5.0	20	4.25	20	20
5	NULL	NULL	5.0	0	-1

query I
SELECT count(*) FROM (SELECT * FROM bc_on EXCEPT ALL SELECT * FROM bc_off);
----
0

query TT
SELECT a.column_name, a.data_type FROM duckdb_columns() a JOIN duckdb_columns() b USING (column_name)
WHERE a.table_name = 'bc_on' AND b.table_name = 'bc_off' AND a.data_type = b.data_type ORDER BY a.column_index;
----
id	INTEGER
q	DOUBLE
b	BIGINT
d	DOUBLE
c	INTEGER
co	INTEGER

# A bit column as a condition.
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE flag AND n > 15 ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*WHERE \(\(\[flag\] = 1\) AND \(\[n\] > @p0\)\).*

query I
SELECT id FROM rp_on.dbo.rp_t WHERE flag AND n > 15 ORDER BY id LIMIT 10;
----
1
4

query I
SELECT id FROM rp_off.dbo.rp_t WHERE flag AND n > 15 ORDER BY id LIMIT 10;
----
1
4

# A division in a condition is not pushed: a zero divisor is inf here and
# NULL there, which would change the rows (`id / tiny IS NULL` finds row 5
# only on the server).
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE id / tiny IS NULL ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query I
SELECT id FROM rp_on.dbo.rp_t WHERE id / tiny IS NULL ORDER BY id LIMIT 10;
----
3

query I
SELECT id FROM rp_on.dbo.rp_t WHERE NOT flag ORDER BY id LIMIT 10;
----
2
5

# A UTF-8 varchar in a computed value arrives as DuckDB's UTF-8 (as is with
# UTF8SUPPORT, transcoded by the server without it): pushed, same rows, same
# type as the local path.
query II
EXPLAIN SELECT id, coalesce(code, 'none') AS c FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*COALESCE\(\[code\], @p0\) AS \[c\].*

statement ok
CREATE TEMP TABLE u8_on AS SELECT id, coalesce(code, 'none') AS c FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;

statement ok
CREATE TEMP TABLE u8_off AS SELECT id, coalesce(code, 'none') AS c FROM rp_off.dbo.rp_t ORDER BY id LIMIT 10;

query IT
SELECT * FROM u8_on ORDER BY id;
----
1	b
2	a
3	none
4	B
5	ab

query I
SELECT count(*) FROM (SELECT * FROM u8_on EXCEPT ALL SELECT * FROM u8_off);
----
0

query TTT
SELECT a.column_name, a.data_type, b.data_type FROM duckdb_columns() a JOIN duckdb_columns() b USING (column_name)
WHERE a.table_name = 'u8_on' AND b.table_name = 'u8_off' ORDER BY a.column_index;
----
id	INTEGER	INTEGER
c	MSSQL_VARCHAR(20)	MSSQL_VARCHAR(20)

# The same on a connection not granted UTF8SUPPORT, where the server sends the
# UTF-8 column as nvarchar.
statement ok
SET mssql_utf8_support = false;

statement ok
SET mssql_remote_pushdown = true;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rp_nu (TYPE mssql);

statement ok
SET mssql_remote_pushdown = false;

statement ok
RESET mssql_utf8_support;

query II
EXPLAIN SELECT id, coalesce(code, 'none') AS c FROM rp_nu.dbo.rp_t ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*COALESCE\(\[code\], @p0\) AS \[c\].*

statement ok
CREATE TEMP TABLE u8_nu AS SELECT id, coalesce(code, 'none') AS c FROM rp_nu.dbo.rp_t ORDER BY id LIMIT 10;

query I
SELECT count(*) FROM (SELECT * FROM u8_nu EXCEPT ALL SELECT * FROM u8_off);
----
0

query I
SELECT count(*) FROM (SELECT * FROM u8_off EXCEPT ALL SELECT * FROM u8_nu);
----
0

statement ok
DETACH rp_nu;

# A code-page varchar in a computed value would arrive as its code-page bytes
# (#224): left to the scan, which reads it through its NVARCHAR cast.
query II
EXPLAIN SELECT id, coalesce(legacy, 'x') FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query IT
SELECT id, coalesce(legacy, 'x') FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
1	café

# Without IEEE floating-point ops DuckDB raises on a zero divisor, which the
# pushed form would turn into NULL: `/` is then not pushed.
statement ok
SET ieee_floating_point_ops = false;

query II
EXPLAIN SELECT id, n / 2 FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

statement ok
RESET ieee_floating_point_ops;

# IN / NOT IN, BETWEEN, LIKE / NOT LIKE, IS NULL of an expression, and a value
# compared with a value of the same type (PR C).
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE n IN (10, 30) AND amount BETWEEN 1 AND 5 AND name LIKE '%a' AND name NOT LIKE 'g%' AND amount >= amount AND (n + 1) IS NOT NULL ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*\(\[n\] IN \(@p0, @p1\)\).*\(\[amount\] BETWEEN @p2 AND @p3\).*\(\[name\] LIKE @p4\).*\(NOT \(\[name\] LIKE @p5\)\).*\(\[amount\] >= \[amount\]\).*IS NOT NULL.*

query I
SELECT id FROM rp_on.dbo.rp_t WHERE n IN (10, 30) AND amount BETWEEN 1 AND 5 AND name LIKE '%a' AND name NOT LIKE 'g%' AND amount >= amount AND (n + 1) IS NOT NULL ORDER BY id LIMIT 10;
----
1

query I
SELECT id FROM rp_off.dbo.rp_t WHERE n IN (10, 30) AND amount BETWEEN 1 AND 5 AND name LIKE '%a' AND name NOT LIKE 'g%' AND amount >= amount AND (n + 1) IS NOT NULL ORDER BY id LIMIT 10;
----
1

# NOT IN with a NULL in the list: no row on either side.
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE n NOT IN (10, NULL) ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*\(NOT \(\[n\] IN \(@p0, NULL\)\)\).*

query I
SELECT id FROM rp_on.dbo.rp_t WHERE n NOT IN (10, NULL) ORDER BY id LIMIT 10;
----

query I
SELECT id FROM rp_off.dbo.rp_t WHERE n NOT IN (10, NULL) ORDER BY id LIMIT 10;
----

# `[` is literal in a DuckDB pattern and opens a class in T-SQL: escaped, the
# pattern finds no row on either side (unescaped, `[a]` would match 'alpha').
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE name LIKE '%[a]%' ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*\(\[name\] LIKE @p0\).*

query I
SELECT id FROM rp_on.dbo.rp_t WHERE name LIKE '%[a]%' ORDER BY id LIMIT 10;
----

# NOT BETWEEN, IN over an expression, two string columns of one collation.
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE n NOT BETWEEN 15 AND 25 AND n + 1 IN (11, 31) AND name <> legacy ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*\(NOT \(\[n\] BETWEEN @p0 AND @p1\)\).*\(\(\[n\] \+ @p2\) IN \(@p3, @p4\)\).*\(\[name\] <> \[legacy\]\).*

query I
SELECT id FROM rp_on.dbo.rp_t WHERE n NOT BETWEEN 15 AND 25 AND n + 1 IN (11, 31) AND name <> legacy ORDER BY id LIMIT 10;
----
1

query I
SELECT id FROM rp_off.dbo.rp_t WHERE n NOT BETWEEN 15 AND 25 AND n + 1 IN (11, 31) AND name <> legacy ORDER BY id LIMIT 10;
----
1

# Vetoes: two collations (468 on the server), ILIKE, a LIKE pattern that is
# not a constant.
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE name = code ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE name ILIKE 'A%' ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

# nullif is not in the list above: it is a DuckDB macro (CASE WHEN a = b THEN
# NULL ELSE a END), and DuckDB's rewriter keeps a local macro local -- the
# writer renders NULLIF, but the node never reaches it.
query II
EXPLAIN SELECT id, nullif(n, 30) FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

# A zero divisor is the one recorded divergence (spec 079 D2): DuckDB's `/`
# gives inf, the server's float has none and a bare `/` raises 8134, so the
# pushed form returns NULL.
query R
SELECT id / tiny FROM rp_on.dbo.rp_t WHERE id = 5 ORDER BY id LIMIT 1;
----
NULL

query R
SELECT id / tiny FROM rp_off.dbo.rp_t WHERE id = 5 ORDER BY id LIMIT 1;
----
inf

# A string branch keeps the catalog type the local path gives it, with native
# types on and off.
statement ok
CREATE TEMP TABLE sc_on AS SELECT id, coalesce(name, 'none') AS c FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;

statement ok
CREATE TEMP TABLE sc_off AS SELECT id, coalesce(name, 'none') AS c FROM rp_off.dbo.rp_t ORDER BY id LIMIT 10;

query TTT
SELECT a.column_name, a.data_type, b.data_type FROM duckdb_columns() a JOIN duckdb_columns() b USING (column_name)
WHERE a.table_name = 'sc_on' AND b.table_name = 'sc_off' ORDER BY a.column_index;
----
id	INTEGER	INTEGER
c	MSSQL_NVARCHAR(50)	MSSQL_NVARCHAR(50)

query I
SELECT count(*) FROM (SELECT * FROM sc_on EXCEPT ALL SELECT * FROM sc_off);
----
0

statement ok
SET mssql_catalog_native_types = false;

statement ok
SELECT mssql_invalidate_cache('rp_on'), mssql_invalidate_cache('rp_off');

statement ok
CREATE TEMP TABLE sp_on AS SELECT id, coalesce(name, 'none') AS c FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;

statement ok
CREATE TEMP TABLE sp_off AS SELECT id, coalesce(name, 'none') AS c FROM rp_off.dbo.rp_t ORDER BY id LIMIT 10;

query TTT
SELECT a.column_name, a.data_type, b.data_type FROM duckdb_columns() a JOIN duckdb_columns() b USING (column_name)
WHERE a.table_name = 'sp_on' AND b.table_name = 'sp_off' ORDER BY a.column_index;
----
id	INTEGER	INTEGER
c	VARCHAR	VARCHAR

statement ok
RESET mssql_catalog_native_types;

statement ok
SELECT mssql_invalidate_cache('rp_on'), mssql_invalidate_cache('rp_off');

# With literals instead of parameters the constant says the column's type
# itself, so the branch keeps it (a bare N'none' is nvarchar(4000) there).
statement ok
SET mssql_scan_parameterize_filters = false;

statement ok
CREATE TEMP TABLE sl_on AS SELECT id, coalesce(code, 'none') AS c FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;

statement ok
CREATE TEMP TABLE sl_off AS SELECT id, coalesce(code, 'none') AS c FROM rp_off.dbo.rp_t ORDER BY id LIMIT 10;

statement ok
RESET mssql_scan_parameterize_filters;

query TTT
SELECT a.column_name, a.data_type, b.data_type FROM duckdb_columns() a JOIN duckdb_columns() b USING (column_name)
WHERE a.table_name = 'sl_on' AND b.table_name = 'sl_off' ORDER BY a.column_index;
----
id	INTEGER	INTEGER
c	MSSQL_VARCHAR(20)	MSSQL_VARCHAR(20)

# A constant wider than the column would widen the server's result type
# (varchar(30) for a varchar(20) column); DuckDB keeps the column's.
query II
EXPLAIN SELECT id, coalesce(code, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa') FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

# COALESCE over a division would turn the zero divisor's NULL into the
# fallback (-1 there, inf here).
query II
EXPLAIN SELECT id, coalesce(id / tiny, -1) FROM rp_on.dbo.rp_t ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query R
SELECT coalesce(id / tiny, -1) FROM rp_on.dbo.rp_t WHERE id = 5 ORDER BY id LIMIT 1;
----
inf

# Vetoes: branches of two types, a narrowing cast.
query II
EXPLAIN SELECT id, CASE WHEN n > 1 THEN n ELSE amount END FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query II
EXPLAIN SELECT id, CAST(n AS SMALLINT) FROM rp_on.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

#
# Types: a pushed SELECT reports the catalog's column types, read into them
# exactly as the catalog scan reads them (column_types) -- the datetime2(7)
# keeps its 100 ns ticks, the non-UTF-8 varchar its declared type, geometry.
#

statement ok
CREATE TEMP TABLE via_on AS SELECT * FROM rp_on.dbo.rp_t ORDER BY id LIMIT 100;

statement ok
CREATE TEMP TABLE via_off AS SELECT * FROM rp_off.dbo.rp_t ORDER BY id LIMIT 100;

query II
EXPLAIN SELECT * FROM rp_on.dbo.rp_t ORDER BY id LIMIT 100;
----
physical_plan	<REGEX>:.*CAST\(\[legacy\] AS NVARCHAR\(20\)\) AS \[legacy\].*\[g\]\.STAsBinary\(\) AS \[g\].*

query I
SELECT count(*) FROM (SELECT * FROM via_on EXCEPT ALL SELECT * FROM via_off);
----
0

query I
SELECT count(*) FROM (SELECT * FROM via_off EXCEPT ALL SELECT * FROM via_on);
----
0

query I
SELECT count(*) FROM via_on;
----
5

query TTT
SELECT column_name, a.data_type, b.data_type FROM duckdb_columns() a JOIN duckdb_columns() b USING (column_name)
WHERE a.table_name = 'via_on' AND b.table_name = 'via_off' AND a.data_type <> b.data_type;
----

query T
SELECT data_type FROM duckdb_columns() WHERE table_name = 'via_on' AND column_name IN ('legacy', 'ts', 'g') ORDER BY column_name;
----
GEOMETRY
MSSQL_VARCHAR(20)
TIMESTAMP_NS

query II
SELECT id, epoch_ns(ts) % 1000000000 FROM via_on WHERE ts IS NOT NULL ORDER BY id;
----
1	123456700
2	100
4	0
5	999999900

query IT
SELECT id, legacy FROM via_on WHERE id = 1;
----
1	café

#
# Vetoes: the statement stays on the scan path, with the right rows.
#

# Nothing gained over the scan (which pushes projections and filters itself):
# left to it, so an outer filter can still reach the server.
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE id = 2;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

# A set operation's child the rewriter would push on its own: a bare child
# stays with the scan, so the outer WHERE still reaches the server ...
query II
EXPLAIN SELECT * FROM (SELECT id FROM rp_on.dbo.rp_t UNION ALL SELECT id FROM loc) WHERE id = 2;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query I
SELECT * FROM (SELECT id FROM rp_on.dbo.rp_t UNION ALL SELECT id FROM loc) WHERE id = 2;
----
2

# ... and one with a LIMIT is pushed: nothing outside can pass below a LIMIT.
query II
EXPLAIN (SELECT id FROM rp_on.dbo.rp_t ORDER BY id LIMIT 2) UNION ALL (SELECT id FROM loc);
----
physical_plan	<REGEX>:.*SELECT TOP \(2\) \[id\] FROM \[dbo\]\.\[rp_t\] ORDER BY \[rp_t\]\.\[id\] ASC.*

query I
(SELECT id FROM rp_on.dbo.rp_t ORDER BY id LIMIT 2) UNION ALL (SELECT id FROM loc) ORDER BY id;
----
1
2
99

# nvarchar never orders like DuckDB (#362).
query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t ORDER BY name LIMIT 2;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

query I
SELECT id FROM rp_on.dbo.rp_t ORDER BY name LIMIT 2;
----
2
1


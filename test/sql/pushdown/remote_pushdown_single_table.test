# The setting read at ATTACH: rp_off never pushes.
query II
EXPLAIN SELECT id FROM rp_off.dbo.rp_t ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*MSSQL_CATALOG_SCAN.*

#
# mssql_scan_parameterize_filters = false renders literals instead.
#

statement ok
SET mssql_scan_parameterize_filters = false;

query II
EXPLAIN SELECT id FROM rp_on.dbo.rp_t WHERE id >= 2 ORDER BY id LIMIT 10;
----
physical_plan	<REGEX>:.*Mssql Scan.*WHERE \(\[id\] >= 2\) ORDER BY.*

statement ok
RESET mssql_scan_parameterize_filters;

#
# Inside a transaction the pushed statement runs on the pinned connection and
# sees the transaction's own writes.
#

statement ok
BEGIN;

statement ok
INSERT INTO rp_on.dbo.rp_t (id, n) VALUES (6, 5);

query II
SELECT id, n FROM rp_on.dbo.rp_t ORDER BY n LIMIT 2;
----
6	5
3	10

statement ok
ROLLBACK;

query I
SELECT count(*) FROM rp_on.dbo.rp_t WHERE id = 6;
----
0

#
# A pushed query feeding a sink of the same catalog: the rewriter pushes the
# SELECT of an INSERT on its own (the catalog claims no statement), and in a
# transaction the raw scan materialises before the sink takes the pinned
# connection. A CTAS keeps the catalog's column types (D3's CTAS window).
#

statement ok
SELECT mssql_exec('rp_off', 'DROP TABLE IF EXISTS dbo.rp_ctas; DROP TABLE IF EXISTS dbo.rp_ins; CREATE TABLE dbo.rp_ins (id int, ts datetime2(7))');

statement ok
SELECT mssql_invalidate_cache('rp_on'), mssql_invalidate_cache('rp_off');

query II
EXPLAIN INSERT INTO rp_on.dbo.rp_ins SELECT id, ts FROM rp_on.dbo.rp_t ORDER BY id LIMIT 2;
----
physical_plan	<REGEX>:.*SELECT TOP \(2\) \[id\], \[ts\] FROM \[dbo\]\.\[rp_t\] ORDER BY \[rp_t\]\.\[id\] ASC.*

statement ok
BEGIN;

statement ok
INSERT INTO rp_on.dbo.rp_ins SELECT id, ts FROM rp_on.dbo.rp_t ORDER BY id LIMIT 2;

statement ok
INSERT INTO rp_on.dbo.rp_ins SELECT id, ts FROM rp_on.dbo.rp_t ORDER BY id DESC LIMIT 1;

statement ok
COMMIT;

query II
SELECT id, epoch_ns(ts) % 1000000000 FROM rp_off.dbo.rp_ins ORDER BY id;
----
1	123456700
2	100
5	999999900

statement ok
CREATE TABLE rp_on.dbo.rp_ctas AS SELECT id, name, legacy, ts FROM rp_on.dbo.rp_t ORDER BY id LIMIT 2;

query TT
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'rp_on' AND table_name = 'rp_ctas'
AND column_name IN ('name', 'legacy', 'ts') ORDER BY column_name;
----
legacy	MSSQL_VARCHAR(20)
name	MSSQL_NVARCHAR(50)
ts	TIMESTAMP_NS

statement ok
SELECT mssql_exec('rp_off', 'DROP TABLE dbo.rp_ins; DROP TABLE dbo.rp_ctas');

#
# column_types, the vehicle's lever, refuses a type the column cannot be read as.
#

statement error
SELECT * FROM mssql_scan('rp_on', 'SELECT 1 AS a', column_types := ['DATE']);
----
is described as INTEGER and cannot be read as DATE

statement error
SELECT * FROM mssql_scan('rp_on', 'SELECT 1 AS a', column_types := ['INTEGER', 'INTEGER']);
----
column_types names 2 type(s), the statement returns 1 column(s)

# Only a datetime2 decodes into the vector's unit: a datetime relabelled as
# TIMESTAMP_NS would read its microseconds as nanoseconds.
statement error
SELECT * FROM mssql_scan('rp_on', 'SELECT CAST(''2024-01-01'' AS datetime) AS d', column_types := ['TIMESTAMP_NS']);
----
cannot be read as TIMESTAMP_NS

# A batch the server cannot describe runs at bind: refused before it runs.
statement error
SELECT * FROM mssql_scan('rp_on', 'CREATE TABLE #rp_x (a int); INSERT INTO #rp_x VALUES (1); SELECT a FROM #rp_x', column_types := ['INTEGER']);
----
column_types needs a statement the server can describe

query I
SELECT typeof(ts) FROM mssql_scan('rp_on', 'SELECT ts FROM dbo.rp_t WHERE id = 1', column_types := ['TIMESTAMP_NS']);
----
TIMESTAMP_NS

statement ok
SELECT mssql_exec('rp_off', 'DROP TABLE dbo.rp_t');

statement ok
DETACH rp_on;

statement ok
DETACH rp_off;

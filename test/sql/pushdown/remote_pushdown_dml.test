# name: test/sql/pushdown/remote_pushdown_dml.test
# description: UPDATE / DELETE sent to SQL Server whole through mssql_dml (spec 080 PR 3c): the shapes that go, the vetoes that keep the shipped path, the platform forms, transactions
# group: [pushdown]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# A pushed statement's plan is one `Mssql Dml` node carrying the T-SQL; a
# vetoed one plans as before (MSSQL_UPDATE / MSSQL_DELETE, or the staged
# operator). Results are checked here; that the two paths agree on the same
# data is remote_pushdown_dml_agreement.test.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS pd (TYPE mssql);

statement ok
SELECT mssql_exec('pd', 'DROP TABLE IF EXISTS dbo.dp_t; DROP VIEW IF EXISTS dbo.pd_v; DROP TABLE IF EXISTS dbo.pd_t; DROP TABLE IF EXISTS dbo.pd_src; DROP TABLE IF EXISTS dbo.pd_dup; CREATE TABLE dbo.pd_t (id int PRIMARY KEY, v int NOT NULL, s nvarchar(10) NULL, f float NULL); INSERT INTO dbo.pd_t SELECT TOP (10) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)), 0, NULL, NULL FROM sys.all_objects; CREATE TABLE dbo.pd_src (id int PRIMARY KEY, w int NOT NULL); INSERT INTO dbo.pd_src VALUES (1, 100), (2, 200), (11, 1100); CREATE TABLE dbo.pd_dup (id int NOT NULL, w int NOT NULL); INSERT INTO dbo.pd_dup VALUES (1, 5), (1, 6)');

statement ok
SELECT mssql_exec('pd', 'CREATE VIEW dbo.pd_v AS SELECT id, v FROM dbo.pd_t');

statement ok
SELECT mssql_invalidate_cache('pd');

# =============================================================================
# pushed: one statement, the WHERE and SET on the server
# =============================================================================

query II
EXPLAIN UPDATE pd.dbo.pd_t SET v = v + 1, s = 'x' WHERE id <= 3;
----
physical_plan	<REGEX>:.*Mssql Dml.*UPDATE \[r1\] SET \[v\] = \(\[r1\]\.\[v\] \+ @p0\), \[s\] = @p1 FROM \[dbo\]\.\[pd_t\] AS \[r1\] WHERE.*

query I
UPDATE pd.dbo.pd_t SET v = v + 1, s = 'x' WHERE id <= 3;
----
3

# CASE in SET, a constant in an IN list
query I
UPDATE pd.dbo.pd_t SET v = CASE WHEN id = 1 THEN 10 ELSE 20 END WHERE id IN (1, 2, 4);
----
3

query III
SELECT id, v, s FROM pd.dbo.pd_t WHERE id <= 4 ORDER BY id;
----
1	10	x
2	20	x
3	1	x
4	20	NULL

# no row matches
query I
UPDATE pd.dbo.pd_t SET v = 99 WHERE id > 1000;
----
0

# SET to NULL; a float constant into a float column
query I
UPDATE pd.dbo.pd_t SET s = NULL, f = 1.5 WHERE id = 3;
----
1

query II
SELECT s, f FROM pd.dbo.pd_t WHERE id = 3;
----
NULL	1.5

# a subquery in WHERE
query II
EXPLAIN UPDATE pd.dbo.pd_t SET v = 7 WHERE id IN (SELECT id FROM pd.dbo.pd_src WHERE w > 150);
----
physical_plan	<REGEX>:.*Mssql Dml.*

query I
UPDATE pd.dbo.pd_t SET v = 7 WHERE id IN (SELECT id FROM pd.dbo.pd_src WHERE w > 150);
----
1

# UPDATE ... FROM a table whose primary key the WHERE equates with the target's
query II
EXPLAIN UPDATE pd.dbo.pd_t SET v = pd_src.w FROM pd.dbo.pd_src WHERE pd_t.id = pd_src.id;
----
physical_plan	<REGEX>:.*Mssql Dml.*CROSS JOIN.*

query I
UPDATE pd.dbo.pd_t SET v = pd_src.w FROM pd.dbo.pd_src WHERE pd_t.id = pd_src.id;
----
2

query II
SELECT id, v FROM pd.dbo.pd_t WHERE id <= 2 ORDER BY id;
----
1	100
2	200

# an integer widened into a wider column goes (exact on both sides); the other
# way DuckDB casts down, and stays on the shipped path
statement ok
SELECT mssql_exec('pd', 'DROP TABLE IF EXISTS dbo.pd_w; CREATE TABLE dbo.pd_w (id int PRIMARY KEY, small smallint NOT NULL, big bigint NULL); INSERT INTO dbo.pd_w VALUES (1, 300, NULL)');

statement ok
SELECT mssql_invalidate_cache('pd');

query II
EXPLAIN UPDATE pd.dbo.pd_w SET big = small;
----
physical_plan	<REGEX>:.*Mssql Dml.*

query I
UPDATE pd.dbo.pd_w SET big = small;
----
1

query II
EXPLAIN UPDATE pd.dbo.pd_w SET small = big;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

statement ok
SELECT mssql_exec('pd', 'DROP TABLE dbo.pd_w');

# a SET of a key column goes too (T-SQL updates keys; only the fallback needs them fixed)
query II
EXPLAIN UPDATE pd.dbo.pd_t SET id = id + 100 WHERE id = 10;
----
physical_plan	<REGEX>:.*Mssql Dml.*

query I
UPDATE pd.dbo.pd_t SET id = id + 100 WHERE id = 10;
----
1

# DELETE, DELETE ... USING
query II
EXPLAIN DELETE FROM pd.dbo.pd_t WHERE id > 100;
----
physical_plan	<REGEX>:.*Mssql Dml.*DELETE \[r1\] FROM \[dbo\]\.\[pd_t\] AS \[r1\] WHERE.*

query I
DELETE FROM pd.dbo.pd_t WHERE id > 100;
----
1

query I
DELETE FROM pd.dbo.pd_t USING pd.dbo.pd_dup WHERE pd_t.id = pd_dup.id;
----
1

query I
SELECT count(*) FROM pd.dbo.pd_t;
----
8

# =============================================================================
# no key needed: tables the shipped path refuses (no usable rowid key, no
# rung 3) are written whole by the server, which selects the rows itself
# =============================================================================

statement ok
SELECT mssql_exec('pd', 'DROP TABLE IF EXISTS dbo.pd_xml; DROP TABLE IF EXISTS dbo.pd_t7; CREATE TABLE dbo.pd_xml (id int NOT NULL, doc xml NULL); INSERT INTO dbo.pd_xml VALUES (1, NULL), (1, NULL), (2, NULL); CREATE TABLE dbo.pd_t7 (k time(7) NOT NULL PRIMARY KEY, n int NOT NULL); INSERT INTO dbo.pd_t7 VALUES (''10:00:00.1234567'', 0), (''10:00:00.1234568'', 0)');

statement ok
SELECT mssql_invalidate_cache('pd');

# an xml column, no key: no rung 3 on the shipped path
query I
UPDATE pd.dbo.pd_xml SET id = 3 WHERE id = 1;
----
2

# a time(7) key, whose read keeps microseconds: never matched by the shipped path
query I
UPDATE pd.dbo.pd_t7 SET n = 1 WHERE n = 0;
----
2

query I
DELETE FROM pd.dbo.pd_xml USING pd.dbo.pd_src WHERE pd_xml.id = pd_src.id;
----
1

query I
SELECT count(*) FROM pd.dbo.pd_xml;
----
2

statement ok
SELECT mssql_exec('pd', 'DROP TABLE dbo.pd_xml; DROP TABLE dbo.pd_t7');

# =============================================================================
# vetoed: the shipped path, with its own semantics
# =============================================================================

# a function the writer has no T-SQL for (string functions are DuckDB's, D4)
query II
EXPLAIN UPDATE pd.dbo.pd_t SET v = 1 WHERE lower(s) = 'x';
----
physical_plan	<!REGEX>:.*Mssql Dml.*

# a decimal constant into an int column: DuckDB rounds 1.5 to 2, T-SQL would truncate
query II
EXPLAIN UPDATE pd.dbo.pd_t SET v = 1.5 WHERE id = 3;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

query I
UPDATE pd.dbo.pd_t SET v = 1.5 WHERE id = 3;
----
1

query I
SELECT v FROM pd.dbo.pd_t WHERE id = 3;
----
2

# a string constant longer than the column's declaration
query II
EXPLAIN UPDATE pd.dbo.pd_t SET s = 'abcdefghijkl' WHERE id = 3;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

# a date the server's `date` cannot hold: the RPC encoder would wrap it
# ('infinity' landed on 1969-12-31), so it stays with DuckDB, whose path
# renders a literal the server refuses
statement ok
SELECT mssql_exec('pd', 'DROP TABLE IF EXISTS dbo.pd_dt; CREATE TABLE dbo.pd_dt (id int PRIMARY KEY, d date NULL, dt datetime NULL, dt6 datetime2(6) NULL); INSERT INTO dbo.pd_dt VALUES (1, ''1969-12-31'', ''2026-01-01 10:00:00.007'', NULL)');

statement ok
SELECT mssql_invalidate_cache('pd');

query II
EXPLAIN UPDATE pd.dbo.pd_dt SET d = 'infinity' WHERE id = 1;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

query II
EXPLAIN DELETE FROM pd.dbo.pd_dt WHERE d = 'infinity';
----
physical_plan	<!REGEX>:.*Mssql Dml.*

# datetime and datetime2(6) are both TIMESTAMP here, and the server converts
# between them by rounding (.007 -> .006667) where DuckDB reads .006666: a
# column is copied only from one declared alike
query II
EXPLAIN UPDATE pd.dbo.pd_dt SET dt6 = dt;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

query II
EXPLAIN UPDATE pd.dbo.pd_dt SET dt = dt;
----
physical_plan	<REGEX>:.*Mssql Dml.*

statement ok
UPDATE pd.dbo.pd_dt SET dt6 = dt;

# DuckDB's value, as it reads the datetime; the server's conversion would have
# written .006667
query II
SELECT dt, dt6 FROM pd.dbo.pd_dt;
----
2026-01-01 10:00:00.006666	2026-01-01 10:00:00.006666

statement ok
SELECT mssql_exec('pd', 'DROP TABLE dbo.pd_dt');

# RETURNING stays on the staged path (PR 2b)
query II
EXPLAIN UPDATE pd.dbo.pd_t SET v = 3 WHERE id = 3 RETURNING id;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

# UPDATE ... FROM a source with no unique key: T-SQL would take an arbitrary match
query II
EXPLAIN UPDATE pd.dbo.pd_t SET v = pd_dup.w FROM pd.dbo.pd_dup WHERE pd_t.id = pd_dup.id;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

# a view: the shipped path refuses it, so a pushed one must not succeed
statement error
UPDATE pd.dbo.pd_v SET v = 1 WHERE id = 3;
----

# a DML CTE body: neither pushed nor handed back -- it runs as DuckDB runs it
query I
WITH c AS (UPDATE pd.dbo.pd_t SET v = 42 WHERE id = 3 RETURNING id) SELECT count(*) FROM c;
----
1

query I
SELECT v FROM pd.dbo.pd_t WHERE id = 3;
----
42

# and without RETURNING, which DuckDB accepts too: the RETURNING veto alone
# would not keep this one off the server
query I
WITH c AS (UPDATE pd.dbo.pd_t SET v = 41 WHERE id = 3) SELECT count(*) FROM c;
----
1

query I
SELECT v FROM pd.dbo.pd_t WHERE id = 3;
----
41

# beside a part that would be pushed on its own
query II
WITH c AS (UPDATE pd.dbo.pd_t SET v = 42 WHERE id = 3) SELECT (SELECT count(*) FROM c), (SELECT max(w) FROM (SELECT w FROM pd.dbo.pd_src ORDER BY w DESC LIMIT 2));
----
1	1100

# a DML body the query around it never reads still runs, as DuckDB runs it.
# Without the DML-CTE rule the writer rendered the SELECT alone and the UPDATE
# never ran (checked by disabling the rule: v stayed 42)
query I
WITH c AS (UPDATE pd.dbo.pd_t SET v = 50 WHERE id = 3) SELECT w FROM pd.dbo.pd_src ORDER BY w LIMIT 1;
----
100

query I
SELECT v FROM pd.dbo.pd_t WHERE id = 3;
----
50

statement ok
UPDATE pd.dbo.pd_t SET v = 42 WHERE id = 3;

# the switch
statement ok
SET mssql_dml_pushdown = false;

query II
EXPLAIN UPDATE pd.dbo.pd_t SET v = 1 WHERE id = 3;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

statement ok
RESET mssql_dml_pushdown;

# a read-only catalog: the shipped path's refusal, not the vehicle's
statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS pd_ro (TYPE mssql, READ_ONLY);

statement error
UPDATE pd_ro.dbo.pd_t SET v = 1 WHERE id = 3;
----
read-only

statement ok
DETACH pd_ro;

# =============================================================================
# in a transaction: on the pinned connection, undone by ROLLBACK
# =============================================================================

statement ok
BEGIN;

query I
UPDATE pd.dbo.pd_t SET v = 555;
----
8

query I
SELECT count(*) FROM pd.dbo.pd_t WHERE v = 555;
----
8

statement ok
ROLLBACK;

query I
SELECT count(*) FROM pd.dbo.pd_t WHERE v = 555;
----
0

statement ok
BEGIN;

query I
DELETE FROM pd.dbo.pd_t WHERE id = 9;
----
1

statement ok
COMMIT;

query I
SELECT count(*) FROM pd.dbo.pd_t;
----
7

# =============================================================================
# Fabric (emulated): the single-table form; FROM / USING stay staged
# =============================================================================

statement ok
SET mssql_test_dml_platform = 'fabric';

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS pf (TYPE mssql);

statement ok
RESET mssql_test_dml_platform;

query II
EXPLAIN UPDATE pf.dbo.pd_t SET v = v + 1 WHERE id = 3;
----
physical_plan	<REGEX>:.*Mssql Dml.*UPDATE \[dbo\]\.\[pd_t\] SET \[v\] = \(\[v\] \+ @p0\) WHERE \(\[id\] = @p1\).*

query I
UPDATE pf.dbo.pd_t SET v = v + 1 WHERE id = 3;
----
1

query II
EXPLAIN DELETE FROM pf.dbo.pd_t WHERE id = 8;
----
physical_plan	<REGEX>:.*Mssql Dml.*DELETE FROM \[dbo\]\.\[pd_t\] WHERE.*

query II
EXPLAIN UPDATE pf.dbo.pd_t SET v = pd_src.w FROM pf.dbo.pd_src WHERE pd_t.id = pd_src.id;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

query II
EXPLAIN UPDATE pf.dbo.pd_t SET v = 1 WHERE id IN (SELECT id FROM pf.dbo.pd_src);
----
physical_plan	<!REGEX>:.*Mssql Dml.*

statement ok
DETACH pf;

query I
SELECT v FROM pd.dbo.pd_t WHERE id = 3;
----
43

# =============================================================================
# a pool of one: the vehicle takes the one connection and gives it back
# =============================================================================

statement ok
SET mssql_connection_limit = 1;

statement ok
SET mssql_acquire_timeout = 5;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS p1 (TYPE mssql);

query I
UPDATE p1.dbo.pd_t SET v = 1 WHERE id = 2;
----
1

statement ok
BEGIN;

query I
SELECT count(*) FROM p1.dbo.pd_t;
----
7

query I
UPDATE p1.dbo.pd_t SET v = 2 WHERE id = 2;
----
1

statement ok
COMMIT;

query I
SELECT v FROM p1.dbo.pd_t WHERE id = 2;
----
2

statement ok
DETACH p1;

statement ok
RESET mssql_connection_limit;

statement ok
RESET mssql_acquire_timeout;

# =============================================================================
# INSERT ... SELECT (PR 3d): both sides on the server, no row crosses the wire
# =============================================================================

statement ok
SELECT mssql_exec('pd', 'DROP TABLE IF EXISTS dbo.pdi_src; DROP TABLE IF EXISTS dbo.pdi_dst; CREATE TABLE dbo.pdi_src (id int PRIMARY KEY, v int NOT NULL, s varchar(10) COLLATE SQL_Latin1_General_CP1_CI_AS NULL, g geometry NULL); INSERT INTO dbo.pdi_src VALUES (1, 10, ''caf'' + CHAR(233), geometry::Point(1, 2, 4326)), (2, 20, ''b'', NULL), (3, 30, NULL, NULL); CREATE TABLE dbo.pdi_dst (id int IDENTITY PRIMARY KEY, v int NOT NULL, s varchar(10) COLLATE SQL_Latin1_General_CP1_CI_AS NULL, g geometry NULL, d int NOT NULL DEFAULT 7)');

statement ok
SELECT mssql_invalidate_cache('pd');

# the columns are written as themselves: no NVARCHAR cast for the code-page
# varchar, no STAsBinary for the geometry -- the values never leave the server
query II
EXPLAIN INSERT INTO pd.dbo.pdi_dst (v, s, g) SELECT v, s, g FROM pd.dbo.pdi_src WHERE v > 5;
----
physical_plan	<REGEX>:.*Mssql Dml.*INSERT INTO \[dbo\]\.\[pdi_dst\] \(\[v\], \[s\], \[g\]\) SELECT \[v\], \[s\], \[g\] FROM \[dbo\]\.\[pdi_src\] WHERE.*

query I
INSERT INTO pd.dbo.pdi_dst (v, s, g) SELECT v, s, g FROM pd.dbo.pdi_src WHERE v > 5;
----
3

# the omitted column took the server's DEFAULT, the non-ASCII byte survived, the
# geometry is the source's
query III
SELECT id, s, d FROM pd.dbo.pdi_dst ORDER BY id;
----
1	café	7
2	b	7
3	NULL	7

# the geometry kept its SRID 4326: copied on the server -- the row path, which
# reads it as WKB, writes SRID 0
query III
SELECT * FROM mssql_scan('pd', 'SELECT id, CASE WHEN g IS NULL THEN ''-'' ELSE g.STAsText() END AS g, ISNULL(g.STSrid, -1) AS srid FROM dbo.pdi_dst ORDER BY id');
----
1	POINT (1 2)	4326
2	-	-1
3	-	-1

# naming the identity column: IDENTITY_INSERT around the statement
query II
EXPLAIN INSERT INTO pd.dbo.pdi_dst (id, v) SELECT id + 100, v FROM pd.dbo.pdi_src;
----
physical_plan	<REGEX>:.*Mssql Dml.*

query I
INSERT INTO pd.dbo.pdi_dst (id, v) SELECT id + 100, v FROM pd.dbo.pdi_src;
----
3

query I
SELECT count(*) FROM pd.dbo.pdi_dst WHERE id > 100;
----
3

# an aggregate of the column's type goes; count(*) is BIGINT, which an int
# column does not take as it is (DuckDB casts it down), and a string constant
# is the server's to type: both stay on the shipped path
query II
EXPLAIN INSERT INTO pd.dbo.pdi_dst (v) SELECT max(v) FROM pd.dbo.pdi_src;
----
physical_plan	<REGEX>:.*Mssql Dml.*

query II
EXPLAIN INSERT INTO pd.dbo.pdi_dst (v) SELECT count(*) FROM pd.dbo.pdi_src;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

query II
EXPLAIN INSERT INTO pd.dbo.pdi_dst (v, s) SELECT v, 'k' FROM pd.dbo.pdi_src;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

# the shipped path's shapes: VALUES, a local source, RETURNING, ON CONFLICT
query II
EXPLAIN INSERT INTO pd.dbo.pdi_dst (v) VALUES (1);
----
physical_plan	<!REGEX>:.*Mssql Dml.*

query II
EXPLAIN INSERT INTO pd.dbo.pdi_dst (v) SELECT i::INTEGER FROM range(3) r(i);
----
physical_plan	<!REGEX>:.*Mssql Dml.*

query II
EXPLAIN INSERT INTO pd.dbo.pdi_dst (v) SELECT v FROM pd.dbo.pdi_src RETURNING id;
----
physical_plan	<!REGEX>:.*Mssql Dml.*

# in a transaction: undone by ROLLBACK
statement ok
BEGIN;

query I
INSERT INTO pd.dbo.pdi_dst (v) SELECT v FROM pd.dbo.pdi_src;
----
3

statement ok
ROLLBACK;

query I
SELECT count(*) FROM pd.dbo.pdi_dst;
----
6

# Fabric (emulated): the same form
statement ok
SET mssql_test_dml_platform = 'fabric';

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS pdf (TYPE mssql);

statement ok
RESET mssql_test_dml_platform;

query II
EXPLAIN INSERT INTO pdf.dbo.pdi_dst (v) SELECT v FROM pdf.dbo.pdi_src;
----
physical_plan	<REGEX>:.*Mssql Dml.*INSERT INTO \[dbo\]\.\[pdi_dst\].*

statement ok
DETACH pdf;

statement ok
SELECT mssql_exec('pd', 'DROP TABLE dbo.pdi_src; DROP TABLE dbo.pdi_dst');

# --- cleanup -----------------------------------------------------------------

statement ok
SELECT mssql_exec('pd', 'DROP VIEW dbo.pd_v; DROP TABLE dbo.pd_t; DROP TABLE dbo.pd_src; DROP TABLE dbo.pd_dup');

statement ok
DETACH pd;

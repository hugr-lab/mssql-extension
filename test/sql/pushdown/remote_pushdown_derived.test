# name: test/sql/pushdown/remote_pushdown_derived.test
# description: Spec 079 PR E1 -- a subquery in FROM (a derived table) is rendered in place and the statement goes whole; both paths agree on rows and types
# group: [pushdown]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# A derived table's columns are its node's results, already read: a code-page
# varchar arrives through its NVARCHAR cast once, an integer SUM is cast back
# to HUGEINT once. The outer node compares and orders a derived column only
# when it knows the column's type.

require mssql

require-env MSSQL_TESTDB_DSN

# The comparison catalog: pushdown off (on by default since PR E2).
statement ok
SET mssql_remote_pushdown = false;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rd_off (TYPE mssql);

statement ok
SET mssql_remote_pushdown = true;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS rd_on (TYPE mssql);

statement ok
SET mssql_remote_pushdown = false;

statement ok
SELECT mssql_exec('rd_off', 'DROP TABLE IF EXISTS dbo.rd_t;
	CREATE TABLE dbo.rd_t (id int NOT NULL PRIMARY KEY, g int NOT NULL, n int NULL,
		legacy varchar(20) COLLATE SQL_Latin1_General_CP1_CI_AS NULL);
	INSERT INTO dbo.rd_t VALUES (1, 1, 10, ''caf'' + CHAR(233)), (2, 1, 20, ''b''), (3, 2, NULL, ''c''), (4, 3, 40, ''d''), (5, 3, 5, ''e'')');

# An aggregate in FROM, filtered and ordered outside: one statement.
query II
EXPLAIN SELECT s.g, s.c FROM (SELECT g, count(*) AS c FROM rd_on.dbo.rd_t GROUP BY g) s WHERE s.c > 1 ORDER BY s.g;
----
physical_plan	<REGEX>:.*FROM \(SELECT \[g\], COUNT_BIG\(\*\) AS \[c\] FROM \[dbo\]\.\[rd_t\] GROUP BY \[g\]\) AS \[r1\] WHERE \(\[r1\]\.\[c\] > @p0\).*

query II
SELECT s.g, s.c FROM (SELECT g, count(*) AS c FROM rd_on.dbo.rd_t GROUP BY g) s WHERE s.c > 1 ORDER BY s.g;
----
1	2
3	2

query II
SELECT s.g, s.c FROM (SELECT g, count(*) AS c FROM rd_off.dbo.rd_t GROUP BY g) s WHERE s.c > 1 ORDER BY s.g;
----
1	2
3	2

# Types: an integer SUM cast back once (HUGEINT), a code-page varchar read
# through its cast once (non-ASCII intact).
statement ok
CREATE TEMP TABLE d_on2 AS SELECT s.id, s.legacy FROM (SELECT id, legacy FROM rd_on.dbo.rd_t ORDER BY id LIMIT 2) s ORDER BY s.id;

query IT
SELECT * FROM d_on2;
----
1	café
2	b

query II
EXPLAIN SELECT s.id, s.legacy FROM (SELECT id, legacy FROM rd_on.dbo.rd_t ORDER BY id LIMIT 2) s ORDER BY s.id;
----
physical_plan	<REGEX>:.*SELECT \[r1\]\.\[id\] AS \[id\], \[r1\]\.\[legacy\] AS \[legacy\] FROM \(SELECT TOP \(2\) \[id\], CAST\(\[legacy\] AS NVARCHAR\(20\)\) AS \[legacy\].*

query IT
SELECT s.total, typeof(s.total) FROM (SELECT g, sum(n) AS total FROM rd_on.dbo.rd_t GROUP BY g) s WHERE s.total > 25 ORDER BY 1 LIMIT 5;
----
30	HUGEINT
45	HUGEINT

query I
SELECT s.total FROM (SELECT g, sum(n) AS total FROM rd_off.dbo.rd_t GROUP BY g) s WHERE s.total > 25 ORDER BY 1 LIMIT 5;
----
30
45

# A derived table joined with a base table on its key: one statement.
query II
EXPLAIN SELECT t.id, s.c FROM rd_on.dbo.rd_t t JOIN (SELECT g, count(*) AS c FROM rd_on.dbo.rd_t GROUP BY g) s ON s.g = t.g ORDER BY t.id LIMIT 10;
----
physical_plan	<REGEX>:.*FROM \[dbo\]\.\[rd_t\] AS \[r1\] INNER JOIN \(SELECT \[g\], COUNT_BIG\(\*\) AS \[c\] FROM \[dbo\]\.\[rd_t\] GROUP BY \[g\]\) AS \[r2\].*

query II
SELECT t.id, s.c FROM rd_on.dbo.rd_t t JOIN (SELECT g, count(*) AS c FROM rd_on.dbo.rd_t GROUP BY g) s ON s.g = t.g ORDER BY t.id LIMIT 10;
----
1	2
2	2
3	1
4	2
5	2

# Nested: a derived table inside a derived table.
query I
SELECT x.c FROM (SELECT s.g, s.c FROM (SELECT g, count(*) AS c FROM rd_on.dbo.rd_t GROUP BY g) s WHERE s.g > 1) x ORDER BY x.c LIMIT 5;
----
1
2

# A division (or a floating-point aggregate) stays a value outside its node:
# x / 0 is NULL there and inf here, so comparing, ordering or COALESCEing it
# outside would change the rows (review of E1). Both paths agree.
statement ok
SELECT mssql_exec('rd_off', 'DROP TABLE IF EXISTS dbo.rd_d; CREATE TABLE dbo.rd_d (id int NOT NULL, x int NULL, y int NULL);
	INSERT INTO dbo.rd_d VALUES (1, 10, 0), (2, 20, 5), (3, NULL, 2), (4, 40, 0), (5, 5, 1)');

query I
SELECT s.id FROM (SELECT id, x / y AS r FROM rd_on.dbo.rd_d ORDER BY id LIMIT 10) s WHERE s.r > 1 ORDER BY 1;
----
1
2
4
5

query I
SELECT s.id FROM (SELECT id, x / y AS r FROM rd_off.dbo.rd_d ORDER BY id LIMIT 10) s WHERE s.r > 1 ORDER BY 1;
----
1
2
4
5

query I
SELECT s.id FROM (SELECT id, x / y AS r FROM rd_on.dbo.rd_d ORDER BY id LIMIT 10) s WHERE s.r IS NULL ORDER BY 1;
----
3

# Carried out of its node by an enclosing one and filtered by DuckDB above a
# vehicle (an EXCLUDE hands the outer node back): a part holding a division
# two levels down is not pushed, or NULL-for-inf would reach the filter
# (review of #399: one level of nesting hid the flag; pushed it returned the
# rows of ids 1, 3 and 4).
query I
SELECT * EXCLUDE (k) FROM (SELECT s.r AS r, 1 AS k FROM (SELECT id, x / y AS r FROM rd_on.dbo.rd_d) s LIMIT 10) q WHERE q.r IS NULL;
----
NULL

query I
SELECT * EXCLUDE (k) FROM (SELECT s.r AS r, 1 AS k FROM (SELECT id, x / y AS r FROM rd_off.dbo.rd_d) s LIMIT 10) q WHERE q.r IS NULL;
----
NULL

statement ok
SELECT mssql_exec('rd_off', 'DROP TABLE dbo.rd_d');

# Vetoes. An ORDER BY without LIMIT inside (1033 there): handed back.
query I
SELECT s.id FROM (SELECT id FROM rd_on.dbo.rd_t ORDER BY id) s WHERE s.id > 3 ORDER BY 1;
----
4
5

# A derived column read through a CAST is not compared on the server.
query I
SELECT s.id FROM (SELECT id, legacy FROM rd_on.dbo.rd_t ORDER BY id LIMIT 5) s WHERE s.legacy = 'b';
----
2

statement ok
SELECT mssql_exec('rd_off', 'DROP TABLE dbo.rd_t');

statement ok
DETACH rd_on;

statement ok
DETACH rd_off;

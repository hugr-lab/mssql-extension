# name: test/sql/attach/attach_transaction_isolation.test
# description: transaction_isolation values are validated at ATTACH (issue #331); no server needed
# group: [attach]

require mssql

# Spellings normalise: case, spaces and hyphens.
statement ok
ATTACH 'Server=unreachable.invalid,1433;Database=db;User Id=u;Password=p' AS ti_ok1 (TYPE mssql, lazy_validation true, catalog false, transaction_isolation 'READ COMMITTED');

statement ok
DETACH ti_ok1;

statement ok
ATTACH 'Server=unreachable.invalid,1433;Database=db;User Id=u;Password=p;TransactionIsolation=repeatable-read' AS ti_ok2 (TYPE mssql, lazy_validation true, catalog false);

statement ok
DETACH ti_ok2;

statement ok
ATTACH 'Server=unreachable.invalid,1433;Database=db;User Id=u;Password=p' AS ti_ok3 (TYPE mssql, lazy_validation true, catalog false, transaction_isolation 'default');

statement ok
DETACH ti_ok3;

# Anything else is refused by name, listing what is accepted.
statement error
ATTACH 'Server=unreachable.invalid,1433;Database=db;User Id=u;Password=p' AS ti_bad (TYPE mssql, lazy_validation true, catalog false, transaction_isolation 'snapshots');
----
transaction_isolation 'snapshots' is not one of default, read_uncommitted, read_committed, repeatable_read, serializable, snapshot, auto

# An explicit snapshot whose database could not be probed (no catalog, no
# connection) is accepted: unknown is not OFF.
statement ok
ATTACH 'Server=unreachable.invalid,1433;Database=db;User Id=u;Password=p' AS ti_unknown (TYPE mssql, lazy_validation true, catalog false, transaction_isolation 'snapshot');

statement ok
DETACH ti_unknown;

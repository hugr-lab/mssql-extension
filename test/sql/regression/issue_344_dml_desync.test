# name: test/sql/regression/issue_344_dml_desync.test
# description: a TDS desync in a DML response is reported, names what the server did, never hangs -- and leaves the table as it was (issues #323, #344; spec 062 W1c)
# group: [mssql]
# issue: 344

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# The four DML response loops -- the INSERT batch, INSERT ... RETURNING, UPDATE,
# DELETE -- are copies of one loop, and the fifth copy (MSSQLSimpleQuery) got
# the #323 fixes alone. A parser that desynced mid-response was fed the whole
# remaining response for nothing, and then reported SUCCESS: the EOM branch
# forced `done` and nothing checked the parser's state. The RETURNING copy did
# worse: its loop has no EOM exit at all, so it blocked on the next packet for
# the full 30 s and then blamed the socket.
#
# A desync is a client-side framing failure -- by the time it is noticed the
# server has run the batch. Until spec 062 W1c every batch was its own committed
# statement in autocommit, so a failure in batch K left batches 1..K-1 applied
# and the message could only say so (#344). Now a statement runs on ONE
# connection inside ONE server transaction: the failing batch and every batch
# before it are rolled back together, and the message says that. So each case
# below checks three things: the statement fails naming the desync and what was
# executed, it says the rows were rolled back, and the table is exactly as it
# was.
#
# mssql_test_fail_parse_after_tokens is the lever: a desync cannot be induced
# from SQL since spec 072, so the loops put their parser into Error after N
# tokens themselves, as a framing error would. The counts below depend on the
# batch sizes: mssql_dml_batch_size = 500; INSERT statements carry at most
# 1000 constants (spec 062 W1b), 500 rows for this two-column table.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS i344 (TYPE mssql);

statement ok
SELECT mssql_exec('i344', 'IF OBJECT_ID(''dbo.i344'') IS NOT NULL DROP TABLE dbo.i344; CREATE TABLE dbo.i344 (id INT NOT NULL PRIMARY KEY, n INT NULL)');

statement ok
SELECT mssql_invalidate_cache('i344');

statement ok
INSERT INTO i344.dbo.i344 SELECT i, 1 FROM range(1, 1201) t(i);

query I
SELECT count(*) FROM i344.dbo.i344;
----
1200

# --- UPDATE: 1200 rows = batches of 500, 500, 200. The first batch's response
# desyncs at its first token: the statement fails, names the batch, and the
# 500 rows the server DID update are rolled back with the statement.
statement ok
SET mssql_test_fail_parse_after_tokens = 1;

statement error
UPDATE i344.dbo.i344 SET n = 2;
----
TDS parse error

statement error
UPDATE i344.dbo.i344 SET n = 2;
----
the server executed this batch (batch 1); rolled back

statement ok
SET mssql_test_fail_parse_after_tokens = 0;

# two failed statements above, each ran its first batch and rolled it back
query I
SELECT count(*) FROM i344.dbo.i344 WHERE n = 2;
----
0

# the connection the desync happened on is usable again (drained to EOM, Idle)
query I
SELECT count(*) FROM i344.dbo.i344 WHERE n = 1;
----
1200

# --- DELETE: the same shape; the first batch of 500 was deleted on the server
# and rolled back, nothing is gone.
statement ok
SET mssql_test_fail_parse_after_tokens = 1;

statement error
DELETE FROM i344.dbo.i344;
----
the server executed this batch (batch 1); rolled back

statement ok
SET mssql_test_fail_parse_after_tokens = 0;

query I
SELECT count(*) FROM i344.dbo.i344;
----
1200

# --- INSERT batch: 1200 rows = statements of 500, 500, 200 (two columns,
# 1000 constants each). Statement 0 runs and its response desyncs: the error
# says so, without a "[0]" server code, and its rows are rolled back.
statement ok
SET mssql_test_fail_parse_after_tokens = 1;

statement error
INSERT INTO i344.dbo.i344 SELECT i, 3 FROM range(2001, 3201) t(i);
----
INSERT failed at statement 0 (rows 0-499): TDS parse error

statement error
INSERT INTO i344.dbo.i344 SELECT i, 3 FROM range(2001, 3201) t(i);
----
the server executed this statement; rolled back

statement ok
SET mssql_test_fail_parse_after_tokens = 0;

query I
SELECT count(*) FROM i344.dbo.i344 WHERE n = 3;
----
0

# --- INSERT ... RETURNING: the loop that used to hang for its full 30 s and
# then report the socket. It now fails at once naming the desync, and the row
# is rolled back.
statement ok
SET mssql_test_fail_parse_after_tokens = 1;

statement error
INSERT INTO i344.dbo.i344 VALUES (9001, 4) RETURNING id;
----
TDS parse error

statement ok
SET mssql_test_fail_parse_after_tokens = 0;

query I
SELECT count(*) FROM i344.dbo.i344 WHERE id = 9001;
----
0

# --- inside a DuckDB transaction the rows sit in the open transaction until
# its ROLLBACK, and the message says so.
statement ok
BEGIN;

statement ok
SET mssql_test_fail_parse_after_tokens = 1;

statement error
UPDATE i344.dbo.i344 SET n = 7;
----
in the open transaction

# DuckDB refuses every statement in an aborted transaction until ROLLBACK, the
# SET included.
statement ok
ROLLBACK;

statement ok
SET mssql_test_fail_parse_after_tokens = 0;

query I
SELECT count(*) FROM i344.dbo.i344 WHERE n = 7;
----
0

# --- with the lever off, every path is what it was, and the table still holds
# its original 1200 rows
statement ok
UPDATE i344.dbo.i344 SET n = 5 WHERE id BETWEEN 1 AND 10;

query I
SELECT count(*) FROM i344.dbo.i344 WHERE n = 5;
----
10

query I
INSERT INTO i344.dbo.i344 VALUES (9002, 6) RETURNING id;
----
9002

query I
SELECT count(*) FROM i344.dbo.i344;
----
1201

statement ok
SELECT mssql_exec('i344', 'DROP TABLE dbo.i344');

statement ok
DETACH i344;

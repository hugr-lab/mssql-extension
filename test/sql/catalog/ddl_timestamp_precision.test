# name: test/sql/catalog/ddl_timestamp_precision.test
# description: spec 045 FR-024 regression — TIMESTAMP_MS/NS/SEC map to
#              DATETIME2(3)/(7)/(0) in both CREATE TABLE and CTAS contexts.
#              Pre-spec-045 these threw NotImplementedException at DDL time.
# group: [mssql]

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db_tspre (TYPE mssql);

statement ok
DROP TABLE IF EXISTS db_tspre.dbo.ts_precision_create;

statement ok
DROP TABLE IF EXISTS db_tspre.dbo.ts_precision_ctas;

# -----------------------------------------------------------------------------
# Plain CREATE TABLE path (MapTypeToSQLServer)
# -----------------------------------------------------------------------------

statement ok
CREATE TABLE db_tspre.dbo.ts_precision_create (
    col_ms  TIMESTAMP_MS,
    col_ns  TIMESTAMP_NS,
    col_sec TIMESTAMP_S,
    col_ts  TIMESTAMP,
    col_tz  TIMESTAMP WITH TIME ZONE,
    col_time TIME
);

# Verify SQL Server-side column types via sys.columns.
# Expected mapping (spec 045 FR-024 + FR-027):
#   TIMESTAMP_MS  → DATETIME2(3)
#   TIMESTAMP_NS  → DATETIME2(7)
#   TIMESTAMP_S → DATETIME2(0)
#   TIMESTAMP     → DATETIME2(6)
#   TIMESTAMP_TZ  → DATETIMEOFFSET(7)
#   TIME          → TIME(6)
query TTI
SELECT name, type_name, scale
FROM mssql_scan('db_tspre', '
    SELECT c.name AS name, t.name AS type_name, c.scale AS scale
    FROM sys.columns c
    JOIN sys.types t ON c.system_type_id = t.system_type_id AND t.user_type_id = t.system_type_id
    WHERE c.object_id = OBJECT_ID(''dbo.ts_precision_create'')
    ORDER BY c.column_id
');
----
col_ms	datetime2	3
col_ns	datetime2	7
col_sec	datetime2	0
col_ts	datetime2	6
col_tz	datetimeoffset	7
col_time	time	6

# -----------------------------------------------------------------------------
# CTAS path (MapLogicalTypeToCTAS)
# -----------------------------------------------------------------------------

statement ok
CREATE TABLE db_tspre.dbo.ts_precision_ctas AS
SELECT
    TIMESTAMP_MS '2024-01-15 10:30:45.123'           AS col_ms,
    TIMESTAMP_NS '2024-01-15 10:30:45.1234567'       AS col_ns,
    TIMESTAMP_S  '2024-01-15 10:30:45'               AS col_sec,
    TIMESTAMP    '2024-01-15 10:30:45.123456'        AS col_ts,
    TIMESTAMPTZ  '2024-01-15 10:30:45+00'            AS col_tz,
    TIME         '10:30:45.123456'                   AS col_time;

# CTAS-created columns must match the plain-CREATE-TABLE columns byte-for-byte
# (FR-028 — both DDL contexts share the dispatcher).
query TTI
SELECT name, type_name, scale
FROM mssql_scan('db_tspre', '
    SELECT c.name AS name, t.name AS type_name, c.scale AS scale
    FROM sys.columns c
    JOIN sys.types t ON c.system_type_id = t.system_type_id AND t.user_type_id = t.system_type_id
    WHERE c.object_id = OBJECT_ID(''dbo.ts_precision_ctas'')
    ORDER BY c.column_id
');
----
col_ms	datetime2	3
col_ns	datetime2	7
col_sec	datetime2	0
col_ts	datetime2	6
col_tz	datetimeoffset	7
col_time	time	6

# -----------------------------------------------------------------------------
# BCP encode round-trip — verify on the server side that no precision was
# silently truncated by the BCP encoder. mssql_scan + server-side CONVERT
# bypasses any decoder-side rounding so we observe exactly what landed on disk.
# -----------------------------------------------------------------------------

query TTTTT
SELECT * FROM mssql_scan('db_tspre', '
    SELECT CONVERT(NVARCHAR(40), col_ms,  121) AS col_ms,
           CONVERT(NVARCHAR(40), col_ns,  121) AS col_ns,
           CONVERT(NVARCHAR(40), col_sec, 121) AS col_sec,
           CONVERT(NVARCHAR(40), col_ts,  121) AS col_ts,
           CONVERT(NVARCHAR(40), col_tz,  121) AS col_tz
    FROM dbo.ts_precision_ctas
');
----
2024-01-15 10:30:45.123	2024-01-15 10:30:45.1234567	2024-01-15 10:30:45	2024-01-15 10:30:45.123456	2024-01-15 10:30:45.0000000 +00:00

# -----------------------------------------------------------------------------
# Type-transparent read-back — DATETIME2(scale) maps to the narrowest DuckDB
# TIMESTAMP_* variant that holds the full wire precision losslessly:
#   DATETIME2(0)  → TIMESTAMP_S
#   DATETIME2(3)  → TIMESTAMP_MS
#   DATETIME2(6)  → TIMESTAMP
#   DATETIME2(7)  → TIMESTAMP_NS
# Values round-trip byte-for-byte (no µs-bottleneck precision loss).
# -----------------------------------------------------------------------------

query TTTTTTTT
SELECT typeof(col_ms), col_ms,
       typeof(col_ns), col_ns,
       typeof(col_sec), col_sec,
       typeof(col_ts), col_ts
FROM db_tspre.dbo.ts_precision_ctas;
----
TIMESTAMP_MS	2024-01-15 10:30:45.123	TIMESTAMP_NS	2024-01-15 10:30:45.1234567	TIMESTAMP_S	2024-01-15 10:30:45	TIMESTAMP	2024-01-15 10:30:45.123456

# -----------------------------------------------------------------------------
# COPY's auto-create is a THIRD translator (TargetResolver::GetSQLServerType-
# Declaration), and it drifted: it emitted time(6) while CTAS emitted TIME(7)
# for the same DuckDB TIME. Both were lossless, but the two paths disagreed —
# and the BCP encoder had already committed to scale 6, so the CTAS column was
# declared time(7) while its own wire metadata said 6.
# -----------------------------------------------------------------------------

statement ok
DROP TABLE IF EXISTS db_tspre.dbo.ts_precision_copy;

statement ok
COPY (
    SELECT TIMESTAMP_MS '2024-01-15 10:30:45.123'      AS col_ms,
           TIMESTAMP_NS '2024-01-15 10:30:45.123456789' AS col_ns,
           TIMESTAMP_S  '2024-01-15 10:30:45'          AS col_sec,
           TIMESTAMP    '2024-01-15 10:30:45.123456'   AS col_ts,
           TIME         '10:30:45.123456'              AS col_time
) TO 'mssql://db_tspre/dbo/ts_precision_copy' (FORMAT 'bcp');

query TTI
SELECT name, type_name, scale
FROM mssql_scan('db_tspre', '
    SELECT c.name AS name, t.name AS type_name, c.scale AS scale
    FROM sys.columns c
    JOIN sys.types t ON c.system_type_id = t.system_type_id AND t.user_type_id = t.system_type_id
    WHERE c.object_id = OBJECT_ID(''dbo.ts_precision_copy'')
    ORDER BY c.column_id
');
----
col_ms	datetime2	3
col_ns	datetime2	7
col_sec	datetime2	0
col_ts	datetime2	6
col_time	time	6

# The values survive the round trip at that precision. This is issue #231: COPY
# re-reads the created table from sys.columns, where every datetime2 maps back
# to TIMESTAMP whatever its scale, and the encoder used THAT type to read the
# raw value's unit — so a TIMESTAMP_MS landed as 1970-01-20 and a TIMESTAMP_NS
# was rejected by the server outright. The unit comes from the source vector now.
# col_ns NARROWS here: the source is TIMESTAMP_NS '...123456789' (nine digits)
# into datetime2(7), and a narrowing conversion now ROUNDS rather than
# truncating — matching the server, which answers .1234568 for the same CAST
# (verified). Truncation gave .1234567, so identical data loaded by COPY and by
# INSERT ... CAST disagreed silently (spec 057). The CTAS block above is
# unaffected: its source is already .1234567, so there is nothing to round.
query TTTTT
SELECT * FROM mssql_scan('db_tspre', '
    SELECT CONVERT(NVARCHAR(40), col_ms, 121) AS col_ms,
           CONVERT(NVARCHAR(40), col_ns, 121) AS col_ns,
           CONVERT(NVARCHAR(40), col_sec, 121) AS col_sec,
           CONVERT(NVARCHAR(40), col_ts, 121) AS col_ts,
           CONVERT(NVARCHAR(40), col_time, 121) AS col_time
    FROM dbo.ts_precision_copy
');
----
2024-01-15 10:30:45.123	2024-01-15 10:30:45.1234568	2024-01-15 10:30:45	2024-01-15 10:30:45.123456	10:30:45.123456

# Deliberate narrowing: a source finer than the target is converted rather than
# corrupting, which is what makes the fix general — the two precisions no longer
# have to agree.
#
# It ROUNDS, and that is a change (spec 057). This block previously pinned
# truncation, chosen because it does not corrupt — but rounding does not corrupt
# either AND is what SQL Server itself does: for these two values it answers
# .988 and 10:30:46, verified against the server. Truncating meant the same data
# loaded by COPY and by INSERT ... CAST disagreed silently, and disagreed with
# this extension's own decimal path, which already rounded when narrowing.
statement ok
SELECT mssql_exec('db_tspre', 'DROP TABLE IF EXISTS dbo.ts_narrow');

statement ok
SELECT mssql_exec('db_tspre', 'CREATE TABLE dbo.ts_narrow (a datetime2(3), b datetime2(0))');

statement ok
COPY (SELECT TIMESTAMP_NS '2024-01-15 10:30:45.987654321' AS a,
             TIMESTAMP_MS '2024-01-15 10:30:45.987'       AS b)
  TO 'mssql://db_tspre/dbo/ts_narrow' (FORMAT 'bcp', CREATE_TABLE false);

query TT
SELECT * FROM mssql_scan('db_tspre', '
    SELECT CONVERT(NVARCHAR(40), a, 121) AS a, CONVERT(NVARCHAR(40), b, 121) AS b FROM dbo.ts_narrow
');
----
2024-01-15 10:30:45.988	2024-01-15 10:30:46

# -----------------------------------------------------------------------------
# Cleanup
# -----------------------------------------------------------------------------

statement ok
SELECT mssql_exec('db_tspre', 'DROP TABLE IF EXISTS dbo.ts_narrow');

statement ok
DROP TABLE db_tspre.dbo.ts_precision_copy;

statement ok
DROP TABLE db_tspre.dbo.ts_precision_create;

statement ok
DROP TABLE db_tspre.dbo.ts_precision_ctas;

statement ok
DETACH db_tspre;

# name: test/sql/catalog/filter_params_rpc.test
# description: Spec 083 -- pushed filter constants travel as typed parameters of an sp_executesql RPC call; every type answers as the literal form does
# group: [mssql]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS frp (TYPE mssql);

statement ok
SELECT mssql_exec('frp', 'DROP TABLE IF EXISTS dbo.frp_t; CREATE TABLE dbo.frp_t (
	id int NOT NULL PRIMARY KEY, ti tinyint NULL, b bit NULL, f float NULL, r real NULL,
	d10 decimal(10,2) NULL, d38 decimal(38,0) NULL, m money NULL,
	vc varchar(40) COLLATE Latin1_General_100_CI_AS NULL, nv nvarchar(40) NULL,
	dt date NULL, tm time(7) NULL, dt7 datetime2(7) NULL, dt3 datetime2(3) NULL, dtl datetime NULL,
	dto datetimeoffset(7) NULL, g uniqueidentifier NULL, vb varbinary(64) NULL);
	INSERT INTO dbo.frp_t VALUES
	(1, 200, 1, 1.5, 2.25, 12.34, 99999999999999999999999999, 12.3456, ''abc'', N''привет'',
	 ''2024-01-02'', ''10:11:12.1234567'', ''2024-01-02 10:11:12.1234567'', ''2024-01-02 10:11:12.123'', ''2024-01-02 10:11:12.123'',
	 ''2024-01-02 10:11:12.1234567 +00:00'', ''6F9619FF-8B86-D011-B42D-00C04FC964FF'', 0x000102030405060708090A0B0C0D0E0F10111213),
	(2, 5, 0, -0.5, 0, -1.01, -5, 0, ''xyz'', N''мир'',
	 ''1999-12-31'', ''00:00:00'', ''1999-12-31 23:59:59.9999999'', ''1999-12-31 23:59:59.999'', ''1999-12-31 23:59:59.997'',
	 ''1999-12-31 23:59:59.9999999 +00:00'', ''00000000-0000-0000-0000-000000000000'', 0x01)');

# The values themselves, parameterised (the default).
query I
SELECT id FROM frp.dbo.frp_t WHERE dt7 = TIMESTAMP_NS '2024-01-02 10:11:12.1234567';
----
1

query I
SELECT id FROM frp.dbo.frp_t WHERE vb = '\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0A\x0B\x0C\x0D\x0E\x0F\x10\x11\x12\x13'::BLOB;
----
1

query I
SELECT id FROM frp.dbo.frp_t WHERE d10 = 12.34;
----
1

query I
SELECT id FROM frp.dbo.frp_t WHERE d38 = 99999999999999999999999999::HUGEINT;
----
1

query I
SELECT id FROM frp.dbo.frp_t WHERE nv = 'привет';
----
1

query I
SELECT id FROM frp.dbo.frp_t WHERE ti = 200;
----
1

query I
SELECT id FROM frp.dbo.frp_t WHERE g = '6F9619FF-8B86-D011-B42D-00C04FC964FF'::UUID;
----
1

query I
SELECT id FROM frp.dbo.frp_t WHERE dt7 > TIMESTAMP_NS '1999-12-31 23:59:59.9999998' AND dt7 < TIMESTAMP_NS '2000-01-01';
----
2

# Each answer equals the literal form's.
query I
SELECT id FROM frp.dbo.frp_t WHERE b = true AND f = 1.5 AND d10 < 100 AND vc = 'abc' AND dt = DATE '2024-01-02' AND dt3 = TIMESTAMP '2024-01-02 10:11:12.123';
----
1

statement ok
SET mssql_scan_parameterize_filters = false;

query I
SELECT id FROM frp.dbo.frp_t WHERE dt7 = TIMESTAMP_NS '2024-01-02 10:11:12.1234567';
----
1

query I
SELECT id FROM frp.dbo.frp_t WHERE b = true AND f = 1.5 AND d10 < 100 AND vc = 'abc' AND dt = DATE '2024-01-02' AND dt3 = TIMESTAMP '2024-01-02 10:11:12.123';
----
1

statement ok
RESET mssql_scan_parameterize_filters;

# Inside a transaction the RPC request carries the transaction descriptor.
statement ok
BEGIN;

query I
SELECT count(*) FROM frp.dbo.frp_t WHERE id > 0 AND d10 > -5;
----
2

statement ok
COMMIT;

statement ok
SELECT mssql_exec('frp', 'DROP TABLE dbo.frp_t');

statement ok
DETACH frp;

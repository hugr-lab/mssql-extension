# name: test/sql/catalog/case_only_column_names.test
# description: a case-sensitive database's columns that differ only in case are read as Id, ID_1, id_2 (issue #572)
# group: [catalog]
# issue: 572
#
# SQL Server allows columns `Id` and `ID` in one table of a case-sensitive database; DuckDB's names are
# case-insensitive, quoted or not, so a DuckDB table cannot hold both. The catalog reads such a column
# under the first suffix no column of the table is named (`ID_1`), and every statement the extension
# sends names the server's own column.
#
# Environment variables required:
#   MSSQL_TEST_DSN, MSSQL_TEST_HOST, MSSQL_TEST_PORT, MSSQL_TEST_USER, MSSQL_TEST_PASS

require mssql

require-env MSSQL_TEST_DSN

require-env MSSQL_TEST_HOST

require-env MSSQL_TEST_PORT

require-env MSSQL_TEST_USER

require-env MSSQL_TEST_PASS

statement ok
ATTACH '{MSSQL_TEST_DSN}' AS cs_master (TYPE mssql);

statement ok
SELECT mssql_exec('cs_master', 'IF DB_ID(''CaseOnlyCols'') IS NOT NULL BEGIN ALTER DATABASE CaseOnlyCols SET SINGLE_USER WITH ROLLBACK IMMEDIATE; DROP DATABASE CaseOnlyCols; END');

statement ok
SELECT mssql_exec('cs_master', 'CREATE DATABASE CaseOnlyCols COLLATE Latin1_General_100_CS_AS');

statement ok
ATTACH 'Server={MSSQL_TEST_HOST},{MSSQL_TEST_PORT};Database=CaseOnlyCols;User Id={MSSQL_TEST_USER};Password={MSSQL_TEST_PASS};TrustServerCertificate=yes' AS cs (TYPE mssql);

statement ok
SELECT mssql_exec('cs', 'CREATE TABLE dbo.t (Id int NOT NULL PRIMARY KEY, ID int NULL, id varchar(10) NULL, ID_1 int NULL)');

statement ok
SELECT mssql_exec('cs', 'INSERT INTO dbo.t VALUES (1, 10, ''a'', 100), (2, NULL, NULL, 200), (3, -3, ''ccc'', 300)');

query TT
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'cs' AND table_name = 't' ORDER BY column_index;
----
Id	INTEGER
ID_2	INTEGER
id_3	MSSQL_VARCHAR(10)
ID_1	INTEGER

query IIII
SELECT * FROM cs.dbo.t ORDER BY 1;
----
1	10	a	100
2	NULL	NULL	200
3	-3	ccc	300

# Filter, ORDER BY and TOP pushdown name the server's column.
query II
SELECT "Id", "ID_2" FROM cs.dbo.t WHERE "ID_2" > 0 ORDER BY "ID_2" DESC LIMIT 1;
----
1	10

query I
SELECT "Id" FROM cs.dbo.t WHERE id_3 = 'ccc';
----
3

# Remote pushdown (spec 079): the statement goes whole, its result columns named DuckDB's way.
query II
SELECT "ID_2" IS NULL AS missing, count(*) FROM cs.dbo.t GROUP BY ALL ORDER BY 1;
----
false	2
true	1

query IIII
SELECT * FROM cs.dbo.t ORDER BY "ID_1" DESC LIMIT 1;
----
3	-3	ccc	300

query I
SELECT count(*) FROM cs.dbo.t a JOIN cs.dbo.t b USING ("ID_2");
----
2

# Through a derived table and a set operation, the aliases carried out.
query II
SELECT "Id", "ID_2" FROM (SELECT "Id", "ID_2" FROM cs.dbo.t ORDER BY "Id" LIMIT 2) d ORDER BY "ID_2" NULLS LAST;
----
1	10
2	NULL

query I
SELECT sum("ID_2") FROM (SELECT "ID_2" FROM cs.dbo.t WHERE "Id" = 1 UNION ALL SELECT "ID_2" FROM cs.dbo.t WHERE "Id" = 3) u;
----
7

# An alias is measured as SQL Server measures an identifier, in characters: 60 CJK characters (180
# UTF-8 bytes) still push (review of #574).
query II
EXPLAIN SELECT "Id" AS "列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列" FROM cs.dbo.t ORDER BY "Id" LIMIT 1;
----
physical_plan	<REGEX>:.*SELECT TOP \(1\) \[Id\] AS \[列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列\].*

query I
SELECT "Id" AS "列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列列" FROM cs.dbo.t ORDER BY "Id" LIMIT 1;
----
1

# A raw scan's result columns too; an unnamed one named as DuckDB names it, an exact repeat named apart.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM mssql_scan('cs', 'SELECT 1, 2, Id, ID, ID FROM dbo.t'));
----
C0	INTEGER
C1	INTEGER
Id	INTEGER
ID_1	INTEGER
ID_2	INTEGER

# An unnamed column beside a real C0, and the query's own aliases, which a suffix avoids (review of #574).
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM mssql_scan('cs', 'SELECT 1, 2 AS C0'));
----
C0_1	INTEGER
C0	INTEGER

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM mssql_scan('cs', 'SELECT 1 AS x, 2 AS x') AS s(x_1));
----
x_1	INTEGER
x	INTEGER

# Only a name equal to an alias moves: every other keeps its own (s.x_1 still the second column).
query III
SELECT s.a, s.x_1, s.x_2 FROM mssql_scan('cs', 'SELECT 1 AS x, 2 AS x, 3 AS x') AS s(a);
----
1	2	3

query III
SELECT s.a, s.b, s.x_2 FROM mssql_scan('cs', 'SELECT 1 AS x, 2 AS x, 3 AS x') AS s(a, b);
----
1	2	3

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM mssql_scan('cs', 'SELECT * FROM dbo.t'));
----
Id	INTEGER
ID_2	INTEGER
id_3	MSSQL_VARCHAR(10)
ID_1	INTEGER

# DML: INSERT (statements and bulk), UPDATE and DELETE by the key, through the server's names.
statement ok
INSERT INTO cs.dbo.t ("Id", "ID_2", id_3, "ID_1") VALUES (4, 40, 'd', 400);

statement ok
INSERT INTO cs.dbo.t SELECT i, i * 10, 'b' || i, i * 100 FROM range(100, 1600) r(i);

statement ok
UPDATE cs.dbo.t SET "ID_2" = "ID_2" + 1, id_3 = 'u' WHERE "Id" = 4;

statement ok
DELETE FROM cs.dbo.t WHERE "Id" >= 100;

query IIII
SELECT * FROM mssql_scan('cs', 'SELECT Id, ID, id, ID_1 FROM dbo.t WHERE Id = 4');
----
4	41	u	400

# The row-by-row path (rowid VALUES join), the staged one (#stage) and RETURNING.
statement ok
SET mssql_dml_pushdown = false;

statement ok
UPDATE cs.dbo.t SET "ID_1" = 401 WHERE "Id" = 4;

statement ok
SET mssql_dml_stage_threshold = 0;

statement ok
UPDATE cs.dbo.t SET "ID_2" = "ID_2" WHERE "Id" <= 4;

query II
UPDATE cs.dbo.t SET id_3 = 'r' WHERE "Id" = 4 RETURNING "Id", "ID_2";
----
4	41

statement ok
RESET mssql_dml_stage_threshold;

statement ok
RESET mssql_dml_pushdown;

query I
SELECT "ID_1" FROM cs.dbo.t WHERE "Id" = 4;
----
401

# MERGE, pushed whole and staged.
statement ok
MERGE INTO cs.dbo.t USING (SELECT 4 AS k, 42 AS v) s ON "Id" = s.k WHEN MATCHED THEN UPDATE SET "ID_2" = s.v;

statement ok
SET mssql_dml_pushdown = false;

statement ok
MERGE INTO cs.dbo.t USING (SELECT 4 AS k, 'm' AS v) s ON "Id" = s.k WHEN MATCHED THEN UPDATE SET id_3 = s.v;

statement ok
RESET mssql_dml_pushdown;

query III
SELECT * FROM mssql_scan('cs', 'SELECT ID, id, ID_1 FROM dbo.t WHERE Id = 4');
----
42	m	401

# COPY into the existing table: a source column loads the column of its DuckDB name.
statement ok
COPY (SELECT 5 AS "Id", 50 AS "ID_2", 'e' AS id_3, 500 AS "ID_1") TO 'cs.dbo.t' (FORMAT bcp);

query IIII
SELECT * FROM mssql_scan('cs', 'SELECT Id, ID, id, ID_1 FROM dbo.t WHERE Id = 5');
----
5	50	e	500

# CTAS from it: the new table's columns are DuckDB's names.
statement ok
CREATE TABLE cs.dbo.t_copy AS SELECT * FROM cs.dbo.t WHERE "Id" <= 3;

query TT
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'cs' AND table_name = 't_copy' ORDER BY column_index;
----
Id	INTEGER
ID_2	INTEGER
id_3	MSSQL_VARCHAR(10)
ID_1	INTEGER

# A MERGE whose source is in the catalog goes whole (spec 080 PR 4a): t's "ID_1" is the server's ID_1,
# t_copy's columns are named as CTAS made them.
statement ok
MERGE INTO cs.dbo.t AS t USING cs.dbo.t_copy AS s ON t."Id" = s."Id" WHEN MATCHED THEN UPDATE SET "ID_1" = s."ID_1" + 1;

query II
SELECT * FROM mssql_scan('cs', 'SELECT Id, ID_1 FROM dbo.t WHERE Id <= 3 ORDER BY Id');
----
1	101
2	201
3	301

# ALTER names the server's column: "ID_2" is the server's ID.
statement ok
ALTER TABLE cs.dbo.t RENAME COLUMN "ID_2" TO "Extra";

query T
SELECT list(name ORDER BY column_id) FROM mssql_scan('cs', 'SELECT name, column_id FROM sys.columns WHERE object_id = OBJECT_ID(''dbo.t'')');
----
[Id, Extra, id, ID_1]

# A table with no key, keyed by every column (spec 080 D3 rung 3), and a composite key of Id and ID.
statement ok
SELECT mssql_exec('cs', 'CREATE TABLE dbo.k (a int NOT NULL, A int NOT NULL, v int NULL)');

statement ok
SELECT mssql_exec('cs', 'INSERT INTO dbo.k VALUES (1, 2, 3), (4, 5, 6)');

statement ok
SET mssql_dml_pushdown = false;

statement ok
UPDATE cs.dbo.k SET v = 30 WHERE "A_1" = 2;

query III
SELECT * FROM cs.dbo.k ORDER BY a;
----
1	2	30
4	5	6

statement ok
SELECT mssql_exec('cs', 'CREATE TABLE dbo.ck (Id int NOT NULL, ID int NOT NULL, v int NULL, PRIMARY KEY (Id, ID))');

statement ok
SELECT mssql_exec('cs', 'INSERT INTO dbo.ck VALUES (1, 1, 10), (1, 2, 20)');

query T
SELECT rowid::VARCHAR FROM cs.dbo.ck ORDER BY "ID_1";
----
{'Id': 1, 'ID_1': 1}
{'Id': 1, 'ID_1': 2}

statement ok
DELETE FROM cs.dbo.ck WHERE "ID_1" = 2;

statement ok
RESET mssql_dml_pushdown;

query III
SELECT * FROM cs.dbo.ck;
----
1	1	10

statement ok
DETACH cs;

statement ok
SELECT mssql_exec('cs_master', 'ALTER DATABASE CaseOnlyCols SET SINGLE_USER WITH ROLLBACK IMMEDIATE; DROP DATABASE CaseOnlyCols');

statement ok
DETACH cs_master;

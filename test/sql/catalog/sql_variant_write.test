SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS nvarchar(20)), ''('', CAST(SQL_VARIANT_PROPERTY(v, ''Precision'') AS nvarchar(5)), '','', CAST(SQL_VARIANT_PROPERTY(v, ''Scale'') AS nvarchar(5)), '')''), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_upd');

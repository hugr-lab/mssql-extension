# --- DuckDB's own values: the base type by the tag (D3's write table)
statement ok
SELECT mssql_exec('svw', 'DELETE FROM dbo.svw_stmt');

statement ok
INSERT INTO svw.dbo.svw_stmt VALUES (1, (-5)::TINYINT::VARIANT), (2, 65535::USMALLINT::VARIANT), (3, 4294967295::UINTEGER::VARIANT), (4, 18446744073709551615::UBIGINT::VARIANT), (5, TIMESTAMP_NS '2026-01-01 00:00:00.123456789'::VARIANT), (6, TIMESTAMPTZ '2026-01-01 10:00:00+05:30'::VARIANT), (7, 'x'::VARIANT), (8, NULL);

query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS nvarchar(20)), ''='', CONVERT(nvarchar(60), v, 121)), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_stmt');
----
1:smallint=-5 2:int=65535 3:bigint=4294967295 4:decimal=18446744073709551615 5:datetime2=2026-01-01 00:00:00.1234568 6:datetimeoffset=2026-01-01 04:30:00.000000 +00:00 7:nvarchar=x 8:=

# --- refused by name: the column and the tag
statement error
INSERT INTO svw.dbo.svw_stmt VALUES (20, [1, 2]::VARIANT);
----
ARRAY

statement error
INSERT INTO svw.dbo.svw_stmt VALUES (21, CAST('1 day' AS INTERVAL)::VARIANT);
----
INTERVAL

statement error
INSERT INTO svw.dbo.svw_stmt VALUES (22, 'NaN'::DOUBLE::VARIANT);
----
NaN

statement error
INSERT INTO svw.dbo.svw_stmt SELECT 23, repeat('é', 4001)::VARIANT;
----
4001 UTF-16 units

statement ok
SET mssql_insert_bcp_threshold = 1;

statement error
INSERT INTO svw.dbo.svw_stmt VALUES (24, 1::VARIANT), (25, [1, 2]::VARIANT);
----
ARRAY

statement ok
RESET mssql_insert_bcp_threshold;

# --- pushed whole (the default): the server copies each value as it is, its base type, precision,
# scale, length and collation unchanged -- no VARIANT is written
statement ok
RESET mssql_dml_pushdown;

statement ok
SELECT mssql_exec('svw', 'DROP TABLE IF EXISTS dbo.svw_push; CREATE TABLE dbo.svw_push (id int NOT NULL PRIMARY KEY, v sql_variant NULL)');

statement ok
SELECT mssql_invalidate_cache('svw');

statement ok
INSERT INTO svw.dbo.svw_push SELECT id, v FROM svw.dbo.svw_src;

query II
SELECT * FROM mssql_scan('svw', 'SELECT (SELECT COUNT(*) FROM dbo.svw_push), COUNT(*) FROM (SELECT id, CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS sysname) AS b, CAST(SQL_VARIANT_PROPERTY(v, ''Precision'') AS int) AS p, CAST(SQL_VARIANT_PROPERTY(v, ''Scale'') AS int) AS s, CAST(SQL_VARIANT_PROPERTY(v, ''MaxLength'') AS int) AS m, CAST(SQL_VARIANT_PROPERTY(v, ''Collation'') AS sysname) AS c FROM dbo.svw_src EXCEPT SELECT id, CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS sysname), CAST(SQL_VARIANT_PROPERTY(v, ''Precision'') AS int), CAST(SQL_VARIANT_PROPERTY(v, ''Scale'') AS int), CAST(SQL_VARIANT_PROPERTY(v, ''MaxLength'') AS int), CAST(SQL_VARIANT_PROPERTY(v, ''Collation'') AS sysname) FROM dbo.svw_push) x');
----
50	0

# --- real / float at their edges, on each path: FLT_MAX as real, 0.1, DBL_MAX, the least subnormal,
# -0.0. The bulk envelope carries the value's bits; the statement path's literal is the double in 17
# significant digits, which the server parses (CAST(v AS float) widens a real exactly, so one bit
# pattern -- big-endian -- shows each stored value).
statement ok
SELECT mssql_exec('svw', 'DROP TABLE IF EXISTS dbo.svw_flt_stmt; DROP TABLE IF EXISTS dbo.svw_flt_bulk; DROP TABLE IF EXISTS dbo.svw_flt_copy; DROP TABLE IF EXISTS dbo.svw_flt_ctas; DROP TABLE IF EXISTS dbo.svw_flt_plain_stmt; DROP TABLE IF EXISTS dbo.svw_flt_plain_bulk; CREATE TABLE dbo.svw_flt_stmt (id int NOT NULL PRIMARY KEY, v sql_variant NULL); CREATE TABLE dbo.svw_flt_bulk (id int NOT NULL PRIMARY KEY, v sql_variant NULL); CREATE TABLE dbo.svw_flt_copy (id int NOT NULL PRIMARY KEY, v sql_variant NULL); CREATE TABLE dbo.svw_flt_plain_stmt (id int NOT NULL PRIMARY KEY, f float NULL); CREATE TABLE dbo.svw_flt_plain_bulk (id int NOT NULL PRIMARY KEY, f float NULL)');

statement ok
SELECT mssql_invalidate_cache('svw');

statement ok
CREATE TEMP TABLE svw_flt AS SELECT * FROM (VALUES (1, '3.4028235e38'::FLOAT::VARIANT), (2, '0.1'::DOUBLE::VARIANT), (3, '1.7976931348623157e308'::DOUBLE::VARIANT), (4, '4.9406564584124654e-324'::DOUBLE::VARIANT), (5, '-0.0'::DOUBLE::VARIANT)) t(id, v);

statement ok
SET mssql_insert_bcp_threshold = 100000;

statement ok
INSERT INTO svw.dbo.svw_flt_stmt SELECT id, v FROM svw_flt;

statement ok
SET mssql_insert_bcp_threshold = 1;

statement ok
INSERT INTO svw.dbo.svw_flt_bulk SELECT id, v FROM svw_flt;

statement ok
RESET mssql_insert_bcp_threshold;

statement ok
COPY (SELECT id, v FROM svw_flt) TO 'mssql://svw/dbo/svw_flt_copy' (FORMAT 'bcp', CREATE_TABLE false);

statement ok
CREATE TABLE svw.dbo.svw_flt_ctas AS SELECT id, v FROM svw_flt;

# The statement path stores the least subnormal as 0 (measured on the integration server): the server's parse of
# the literal 4.9406564584124654E-324 flushes it to zero, while the bulk paths below keep its bits. No
# workaround (T-SQL converts no varbinary to float); native RPC parameters (#515) are what remove it.
query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS sysname), ''='', CONVERT(varchar(20), CONVERT(varbinary(8), CAST(v AS float)), 2)), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_flt_stmt');
----
1:real=47EFFFFFE0000000 2:float=3FB999999999999A 3:float=7FEFFFFFFFFFFFFF 4:float=0000000000000000 5:float=8000000000000000

query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS sysname), ''='', CONVERT(varchar(20), CONVERT(varbinary(8), CAST(v AS float)), 2)), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_flt_bulk');
----
1:real=47EFFFFFE0000000 2:float=3FB999999999999A 3:float=7FEFFFFFFFFFFFFF 4:float=0000000000000001 5:float=8000000000000000

query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS sysname), ''='', CONVERT(varchar(20), CONVERT(varbinary(8), CAST(v AS float)), 2)), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_flt_copy');
----
1:real=47EFFFFFE0000000 2:float=3FB999999999999A 3:float=7FEFFFFFFFFFFFFF 4:float=0000000000000001 5:float=8000000000000000

query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS sysname), ''='', CONVERT(varchar(20), CONVERT(varbinary(8), CAST(v AS float)), 2)), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_flt_ctas');
----
1:real=47EFFFFFE0000000 2:float=3FB999999999999A 3:float=7FEFFFFFFFFFFFFF 4:float=0000000000000001 5:float=8000000000000000

# A plain float column, not a sql_variant: its statement path's literal (FormatSqlLiteral, 17 digits:
# 4.9406564584124654e-324) meets the same parse, so the same subnormal is stored as 0 there too -- the
# behaviour of every float literal, not new with VARIANT --, and its bulk path keeps the bits. It also
# stores -0.0 as +0 (measured), the float codec's own behaviour before T2: RenderFloatLiteral writes
# -0.0 as `-0.0` (no exponent), which T-SQL types as a decimal literal, and a decimal has no negative
# zero. The VARIANT literal (`-0.0000000000000000E+00`, a float literal) keeps the sign (above).
statement ok
SET mssql_insert_bcp_threshold = 100000;

statement ok
INSERT INTO svw.dbo.svw_flt_plain_stmt VALUES (4, '4.9406564584124654e-324'::DOUBLE), (5, '-0.0'::DOUBLE);

statement ok
SET mssql_insert_bcp_threshold = 1;

statement ok
INSERT INTO svw.dbo.svw_flt_plain_bulk VALUES (4, '4.9406564584124654e-324'::DOUBLE), (5, '-0.0'::DOUBLE);

statement ok
RESET mssql_insert_bcp_threshold;

query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(t, id, ''='', CONVERT(varchar(20), CONVERT(varbinary(8), f), 2)), '' '') WITHIN GROUP (ORDER BY t, id) FROM (SELECT ''a_stmt'' AS t, id, f FROM dbo.svw_flt_plain_stmt UNION ALL SELECT ''b_bulk'', id, f FROM dbo.svw_flt_plain_bulk) x');
----
a_stmt4=0000000000000000 a_stmt5=0000000000000000 b_bulk4=0000000000000001 b_bulk5=8000000000000000

# Read back through DuckDB: the same values (-0.0 keeps its sign).
query IT
SELECT id, v::VARCHAR FROM svw.dbo.svw_flt_bulk ORDER BY id;
----
1	3.4028235e+38
2	0.1
3	1.7976931348623157e+308
4	5e-324
5	-0.0

statement ok
SELECT mssql_exec('svw', 'DROP TABLE IF EXISTS dbo.svw_src; DROP TABLE IF EXISTS dbo.svw_stmt; DROP TABLE IF EXISTS dbo.svw_bulk; DROP TABLE IF EXISTS dbo.svw_ctas; DROP TABLE IF EXISTS dbo.svw_copy; DROP TABLE IF EXISTS dbo.svw_upd; DROP TABLE IF EXISTS dbo.svw_push; DROP TABLE IF EXISTS dbo.svw_flt_stmt; DROP TABLE IF EXISTS dbo.svw_flt_bulk; DROP TABLE IF EXISTS dbo.svw_flt_copy; DROP TABLE IF EXISTS dbo.svw_flt_ctas; DROP TABLE IF EXISTS dbo.svw_flt_plain_stmt; DROP TABLE IF EXISTS dbo.svw_flt_plain_bulk');

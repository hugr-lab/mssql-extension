# --- UPDATE: the VALUES join (below the stage threshold), then the staged #stage (above it)
statement ok
SET mssql_dml_pushdown = false;

statement ok
UPDATE svw.dbo.svw_upd SET v = s.v FROM svw.dbo.svw_src s WHERE svw_upd.id = s.id AND s.id <= 25;

statement ok
SET mssql_dml_stage_threshold = 0;

statement ok
UPDATE svw.dbo.svw_upd SET v = s.v FROM svw.dbo.svw_src s WHERE svw_upd.id = s.id AND s.id > 25;

statement ok
RESET mssql_dml_stage_threshold;

query I
SELECT count(*) FROM ((SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_upd) UNION ALL (SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_upd EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src));
----
0


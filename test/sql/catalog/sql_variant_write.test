# name: test/sql/catalog/sql_variant_write.test
# description: Spec 093 T2 -- a VARIANT written into a sql_variant column, each value under the base type its tag says, on the statement path, the bulk wire, CTAS, COPY, UPDATE and MERGE
# group: [catalog]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# D3's write table: a VARIANT value is written as CAST(CAST(<literal> AS <base type>) AS sql_variant) on
# the statement path and as an SSVARIANT envelope on the bulk wire (S2), the base type the narrowest that
# holds every value of the tag. The source is S1's 50 values (sql_variant_read.test's table): each
# copied on every write path and read back equal -- the same VARIANT tag, the same text -- while its
# base type is D3's write table applied to the tag it read as (numeric -> decimal, money -> decimal(19,4),
# time(0-5) -> time(6), datetime2(1-5) -> (3) / (6), datetime / smalldatetime -> datetime2(6), a
# datetime2(7) / datetimeoffset(7) outside 1677-2262 -> (6), datetimeoffset(0-6) -> (6) at +00:00,
# binary -> varbinary, char / varchar / nchar -> nvarchar). A value sql_variant cannot hold is refused
# by name.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS svw (TYPE mssql);

# An INSERT ... SELECT within the catalog is pushed whole by default (spec 080 D5: the server copies the
# sql_variant itself, base type and all -- the last case below); off, the rows come through DuckDB and
# are written as VARIANTs, which is what this file tests.
statement ok
SET mssql_dml_pushdown = false;

statement ok
SELECT mssql_exec('svw', 'DROP TABLE IF EXISTS dbo.svw_src; CREATE TABLE dbo.svw_src (id int NOT NULL PRIMARY KEY, v sql_variant NULL); INSERT INTO dbo.svw_src VALUES  (1, CAST(CAST(1 AS bit) AS sql_variant)), (2, CAST(CAST(0 AS bit) AS sql_variant)),  (3, CAST(CAST(255 AS tinyint) AS sql_variant)), (4, CAST(CAST(-32768 AS smallint) AS sql_variant)),  (5, CAST(CAST(-2147483648 AS int) AS sql_variant)), (6, CAST(CAST(-9223372036854775808 AS bigint) AS sql_variant)),  (7, CAST(CAST(1.5 AS real) AS sql_variant)), (8, CAST(CAST(-1.25e300 AS float) AS sql_variant)),  (9, CAST(CAST(0.5 AS decimal(1,1)) AS sql_variant)), (10, CAST(CAST(-1234567.89 AS decimal(9,2)) AS sql_variant)),  (11, CAST(CAST(123456789012345678 AS decimal(18,0)) AS sql_variant)), (12, CAST(CAST(1234567890.123456789 AS decimal(19,9)) AS sql_variant)),  (13, CAST(CAST(-12345678901234567890.12345678 AS decimal(28,8)) AS sql_variant)), (14, CAST(CAST(99999999999999999999999999999999999999 AS decimal(38,0)) AS sql_variant)),  (15, CAST(CAST(-0.00000000000000000000000000000000000001 AS decimal(38,38)) AS sql_variant)), (16, CAST(CAST(12.5 AS numeric(10,3)) AS sql_variant)),  (17, CAST(CAST(-922337203685477.5808 AS money) AS sql_variant)), (18, CAST(CAST(214748.3647 AS smallmoney) AS sql_variant)),  (19, CAST(CAST(''0001-01-01'' AS date) AS sql_variant)), (20, CAST(CAST(''9999-12-31'' AS date) AS sql_variant)),  (21, CAST(CAST(''23:59:59'' AS time(0)) AS sql_variant)), (22, CAST(CAST(''10:00:00.123'' AS time(3)) AS sql_variant)),  (23, CAST(CAST(''10:00:00.123456'' AS time(6)) AS sql_variant)), (24, CAST(CAST(''10:00:00.1234567'' AS time(7)) AS sql_variant)),  (25, CAST(CAST(''2026-01-01 10:00:00'' AS datetime2(0)) AS sql_variant)), (26, CAST(CAST(''2026-01-01 10:00:00.123'' AS datetime2(3)) AS sql_variant)),  (27, CAST(CAST(''2026-01-01 10:00:00.123456'' AS datetime2(6)) AS sql_variant)), (28, CAST(CAST(''2026-01-01 10:00:00.1234567'' AS datetime2(7)) AS sql_variant)),  (29, CAST(CAST(''9999-12-31 23:59:59.9999999'' AS datetime2(7)) AS sql_variant)), (30, CAST(CAST(''0001-01-01 00:00:00'' AS datetime2(7)) AS sql_variant)),  (31, CAST(CAST(''2026-11-13 07:08:09.123'' AS datetime) AS sql_variant)), (32, CAST(CAST(''2026-11-13 07:08:00'' AS smalldatetime) AS sql_variant)),  (33, CAST(CAST(''2026-01-01 10:00:00 +14:00'' AS datetimeoffset(0)) AS sql_variant)), (34, CAST(CAST(''2026-01-01 10:00:00.123456 -14:00'' AS datetimeoffset(6)) AS sql_variant)),  (35, CAST(CAST(''2026-01-01 10:00:00.1234567 +05:30'' AS datetimeoffset(7)) AS sql_variant)), (36, CAST(CAST(''9999-12-31 23:59:59.9999999 +00:00'' AS datetimeoffset(7)) AS sql_variant)),  (37, CAST(CAST(''6F9619FF-8B86-D011-B42D-00C04FC964FF'' AS uniqueidentifier) AS sql_variant)), (38, CAST(CAST(0x0102 AS binary(4)) AS sql_variant)),  (39, CAST(CAST(0x010203 AS varbinary(10)) AS sql_variant)), (40, CAST(CAST(''ab'' AS char(5)) AS sql_variant)),  (41, CAST(CAST(''café'' COLLATE SQL_Latin1_General_CP1_CI_AS AS varchar(10)) AS sql_variant)),  (42, CAST(CAST(N''дом'' COLLATE Cyrillic_General_CI_AS AS varchar(10)) AS sql_variant)),  (43, CAST(CAST(N''漢字'' COLLATE Japanese_CI_AS AS varchar(10)) AS sql_variant)),  (44, CAST(CAST(N''😀é'' COLLATE Latin1_General_100_CI_AS_SC_UTF8 AS varchar(20)) AS sql_variant)),  (45, CAST(CAST(N''ab'' AS nchar(5)) AS sql_variant)), (46, CAST(CAST(N''😀x'' COLLATE Latin1_General_100_CI_AS_SC AS nvarchar(10)) AS sql_variant)),  (47, CAST(CAST(N''дом'' COLLATE Cyrillic_General_CI_AS AS char(6)) AS sql_variant)), (48, NULL),  (49, CAST(CAST('''' AS varchar(5)) AS sql_variant)), (50, CAST(CAST(0x AS varbinary(5)) AS sql_variant)); ');

statement ok
SELECT mssql_exec('svw', 'DROP TABLE IF EXISTS dbo.svw_stmt; DROP TABLE IF EXISTS dbo.svw_bulk; DROP TABLE IF EXISTS dbo.svw_ctas; DROP TABLE IF EXISTS dbo.svw_copy; DROP TABLE IF EXISTS dbo.svw_upd; CREATE TABLE dbo.svw_stmt (id int NOT NULL PRIMARY KEY, v sql_variant NULL); CREATE TABLE dbo.svw_bulk (id int NOT NULL PRIMARY KEY, v sql_variant NULL); CREATE TABLE dbo.svw_copy (id int NOT NULL PRIMARY KEY, v sql_variant NULL); CREATE TABLE dbo.svw_upd (id int NOT NULL PRIMARY KEY, v sql_variant NULL); INSERT INTO dbo.svw_upd SELECT id, NULL FROM dbo.svw_src');

statement ok
SELECT mssql_invalidate_cache('svw');

# --- the statement path (below the bulk threshold): one multi-row VALUES, the rows of many base types
statement ok
SET mssql_insert_bcp_threshold = 100000;

statement ok
INSERT INTO svw.dbo.svw_stmt SELECT id, v FROM svw.dbo.svw_src;

query I
SELECT count(*) FROM ((SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_stmt) UNION ALL (SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_stmt EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src));
----
0

query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS nvarchar(20)), ''('', CAST(SQL_VARIANT_PROPERTY(v, ''Precision'') AS nvarchar(5)), '','', CAST(SQL_VARIANT_PROPERTY(v, ''Scale'') AS nvarchar(5)), '')''), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_stmt');
----
1:bit(1,0) 2:bit(1,0) 3:tinyint(3,0) 4:smallint(5,0) 5:int(10,0) 6:bigint(19,0) 7:real(24,0) 8:float(53,0) 9:decimal(1,1) 10:decimal(9,2) 11:decimal(18,0) 12:decimal(19,9) 13:decimal(28,8) 14:decimal(38,0) 15:decimal(38,38) 16:decimal(10,3) 17:decimal(19,4) 18:decimal(10,4) 19:date(10,0) 20:date(10,0) 21:time(15,6) 22:time(15,6) 23:time(15,6) 24:time(16,7) 25:datetime2(19,0) 26:datetime2(23,3) 27:datetime2(26,6) 28:datetime2(27,7) 29:datetime2(26,6) 30:datetime2(26,6) 31:datetime2(26,6) 32:datetime2(26,6) 33:datetimeoffset(33,6) 34:datetimeoffset(33,6) 35:datetimeoffset(34,7) 36:datetimeoffset(33,6) 37:uniqueidentifier(0,0) 38:varbinary(0,0) 39:varbinary(0,0) 40:nvarchar(0,0) 41:nvarchar(0,0) 42:nvarchar(0,0) 43:nvarchar(0,0) 44:nvarchar(0,0) 45:nvarchar(0,0) 46:nvarchar(0,0) 47:nvarchar(0,0) 48:(,) 49:nvarchar(0,0) 50:varbinary(0,0)

# --- the bulk wire: SSVARIANT envelopes (the threshold is the rows up to which statements are used: 1
# sends any INSERT of two rows or more in bulk)
statement ok
SET mssql_insert_bcp_threshold = 1;

statement ok
INSERT INTO svw.dbo.svw_bulk SELECT id, v FROM svw.dbo.svw_src;

statement ok
RESET mssql_insert_bcp_threshold;

query I
SELECT count(*) FROM ((SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_bulk) UNION ALL (SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_bulk EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src));
----
0

query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS nvarchar(20)), ''('', CAST(SQL_VARIANT_PROPERTY(v, ''Precision'') AS nvarchar(5)), '','', CAST(SQL_VARIANT_PROPERTY(v, ''Scale'') AS nvarchar(5)), '')''), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_bulk');
----
1:bit(1,0) 2:bit(1,0) 3:tinyint(3,0) 4:smallint(5,0) 5:int(10,0) 6:bigint(19,0) 7:real(24,0) 8:float(53,0) 9:decimal(1,1) 10:decimal(9,2) 11:decimal(18,0) 12:decimal(19,9) 13:decimal(28,8) 14:decimal(38,0) 15:decimal(38,38) 16:decimal(10,3) 17:decimal(19,4) 18:decimal(10,4) 19:date(10,0) 20:date(10,0) 21:time(15,6) 22:time(15,6) 23:time(15,6) 24:time(16,7) 25:datetime2(19,0) 26:datetime2(23,3) 27:datetime2(26,6) 28:datetime2(27,7) 29:datetime2(26,6) 30:datetime2(26,6) 31:datetime2(26,6) 32:datetime2(26,6) 33:datetimeoffset(33,6) 34:datetimeoffset(33,6) 35:datetimeoffset(34,7) 36:datetimeoffset(33,6) 37:uniqueidentifier(0,0) 38:varbinary(0,0) 39:varbinary(0,0) 40:nvarchar(0,0) 41:nvarchar(0,0) 42:nvarchar(0,0) 43:nvarchar(0,0) 44:nvarchar(0,0) 45:nvarchar(0,0) 46:nvarchar(0,0) 47:nvarchar(0,0) 48:(,) 49:nvarchar(0,0) 50:varbinary(0,0)

# --- CTAS creates a sql_variant column
statement ok
CREATE TABLE svw.dbo.svw_ctas AS SELECT id, v FROM svw.dbo.svw_src;

query T
SELECT * FROM mssql_scan('svw', 'SELECT TYPE_NAME(system_type_id) FROM sys.columns WHERE object_id = OBJECT_ID(''dbo.svw_ctas'') AND name = ''v''');
----
sql_variant

query I
SELECT count(*) FROM ((SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_ctas) UNION ALL (SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_ctas EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src));
----
0

query T
SELECT * FROM mssql_scan('svw', 'SELECT STRING_AGG(CONCAT(id, '':'', CAST(SQL_VARIANT_PROPERTY(v, ''BaseType'') AS nvarchar(20)), ''('', CAST(SQL_VARIANT_PROPERTY(v, ''Precision'') AS nvarchar(5)), '','', CAST(SQL_VARIANT_PROPERTY(v, ''Scale'') AS nvarchar(5)), '')''), '' '') WITHIN GROUP (ORDER BY id) FROM dbo.svw_ctas');

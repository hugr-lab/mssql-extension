# --- COPY into an existing sql_variant column
statement ok
COPY (SELECT id, v FROM svw.dbo.svw_src) TO 'mssql://svw/dbo/svw_copy' (FORMAT 'bcp', CREATE_TABLE false);

query I
SELECT count(*) FROM ((SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_copy) UNION ALL (SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_copy EXCEPT ALL SELECT id, variant_typeof(v), v::VARCHAR FROM svw.dbo.svw_src));

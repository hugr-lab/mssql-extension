# name: test/sql/catalog/filter_arithmetic_types.test
# description: The scan's filter pushdown sends + - * only where the server computes what DuckDB does (spec 079 C, from PR D's full review)
# group: [catalog]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# The filter encoder and the remote-pushdown writer share one vocabulary
# (ExpressionVocabulary::FunctionFor). Three shapes it used to send, each a
# different answer from DuckDB's:
#   - `date + 1`: a date in DuckDB, error 206 on the server (T-SQL's `+`
#     refuses a date and an int);
#   - a double product: inf in DuckDB, error 8115 on the server near 1e154;
#   - a decimal product DuckDB types as DECIMAL(18): DuckDB overflows first,
#     where the server returned rows.
# Each now stays with DuckDB, which answers as it does locally.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS fat (TYPE mssql);

statement ok
SELECT mssql_exec('fat', 'DROP TABLE IF EXISTS dbo.fat_t;
	CREATE TABLE dbo.fat_t (id int NOT NULL, dt date NULL, f float NULL, v decimal(10,2) NULL, s decimal(5,2) NULL);
	INSERT INTO dbo.fat_t VALUES (1, ''2024-05-01'', 1e200, 99999999.99, 999.99), (2, ''2024-01-01'', 2.0, 1.50, 1.50)');

query I
SELECT id FROM fat.dbo.fat_t WHERE dt + 1 > DATE '2024-05-01' ORDER BY id;
----
1

query I
SELECT id FROM fat.dbo.fat_t WHERE f * f > f ORDER BY id;
----
1
2

statement error
SELECT id FROM fat.dbo.fat_t WHERE v * v > 1 ORDER BY id;
----
Overflow in multiplication of DECIMAL(18)

# A product DuckDB types exactly (5 + 5 digits) is still pushed.
query I
SELECT id FROM fat.dbo.fat_t WHERE s * s > 100 ORDER BY id;
----
1

# + and - stay pushed over EXACT numbers.
query I
SELECT id FROM fat.dbo.fat_t WHERE id + 1 > 2 ORDER BY id;
----
2

# Not over a float: SQL Server cannot represent Inf, so an overflow is an error
# where DuckDB gives inf -- the product's divergence, at the narrower window
# `+` and `-` need (~1.8e308 rather than ~1e154). DuckDB evaluates it, so the
# rows are the same, which is the point of leaving it there.
query I
SELECT id FROM fat.dbo.fat_t WHERE f + f > 3 ORDER BY id;
----
1
2

# roborev 1821 finding 3: the float case above cannot detect a regression on its
# own -- 1e200 + 1e200 and 2.0 + 2.0 are both representable, so the rows are the
# same whether the predicate is pushed or DuckDB evaluates it. A value whose
# double is NOT representable separates them: DuckDB gives inf (and `inf > 3` is
# true, so the row comes back), while the server, which has no Inf, raises
# arithmetic overflow and the whole statement would fail. So a returned row
# PROVES the predicate stayed with DuckDB.
statement ok
SELECT mssql_exec('fat', 'DROP TABLE IF EXISTS dbo.fat_hi;
	CREATE TABLE dbo.fat_hi (id int NOT NULL, f float NULL);
	INSERT INTO dbo.fat_hi VALUES (1, 1e308)');

query I
SELECT id FROM fat.dbo.fat_hi WHERE f + f > 3 ORDER BY id;
----
1

query I
SELECT id FROM fat.dbo.fat_hi WHERE f * f > 3 ORDER BY id;
----
1

statement ok
SELECT mssql_exec('fat', 'DROP TABLE dbo.fat_hi');

# roborev 1821 finding 2: nothing exercised the `%` / error_on_division_by_zero
# gate end to end -- the unit test covers the vocabulary, but nothing would fail
# if the setting stopped being read on the way to the encoder. With the setting
# off DuckDB answers NULL for `a % 0` and simply omits the row; the server
# answers error 8134, and a pushed predicate is erased from the DuckDB plan, so
# the statement would fail instead. Rows coming back is the proof the `%` stayed
# local.
statement ok
SELECT mssql_exec('fat', 'DROP TABLE IF EXISTS dbo.fat_mod;
	CREATE TABLE dbo.fat_mod (id int NOT NULL, a int NULL, b int NULL);
	INSERT INTO dbo.fat_mod VALUES (1, 10, 0), (2, 10, 5)');

statement ok
SET error_on_division_by_zero = false;

query I
SELECT id FROM fat.dbo.fat_mod WHERE a % b = 0 ORDER BY id;
----
2

statement ok
RESET error_on_division_by_zero;

# With the setting at its default the gate does not apply and `%` is pushed
# again, which is the other half of the contract.
query I
SELECT id FROM fat.dbo.fat_mod WHERE b <> 0 AND a % b = 0 ORDER BY id;
----
2

statement ok
SELECT mssql_exec('fat', 'DROP TABLE dbo.fat_mod');

statement ok
SELECT mssql_exec('fat', 'DROP TABLE dbo.fat_t');

statement ok
DETACH fat;

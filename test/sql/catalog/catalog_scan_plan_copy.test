# name: test/sql/catalog/catalog_scan_plan_copy.test
# description: A plan holding a catalog scan can be copied -- CTE inlining copies a CTE used more than once under a LIMIT, and the copy finds mssql_catalog_scan by name
# group: [catalog]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# The copy (LogicalOperator::Copy) serializes and deserializes the plan, and
# deserializing a LogicalGet looks its table function up in the catalog by
# name. mssql_catalog_scan was not registered there: "Table Function with
# name mssql_catalog_scan does not exist!". The bind data is rebuilt from the
# live catalog entry, the pushed filter's parameters included.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS cpc (TYPE mssql);

statement ok
SELECT mssql_exec('cpc', 'DROP TABLE IF EXISTS dbo.cpc_t; CREATE TABLE dbo.cpc_t (id int NOT NULL PRIMARY KEY, k int NULL);
	INSERT dbo.cpc_t VALUES (1, 1), (2, 2), (3, 3)');

query II
WITH c AS (SELECT id, k FROM cpc.dbo.cpc_t) SELECT x.id, y.id FROM c x, c y ORDER BY 1, 2 LIMIT 3;
----
1	1
1	2
1	3

# A filter the scan pushes, with its parameter: rebuilt in the copy.
query II
WITH c AS (SELECT id, k FROM cpc.dbo.cpc_t WHERE k > 1) SELECT x.id, y.k FROM c x JOIN c y ON x.id = y.id ORDER BY 1 LIMIT 5;
----
2	2
3	3

# Called by name it has no table to scan.
statement error
SELECT * FROM mssql_catalog_scan();
----
mssql_catalog_scan is internal

statement ok
SELECT mssql_exec('cpc', 'DROP TABLE dbo.cpc_t');

statement ok
DETACH cpc;

# name: test/sql/catalog/filter_shapes_both_paths.test
# description: every filter shape agrees with the same predicate run client-side (spec 069 cluster G2)
# group: [catalog]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database

require mssql

require-env MSSQL_TESTDB_DSN

# =============================================================================
# Filter pushdown is best-effort, and DuckDB 2.0 changed what a refusal costs.
#
# On 1.5.x DuckDB re-checked every TableFilter above a filter_pushdown scan, so
# a filter FilterEncoder declined to translate was a performance problem and nothing
# more. 2.0 does NOT re-check: a filter the scan neither pushes nor applies is
# simply never applied and the query returns a SUPERSET -- a wrong answer. The
# scan therefore arms refused filters as client-side expressions
# (`unhandled` -> ClientTableFilter -> ExpressionExecutor::SelectExpression).
#
# filter_client_net.test pins that net through `rowid`, the one shape that
# reaches it unconditionally. This file is the other half: a DIFFERENTIAL over
# the whole filter vocabulary, with no knowledge of which shapes are pushed and
# which are refused.
#
#   fs_target  -- the catalog scan: `filter_pushdown = true`, so DuckDB hands it
#                 the predicate and trusts the answer.
#   fs_oracle  -- the same rows through mssql_scan(), which declares no
#                 pushdown at all, so DuckDB evaluates the predicate itself.
#
# Both must return the same rows for every predicate. Each shape asserts three
# numbers: the oracle count, the target count, and the size of the symmetric
# difference between the two row sets. The counts are pinned as literals (and
# none is 0 or the whole table) so that two paths agreeing on the WRONG rows --
# or on no rows -- still fails; the difference catches value-level divergence
# the counts would miss.
#
# The point of the differential form is that it extends itself: a filter class
# a later duckdb pin introduces (2.0's filter combiner already emits
# ExpressionFilter with BoundReference(0)) arrives in these predicates without
# anyone adding a case, and if the encoder refuses it without netting it, the
# difference stops being 0.
#
# Deliberately NOT covered here:
#   - the remote-pushdown writer. The catalog is attached with
#     `remote_pushdown false`, because a pushed SELECT is a different layer with
#     its own files (test/sql/pushdown/*) -- and because the EXCEPT ALL below is
#     exactly the set operation whose children the rewriter would push, which
#     would quietly replace the thing under test. A bare filtered SELECT is not
#     pushed by the writer anyway (SQLWriter::PushesMoreThanScan).
#   - case, accent and trailing-space variants of the string values. A pushed
#     string predicate is evaluated by the SERVER, under the column's collation
#     (CI_AS here), and a client-side one by DuckDB, which is case- and
#     accent-sensitive and does not pad. The two paths legitimately disagree
#     there; that divergence is pinned on its own at the end of this file
#     rather than smeared over every string shape.
#   - native type annotations: `mssql_catalog_native_types = false` keeps both
#     sides at plain VARCHAR, so a set operation compares rows and not type
#     aliases.
# =============================================================================

statement ok
SET mssql_catalog_native_types = false;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS fsa (TYPE mssql, remote_pushdown false);

statement ok
SELECT mssql_exec('fsa', 'IF OBJECT_ID(''dbo.FilterShapeAgree'',''U'') IS NOT NULL DROP TABLE dbo.FilterShapeAgree');

statement ok
SELECT mssql_exec('fsa', 'CREATE TABLE dbo.FilterShapeAgree (id INT NOT NULL PRIMARY KEY, i INT NULL, n DECIMAL(10,2) NULL, s VARCHAR(32) NULL, ns NVARCHAR(32) NULL, d DATE NULL, dt DATETIME2(3) NULL, b BIT NULL)');

# NULLs in every nullable column (row 3), a negative value, a zero, a literal
# `%` and `_` inside the string values (so a LIKE wildcard and an escaped
# wildcard differ), non-ASCII in the nvarchar column, a leap day, and
# millisecond-precision timestamps on both sides of a second boundary.
statement ok
INSERT INTO fsa.dbo.FilterShapeAgree VALUES
  (1,     7,  10.50, 'alpha',  'naïve', DATE '2024-03-01', TIMESTAMP '2024-03-01 12:00:00.123', true),
  (2,    13,   3.25, 'beta',   'bêta',  DATE '2024-01-15', TIMESTAMP '2024-01-15 00:00:00.000', false),
  (3,  NULL,   NULL, NULL,     NULL,    NULL,              NULL,                                NULL),
  (4,     7,  10.50, 'alpaca', 'nano',  DATE '2024-03-01', TIMESTAMP '2024-03-01 12:00:00.123', true),
  (5,    -5,  -1.75, 'a_pha',  'na%ve', DATE '2023-12-31', TIMESTAMP '2023-12-31 23:59:59.999', false),
  (6,    20, 100.00, '50%off', 'fifty', DATE '2024-06-01', TIMESTAMP '2024-06-01 00:00:00.000', true),
  (7,    21,   0.00, 'omega',  'omega', DATE '2024-05-31', TIMESTAMP '2024-05-31 11:59:59.999', NULL),
  (8,     6,  99.99, 'gamma',  'gämma', DATE '2024-02-29', TIMESTAMP '2024-02-29 06:30:00.500', false),
  (9,  NULL,  55.55, 'delta',  NULL,    DATE '2024-04-01', TIMESTAMP '2024-04-01 00:00:00.001', true),
  (10,   13,   3.25, 'bota',   'bota',  DATE '2024-01-16', TIMESTAMP '2024-01-16 00:00:00.000', false);

statement ok
CREATE VIEW fs_target AS SELECT id, i, n, s, ns, d, dt, b FROM fsa.dbo.FilterShapeAgree;

statement ok
CREATE VIEW fs_oracle AS SELECT * FROM mssql_scan('fsa', 'SELECT id, i, n, s, ns, d, dt, b FROM dbo.FilterShapeAgree');

# The two views agree with no predicate at all. This is the confound check: a
# type, collation or encoding difference between the paths would fail here, so
# every failure below is about the FILTER and not about the rows.
query III
SELECT (SELECT count(*) FROM fs_oracle),
       (SELECT count(*) FROM fs_target),
       (SELECT count(*) FROM ((SELECT * FROM fs_target EXCEPT ALL SELECT * FROM fs_oracle)
                              UNION ALL
                              (SELECT * FROM fs_oracle EXCEPT ALL SELECT * FROM fs_target)));
----
10	10	0

# equality on a nullable integer: i = 7
query III
SELECT (SELECT count(*) FROM fs_oracle WHERE i = 7),
       (SELECT count(*) FROM fs_target WHERE i = 7),
       (SELECT count(*) FROM (((SELECT * FROM fs_target WHERE i = 7) EXCEPT ALL (SELECT * FROM fs_oracle WHERE i = 7))
                              UNION ALL
                              ((SELECT * FROM fs_oracle WHERE i = 7) EXCEPT ALL (SELECT * FROM fs_target WHERE i = 7))));
----
2	2	0

# inequality: i <> 7
query III
SELECT (SELECT count(*) FROM fs_oracle WHERE i <> 7),
       (SELECT count(*) FROM fs_target WHERE i <> 7),
       (SELECT count(*) FROM (((SELECT * FROM fs_target WHERE i <> 7) EXCEPT ALL (SELECT * FROM fs_oracle WHERE i <> 7))
                              UNION ALL
                              ((SELECT * FROM fs_oracle WHERE i <> 7) EXCEPT ALL (SELECT * FROM fs_target WHERE i <> 7))));
----
6	6	0


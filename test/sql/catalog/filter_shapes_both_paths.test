                              UNION ALL
                              ((SELECT * FROM fs_oracle WHERE n > 50) EXCEPT ALL (SELECT * FROM fs_target WHERE n > 50))));
----
3	3	0

# =============================================================================
# The known divergence, pinned rather than hidden.
#
# A pushed string predicate is evaluated by SQL Server under the COLUMN's
# collation. TestDB's is SQL_Latin1_General_CP1_CI_AS -- case-insensitive,
# accent-sensitive, and it pads the shorter operand of a comparison. DuckDB is
# case-sensitive and pads nothing. So for a value that differs from the
# constant only in case, or only in trailing spaces, the catalog scan and the
# same predicate run client-side return DIFFERENT rows, and the counts below
# differ on purpose.
#
# This is the same reason CLAUDE.md gives for pushing no string FUNCTION
# (`upper(x) = 'ẞ'` lost rows); plain `=` and LIKE are pushed, so the
# collation reaches the answer. Measured on this server: `s = 'alpha'` -> 2 rows
# pushed vs 1 client-side, `s LIKE 'al%'` -> 3 vs 2, `s = 'alpha  '` -> 2 vs 0.
#
# Nothing here asserts that the divergence is CORRECT. It is recorded so that a
# change in it is deliberate: if pushdown of string comparisons is ever made
# collation-aware, these three pairs move and this is the file that says so.
# =============================================================================

statement ok
INSERT INTO fsa.dbo.FilterShapeAgree VALUES
  (11, 99, 1.00, 'ALPHA', 'ALPHA', DATE '2024-07-01', TIMESTAMP '2024-07-01 00:00:00.000', true);

# Case: the server matches 'ALPHA' as well, DuckDB does not.
query II
SELECT (SELECT count(*) FROM fs_target WHERE s = 'alpha'),
       (SELECT count(*) FROM fs_oracle WHERE s = 'alpha');
----
2	1

query II
SELECT (SELECT count(*) FROM fs_target WHERE s LIKE 'al%'),
       (SELECT count(*) FROM fs_oracle WHERE s LIKE 'al%');
----
3	2

# Trailing spaces: the server pads the constant to the column width, DuckDB
# compares the bytes.
query II
SELECT (SELECT count(*) FROM fs_target WHERE s = 'alpha  '),
       (SELECT count(*) FROM fs_oracle WHERE s = 'alpha  ');
----
2	0

statement ok
DROP VIEW fs_oracle;

statement ok
DROP VIEW fs_target;

statement ok
SELECT mssql_exec('fsa', 'DROP TABLE dbo.FilterShapeAgree');

statement ok
DETACH fsa;

query I
SELECT list(id ORDER BY id) FROM dtq.dbo.TruncTime WHERE o7 BETWEEN TIMESTAMPTZ '2026-01-01 10:00:00.123456+00' AND TIMESTAMPTZ '2026-01-01 10:00:00.123457+00';
----
[1, 2, 3]

statement ok
RESET mssql_scan_parameterize_filters;

# =============================================================================
# Against another column of the family: evaluated by DuckDB. t7b holds other
# time(7) values, o6 the datetimeoffset(6) of what DuckDB reads from o7.
# =============================================================================

query I
SELECT list(id ORDER BY id) FROM dtq.dbo.TruncTime WHERE t7 = t7b;
----
[1, 2]

query I
SELECT list(id ORDER BY id) FROM dtq.dbo.TruncTime WHERE t7 < t7b;
----
[3, 4, 6]

query I
SELECT list(id ORDER BY id) FROM dtq.dbo.TruncTime WHERE o7 = o6;
----
[1, 2, 3, 4, 5, 6]

query I
SELECT list(id ORDER BY id) FROM dtq.dbo.TruncTime WHERE o7 > o6;
----
NULL

query I
SELECT list(id ORDER BY id) FROM dtq.dbo.TruncTime WHERE TIME '10:00:00.123456' IN (t7, t7b);
----
[1, 2, 3, 6]

statement ok
SELECT mssql_exec('dtq', 'DROP TABLE dbo.TruncTime');

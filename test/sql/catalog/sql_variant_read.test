# column_types and mssql_scan_unsafe take VARIANT too
query IT
SELECT id, variant_typeof(v) FROM mssql_scan('sv', 'SELECT id, v FROM dbo.sv_read WHERE id IN (5, 24, 48)', column_types := ['', 'VARIANT']) ORDER BY id;
----
5	INT32
24	TIME_NANOS
48	VARIANT_NULL

query IT
SELECT id, variant_typeof(v) FROM mssql_scan_unsafe('sv', 'SELECT id, v FROM dbo.sv_read WHERE id IN (5, 24)', columns := {'id': 'INTEGER', 'v': 'VARIANT'}) ORDER BY id;
----
5	INT32
24	TIME_NANOS

# A query pushed to the server whole (spec 079) reads the column as the catalog does
query IT
SELECT id, variant_typeof(v) FROM sv.dbo.sv_read ORDER BY id LIMIT 3;
----
1	BOOL_TRUE
2	BOOL_FALSE
3	UINT8

query II
EXPLAIN SELECT id, v FROM sv.dbo.sv_read ORDER BY id LIMIT 3;
----
physical_plan	<REGEX>:.*Mssql Scan Unsafe.*SELECT TOP \(3\).*Shape: given.*

# In a transaction the scan is materialised at init (ColumnDataCollection): the VARIANTs too
statement ok
BEGIN;

query IT
SELECT id, v::VARCHAR FROM sv.dbo.sv_read WHERE id IN (24, 42, 37) ORDER BY id;
----
24	10:00:00.1234567
37	6f9619ff-8b86-d011-b42d-00c04fc964ff
42	дом

statement ok
COMMIT;

# More than one chunk: the vector is rebuilt chunk after chunk
statement ok
SELECT mssql_exec('sv', 'DROP TABLE IF EXISTS dbo.sv_many; CREATE TABLE dbo.sv_many (id int PRIMARY KEY, v sql_variant NULL); WITH n AS (SELECT TOP (5000) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS i FROM sys.all_objects a CROSS JOIN sys.all_objects b) INSERT dbo.sv_many SELECT i, CASE i % 4 WHEN 0 THEN CAST(i AS sql_variant) WHEN 1 THEN CAST(CAST(i AS nvarchar(10)) AS sql_variant) WHEN 2 THEN CAST(CAST(i AS decimal(9,2)) AS sql_variant) ELSE NULL END FROM n');

statement ok
SELECT mssql_invalidate_cache('sv');

query IIIII
SELECT count(*), count(v), count(*) FILTER (WHERE variant_typeof(v) = 'INT64'), count(*) FILTER (WHERE variant_typeof(v) = 'VARCHAR'), sum(v::DECIMAL(18,2)) FILTER (WHERE variant_typeof(v) = 'DECIMAL(9, 2)') FROM sv.dbo.sv_many;
----
5000	3750	1250	1250	3125000.00

# The per-value path (a composite key's rowid is read row by row): the same VARIANTs
statement ok
SELECT mssql_exec('sv', 'DROP TABLE IF EXISTS dbo.sv_ck; CREATE TABLE dbo.sv_ck (a int NOT NULL, b int NOT NULL, v sql_variant NULL, PRIMARY KEY (a, b)); INSERT dbo.sv_ck VALUES (1, 1, CAST(CAST(''10:00:00.1234567'' AS time(7)) AS sql_variant)); INSERT dbo.sv_ck VALUES (1, 2, CAST(N''дом'' AS nvarchar(5))); INSERT dbo.sv_ck VALUES (2, 1, NULL)');

statement ok
SELECT mssql_invalidate_cache('sv');

query TTT
SELECT rowid::VARCHAR, variant_typeof(v), v::VARCHAR FROM sv.dbo.sv_ck ORDER BY a, b;
----
{'a': 1, 'b': 1}	TIME_NANOS	10:00:00.1234567
{'a': 1, 'b': 2}	VARCHAR	дом
{'a': 2, 'b': 1}	VARIANT_NULL	NULL

# A varchar under a UTF-8 collation whose bytes are not UTF-8, or under a collation this build has no
# code page for, is read as its bytes with a WARNING; a server sends neither (it converts what it
# stores: CAST(0x61FF AS varchar) COLLATE a _UTF8 collation reads back as 'aÿ'), so the C++ test
# (test_variant_envelope) and fuzz_variant_envelope cover them.

# =============================================================================
# Filters run in DuckDB, over the VARIANT (#514)
# =============================================================================

statement ok
SELECT mssql_exec('sv', 'DROP TABLE IF EXISTS dbo.sv_eq; CREATE TABLE dbo.sv_eq (id int PRIMARY KEY, v sql_variant NULL); INSERT dbo.sv_eq VALUES (1, CAST(5 AS int)); INSERT dbo.sv_eq VALUES (2, CAST(N''5'' AS nvarchar(10))); INSERT dbo.sv_eq VALUES (3, NULL)');

statement ok
SELECT mssql_invalidate_cache('sv');

query III
SELECT (SELECT list(id) FROM sv.dbo.sv_eq WHERE v = 5), (SELECT list(id) FROM sv.dbo.sv_eq WHERE v = '5'), (SELECT list(id) FROM sv.dbo.sv_eq WHERE v IS NULL);
----
[1]	[2]	[3]

# =============================================================================
# Writes: spec 093 T2
# =============================================================================

statement error
INSERT INTO sv.dbo.sv_eq VALUES (10, 7::VARIANT);
----
a VARIANT value cannot be written to SQL Server yet

# A NULL and a value set from an empty nvarchar on the server: no VARIANT to write
statement ok
INSERT INTO sv.dbo.sv_eq VALUES (4, NULL);

statement ok
SELECT mssql_exec('sv', 'INSERT dbo.sv_eq VALUES (5, CAST(N'''' AS nvarchar(5)))');

statement error
CREATE TABLE sv.dbo.sv_ctas AS SELECT * FROM sv.dbo.sv_eq;
----
a VARIANT value cannot be written to SQL Server yet

statement error
UPDATE sv.dbo.sv_eq SET v = 9::VARIANT WHERE id = 1;
----
a VARIANT value cannot be written to SQL Server yet

# A row path that leaves the column alone is not affected
statement ok
SET mssql_dml_pushdown = false;

statement ok
SELECT mssql_exec('sv', 'ALTER TABLE dbo.sv_eq ADD n int NULL');

statement ok
SELECT mssql_invalidate_cache('sv');

statement ok
UPDATE sv.dbo.sv_eq SET n = 1 WHERE id = 1;

statement ok
RESET mssql_dml_pushdown;

query IIT
SELECT id, n, v::VARCHAR FROM sv.dbo.sv_eq ORDER BY id;
----
1	1	5
2	NULL	5
3	NULL	NULL
4	NULL	NULL
5	NULL	(empty)

statement ok
SELECT mssql_exec('sv', 'DROP TABLE dbo.sv_read; DROP TABLE dbo.sv_eq; DROP TABLE dbo.sv_many; DROP TABLE dbo.sv_ck');

statement ok
DETACH sv;

# name: test/sql/catalog/sql_variant_read.test
# description: a sql_variant column reads every base type whole, and a filter on it runs in DuckDB
# group: [catalog]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# Issue #354, until sql_variant is decoded on the wire: the column is still text, but each value is
# converted by the style that keeps its base type whole, where the plain cast (style 0) cut a
# datetime2 to the minute, a float to six digits, a money to two decimals, and read a varbinary's
# bytes as UTF-16.
#
# Issue #514: a filter on the column was pushed against the raw sql_variant, which SQL Server
# compares by its base type: WHERE v = '5' found the nvarchar '5' and lost the int 5, which DuckDB
# reads as '5' too.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS sv (TYPE mssql);

statement ok
SELECT mssql_exec('sv', 'DROP TABLE IF EXISTS dbo.sv_read; CREATE TABLE dbo.sv_read (id int PRIMARY KEY, v sql_variant NULL)');

# One INSERT per value: a VALUES list converts every row to one type first.
statement ok
SELECT mssql_exec('sv', 'INSERT dbo.sv_read VALUES (1, CAST(5 AS int)); INSERT dbo.sv_read VALUES (2, CAST(N''5'' AS nvarchar(10))); INSERT dbo.sv_read VALUES (3, CAST(''2026-09-16T10:11:12.1234567'' AS datetime2(7))); INSERT dbo.sv_read VALUES (4, CAST(''10:11:12.1234567'' AS time(7))); INSERT dbo.sv_read VALUES (5, CAST(''2026-09-16'' AS date)); INSERT dbo.sv_read VALUES (6, CAST(''2026-09-16T10:11:12.123'' AS datetime)); INSERT dbo.sv_read VALUES (7, CAST(''2026-09-16T10:11:12.1234567+03:00'' AS datetimeoffset(7)))');

statement ok
SELECT mssql_exec('sv', 'INSERT dbo.sv_read VALUES (8, CAST(0x0102FF AS varbinary(10))); INSERT dbo.sv_read VALUES (9, CAST(0.1 AS float)); INSERT dbo.sv_read VALUES (10, CAST(1.2345678 AS real)); INSERT dbo.sv_read VALUES (11, CAST(123456.7891 AS money)); INSERT dbo.sv_read VALUES (12, CAST(12345.678901 AS decimal(18,6))); INSERT dbo.sv_read VALUES (13, CAST(''A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'' AS uniqueidentifier)); INSERT dbo.sv_read VALUES (14, CAST(1 AS bit)); INSERT dbo.sv_read VALUES (15, NULL)');

statement ok
SELECT mssql_invalidate_cache('sv');

query IT
SELECT id, v FROM sv.dbo.sv_read ORDER BY id;
----
1	5
2	5
3	2026-09-16T10:11:12.1234567
4	10:11:12.1234567
5	2026-09-16
6	2026-09-16T10:11:12.123
7	2026-09-16T10:11:12.1234567+03:00
8	0x0102FF
9	1.0000000000000001e-001
10	1.2345677614212036e+000
11	123456.7891
12	12345.678901
13	A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11
14	1
15	NULL

# The float and the real read back as the values the server holds.
query I
SELECT v::DOUBLE = 0.1 FROM sv.dbo.sv_read WHERE id = 9;
----
true

query I
SELECT v::DOUBLE = 1.2345678::REAL::DOUBLE FROM sv.dbo.sv_read WHERE id = 10;
----
true

# Issue #514: the int 5 and the nvarchar '5' are one text here, and both come back.
query I
SELECT id FROM sv.dbo.sv_read WHERE v = '5' ORDER BY id;
----
1
2

query I
SELECT id FROM sv.dbo.sv_read WHERE v IN ('5', '0x0102FF') ORDER BY id;
----
1
2
8

query I
SELECT id FROM sv.dbo.sv_read WHERE v LIKE '2026-09-16%' ORDER BY id;
----
3
5
6
7

query I
SELECT count(*) FROM sv.dbo.sv_read WHERE v IS NULL;
----
1

statement ok
SELECT mssql_exec('sv', 'DROP TABLE dbo.sv_read');

statement ok
DETACH sv;

# how the server writes .003 -- between two reads: = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '2026-01-01 10:00:00.003'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '2026-01-01 10:00:00.003'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '2026-01-01 10:00:00.003'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '2026-01-01 10:00:00.003'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '2026-01-01 10:00:00.003'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '2026-01-01 10:00:00.003');

NULL	[1, 2, 3, 4, 5, 7, 8, 9]	[3, 4, 5, 9]	[3, 4, 5, 9]	[1, 2, 7, 8]	[1, 2, 7, 8]

# the first datetime: = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '1753-01-01 00:00:00'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '1753-01-01 00:00:00'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '1753-01-01 00:00:00'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '1753-01-01 00:00:00'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '1753-01-01 00:00:00'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '1753-01-01 00:00:00');

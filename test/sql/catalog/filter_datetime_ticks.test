SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '9999-12-31 23:59:59.996666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '9999-12-31 23:59:59.996666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '9999-12-31 23:59:59.996666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '9999-12-31 23:59:59.996666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '9999-12-31 23:59:59.996666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '9999-12-31 23:59:59.996666');

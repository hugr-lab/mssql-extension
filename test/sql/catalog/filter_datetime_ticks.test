# IN, NOT IN, BETWEEN, a two-sided range
query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k IN (TIMESTAMP '2026-01-01 10:00:00.003333', TIMESTAMP '2026-01-01 10:00:00.005', TIMESTAMP '2026-01-01 10:00:00.010000');
----
[2, 4]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k NOT IN (TIMESTAMP '2026-01-01 10:00:00.003333', TIMESTAMP '2026-01-01 10:00:00.005');
----
[1, 3, 4, 5, 7, 8, 9]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k BETWEEN TIMESTAMP '2026-01-01 10:00:00.003333' AND TIMESTAMP '2026-01-01 10:00:00.006666';
----
[2, 3]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k BETWEEN TIMESTAMP '2026-01-01 10:00:00.003334' AND TIMESTAMP '2026-01-01 10:00:00.006665';
----
NULL

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '2026-01-01 10:00:00.003333' AND k <= TIMESTAMP '2026-01-01 10:00:00.010000';
----
[3, 4]

# rowid of a datetime primary key
query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickKey WHERE rowid = TIMESTAMP '2026-01-01 10:00:00.003333';
----
[2]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickKey WHERE rowid = TIMESTAMP '2026-01-01 10:00:00.003334';
----
NULL

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickKey WHERE rowid > TIMESTAMP '2026-01-01 10:00:00.003333';
----
[3, 4, 5, 9]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickKey WHERE rowid <= TIMESTAMP '2026-01-01 10:00:00.006666';
----
[1, 2, 3, 7, 8]

statement ok
RESET mssql_scan_parameterize_filters;

# =============================================================================
# rowid of a datetime primary key: equality matches the tick read as the
# constant (between two reads, nothing: #358 rounded it onto a tick), and a
# range on the scalar key is a range on the column
# =============================================================================

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickKey WHERE rowid = TIMESTAMP '2026-01-01 10:00:00.003333';
----
[2]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickKey WHERE rowid = TIMESTAMP '2026-01-01 10:00:00.003334';
----
NULL

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickKey WHERE rowid > TIMESTAMP '2026-01-01 10:00:00.003333';
----
[3, 4, 5, 9]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickKey WHERE rowid <= TIMESTAMP '2026-01-01 10:00:00.006666';
----
[1, 2, 3, 7, 8]

# =============================================================================
# A datetime column against anything but constants and datetime columns is
# evaluated by DuckDB: k2 is a datetime2(6) column holding what DuckDB reads
# from k, kb a second datetime column. Pushed, `k = k2` matched only the whole
# 10 ms rows and `k > k2` the others; ticks against ticks (`k = kb`) still go.
# =============================================================================

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = k2;
----
[1, 2, 3, 4, 5, 7, 8, 9]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > k2;
----
NULL

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= k2;
----
[1, 2, 3, 4, 5, 7, 8, 9]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.003333' IN (k, kb);
----
[1, 2]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE CASE WHEN id > 4 THEN kb ELSE k END = TIMESTAMP '2026-01-01 10:00:00.010000';
----
[4]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = kb;
----
[2, 4, 7, 9]

query I
SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < kb;
----
[1, 3, 8]

statement ok
SELECT mssql_exec('dtt', 'DROP TABLE dbo.DtTickFilter; DROP TABLE dbo.DtTickKey');

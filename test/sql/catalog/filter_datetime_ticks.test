# name: test/sql/catalog/filter_datetime_ticks.test
# description: Issue #426 -- a pushed filter on a DATETIME column decides as DuckDB does over the values the scan reads
# group: [catalog]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# A datetime holds 1/300 s ticks; the scan reads each as its microsecond,
# truncated (.003 is .00333... on the server and .003333 here). The pushed
# filter compared the column with its constant as datetime2, exactly, so a
# value read back matched only on a whole 10 ms (`k = .003333` found nothing),
# and `>` / `<=` disagreed on it the same way. The constant is now the tick that
# decides the comparison, sent as datetime: `=` / `<>` / IN the tick read as it
# (between two reads a datetime2 value no datetime equals, at any compatibility
# level), `>` / `<=` the tick read at or below it, `>=` / `<` the one at or
# above.
# Each expected list is DuckDB's answer over the values read (ids: 1 .000,
# 2 .003, 3 .007, 4 .010, 5 .013, 6 NULL, 7 1753-01-01 .000, 8 1753-01-01 .003,
# 9 9999-12-31 23:59:59.997). Parameterised (a datetime parameter) and literal
# (CAST(... AS datetime)) forms; a rowid of a datetime primary key; a datetime
# column against a datetime2 column, a CASE over it, a constant with it in
# its IN list (left to DuckDB), and against another datetime column.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS dtt (TYPE mssql);

statement ok
SELECT mssql_exec('dtt', 'DROP TABLE IF EXISTS dbo.DtTickFilter; DROP TABLE IF EXISTS dbo.DtTickKey; CREATE TABLE dbo.DtTickFilter (id int PRIMARY KEY, k datetime NULL, k2 datetime2(6) NULL, kb datetime NULL); INSERT INTO dbo.DtTickFilter VALUES (1, ''2026-01-01 10:00:00.000'', ''2026-01-01 10:00:00.000000'', ''2026-01-01 10:00:00.003''), (2, ''2026-01-01 10:00:00.003'', ''2026-01-01 10:00:00.003333'', ''2026-01-01 10:00:00.003''), (3, ''2026-01-01 10:00:00.007'', ''2026-01-01 10:00:00.006666'', ''2026-01-01 10:00:00.010''), (4, ''2026-01-01 10:00:00.010'', ''2026-01-01 10:00:00.010000'', ''2026-01-01 10:00:00.010''), (5, ''2026-01-01 10:00:00.013'', ''2026-01-01 10:00:00.013333'', NULL), (6, NULL, NULL, ''2026-01-01 10:00:00.007''), (7, ''1753-01-01 00:00:00.000'', ''1753-01-01 00:00:00.000000'', ''1753-01-01 00:00:00.000''), (8, ''1753-01-01 00:00:00.003'', ''1753-01-01 00:00:00.003333'', ''1753-01-01 00:00:00.007''), (9, ''9999-12-31 23:59:59.997'', ''9999-12-31 23:59:59.996666'', ''9999-12-31 23:59:59.997''); CREATE TABLE dbo.DtTickKey (k datetime PRIMARY KEY, id int NOT NULL); INSERT INTO dbo.DtTickKey (id, k) VALUES (1, ''2026-01-01 10:00:00.000''), (2, ''2026-01-01 10:00:00.003''), (3, ''2026-01-01 10:00:00.007''), (4, ''2026-01-01 10:00:00.010''), (5, ''2026-01-01 10:00:00.013''), (7, ''1753-01-01 00:00:00.000''), (8, ''1753-01-01 00:00:00.003''), (9, ''9999-12-31 23:59:59.997'')');

statement ok
SELECT mssql_invalidate_cache('dtt');

# The issue's repro: a value read back, compared with its own column.
query I
SELECT count(*) FROM dtt.dbo.DtTickFilter WHERE k = (SELECT max(k) FILTER (WHERE k < TIMESTAMP '2026-01-01 10:00:00.005') FROM dtt.dbo.DtTickFilter);
----
1

# =============================================================================
# Parameterised (the default)
# =============================================================================

# read of .003 (tick 1): = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '2026-01-01 10:00:00.003333'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '2026-01-01 10:00:00.003333'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '2026-01-01 10:00:00.003333'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '2026-01-01 10:00:00.003333'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '2026-01-01 10:00:00.003333'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '2026-01-01 10:00:00.003333');
----
[2]	[1, 3, 4, 5, 7, 8, 9]	[1, 7, 8]	[1, 2, 7, 8]	[3, 4, 5, 9]	[2, 3, 4, 5, 9]

# the constant on the left
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.003333' = k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.003333' <> k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.003333' < k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.003333' <= k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.003333' > k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.003333' >= k);
----
[2]	[1, 3, 4, 5, 7, 8, 9]	[3, 4, 5, 9]	[2, 3, 4, 5, 9]	[1, 7, 8]	[1, 2, 7, 8]

# read of .007 (tick 2): = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '2026-01-01 10:00:00.006666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '2026-01-01 10:00:00.006666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '2026-01-01 10:00:00.006666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '2026-01-01 10:00:00.006666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '2026-01-01 10:00:00.006666'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '2026-01-01 10:00:00.006666');
----
[3]	[1, 2, 4, 5, 7, 8, 9]	[1, 2, 7, 8]	[1, 2, 3, 7, 8]	[4, 5, 9]	[3, 4, 5, 9]

# read of .010 (tick 3, exact): = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '2026-01-01 10:00:00.010000'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '2026-01-01 10:00:00.010000'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '2026-01-01 10:00:00.010000'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '2026-01-01 10:00:00.010000'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '2026-01-01 10:00:00.010000'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '2026-01-01 10:00:00.010000');
----
[4]	[1, 2, 3, 5, 7, 8, 9]	[1, 2, 3, 7, 8]	[1, 2, 3, 4, 7, 8]	[5, 9]	[4, 5, 9]

# just past a read: = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '2026-01-01 10:00:00.003334'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '2026-01-01 10:00:00.003334'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '2026-01-01 10:00:00.003334'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '2026-01-01 10:00:00.003334'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '2026-01-01 10:00:00.003334'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '2026-01-01 10:00:00.003334');
----
NULL	[1, 2, 3, 4, 5, 7, 8, 9]	[1, 2, 7, 8]	[1, 2, 7, 8]	[3, 4, 5, 9]	[3, 4, 5, 9]

# just short of a read: = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '2026-01-01 10:00:00.006665'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '2026-01-01 10:00:00.006665'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '2026-01-01 10:00:00.006665'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '2026-01-01 10:00:00.006665'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '2026-01-01 10:00:00.006665'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '2026-01-01 10:00:00.006665');
----
NULL	[1, 2, 3, 4, 5, 7, 8, 9]	[1, 2, 7, 8]	[1, 2, 7, 8]	[3, 4, 5, 9]	[3, 4, 5, 9]

# between two reads: = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '2026-01-01 10:00:00.005'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '2026-01-01 10:00:00.005'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '2026-01-01 10:00:00.005'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '2026-01-01 10:00:00.005'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '2026-01-01 10:00:00.005'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '2026-01-01 10:00:00.005');

NULL	[1, 2, 3, 4, 5, 7, 8, 9]	[1, 2, 7, 8]	[1, 2, 7, 8]	[3, 4, 5, 9]	[3, 4, 5, 9]

# the constant on the left
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.005' = k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.005' <> k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.005' < k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.005' <= k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.005' > k), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE TIMESTAMP '2026-01-01 10:00:00.005' >= k);

# how the server writes the last datetime -- past its read: = <> < <= > >=
query IIIIII
SELECT (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k = TIMESTAMP '9999-12-31 23:59:59.997'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <> TIMESTAMP '9999-12-31 23:59:59.997'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k < TIMESTAMP '9999-12-31 23:59:59.997'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k <= TIMESTAMP '9999-12-31 23:59:59.997'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k > TIMESTAMP '9999-12-31 23:59:59.997'), (SELECT list(id ORDER BY id) FROM dtt.dbo.DtTickFilter WHERE k >= TIMESTAMP '9999-12-31 23:59:59.997');

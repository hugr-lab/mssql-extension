# name: test/sql/catalog/varchar_declaration_seek.test
# description: A non-ASCII constant is declared varchar when both code pages can hold it, and the index seek survives (issue #361)
# group: [sql]
#
# Spec 076 declared every non-ASCII constant as nvarchar. On a SQL_ collation
# that puts CONVERT_IMPLICIT on the column and the seek becomes a scan; on a
# Windows collation the optimizer seeks through the convert, and on a UTF-8
# column the nvarchar form is the only correct one for a character the
# database's code page cannot hold (#321). The rule is now: varchar when the
# column's AND the database's code page hold every character, nvarchar
# otherwise. Rows alone cannot tell a seek from a scan, so the second half of
# this file reads the cached plan of each statement back through mssql_scan:
# the declaration is the statement text's prefix, and the operator is in the
# plan XML. TestDB is SQL_Latin1_General_CP1_CI_AS (code page 1252).
#
# REQUIRES: SQL Server 2019+ (a _UTF8 collation) on localhost:1433 with TestDB

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS vd (TYPE mssql);

statement ok
SET mssql_exec_invalidate_cache = true;

# Every plan below assumes the database's code page is 1252; a server started
# with another default collation would fail the assertions for that reason,
# so name it here.
query I
SELECT * FROM mssql_scan('vd', 'SELECT CAST(COLLATIONPROPERTY(CAST(DATABASEPROPERTYEX(DB_NAME(), ''Collation'') AS NVARCHAR(128)), ''CodePage'') AS INT) AS code_page');
----
1252

statement ok
SELECT mssql_exec('vd', 'DROP TABLE IF EXISTS dbo.VarcharDeclSeek');

statement ok
SELECT mssql_exec('vd', 'CREATE TABLE dbo.VarcharDeclSeek (id INT PRIMARY KEY, v VARCHAR(20) COLLATE SQL_Latin1_General_CP1_CI_AS NOT NULL, w VARCHAR(20) COLLATE Latin1_General_CI_AS NOT NULL, u VARCHAR(20) COLLATE Latin1_General_100_BIN2_UTF8 NOT NULL, t TEXT COLLATE SQL_Latin1_General_CP1_CI_AS NULL)');

# 20000 rows so the optimizer has a reason to seek, plus the two probes:
# ñ (U+00F1) is in code page 1252, ы (U+044B) is not.
statement ok
SELECT mssql_exec('vd', 'INSERT INTO dbo.VarcharDeclSeek (id, v, w, u) SELECT n, ''f'' + CAST(n AS varchar(10)), ''f'' + CAST(n AS varchar(10)), ''f'' + CAST(n AS varchar(10)) FROM (SELECT TOP 20000 ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) n FROM sys.all_columns a CROSS JOIN sys.all_columns b) x');

statement ok
SELECT mssql_exec('vd', 'INSERT INTO dbo.VarcharDeclSeek (id, v, w, u, t) VALUES (20001, N''ñu'', N''ñu'', N''ñu'', NULL), (20002, ''ab'', ''ab'', N''ыы'', NULL), (20003, ''ss'', ''ss'', ''ss'', ''?abc'')');

statement ok
SELECT mssql_exec('vd', 'CREATE INDEX ix_v ON dbo.VarcharDeclSeek(v)');

statement ok
SELECT mssql_exec('vd', 'CREATE INDEX ix_w ON dbo.VarcharDeclSeek(w)');

statement ok
SELECT mssql_exec('vd', 'CREATE INDEX ix_u ON dbo.VarcharDeclSeek(u)');

# The rows: every shape finds its row.
query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE v = 'ñu';
----
20001

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE w = 'ñu';
----
20001

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE u = 'ñu';
----
20001

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE u = 'ыы';
----
20002

# The behaviour change the CHANGELOG names (review of #368): under a varchar
# parameter the SQL_ collation compares by its own sort order, where ß is not
# ss; the nvarchar parameter it replaced compared under Windows Unicode rules,
# where it was. A Windows collation says ss for varchar too — the contrast.
query I
SELECT count(*) FROM vd.dbo.VarcharDeclSeek WHERE v = 'ß';
----
0

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE w = 'ß';
----
20003

# text follows the two-page rule: a varchar(max) parameter turned 'ы%' into
# '?%' and matched the '?abc' row; nvarchar(max) does not. The control shows
# the row is there and LIKE reaches it.
query I
SELECT count(*) FROM vd.dbo.VarcharDeclSeek WHERE t LIKE 'ы%';
----
0

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE t LIKE '?%';
----
20003

# The plans. DROP TABLE does not evict an sp_executesql plan, and the table
# name and statement text are the same on every run, so a plan left by an
# earlier run could satisfy the probes after a regression (review of #368).
# Every cached plan mentioning the table is freed first, the probes run
# again, and only then is the cache read. `[[]` is a literal `[` in a T-SQL
# LIKE pattern.
statement ok
SELECT mssql_exec('vd', 'DECLARE @h varbinary(64); DECLARE c CURSOR LOCAL FAST_FORWARD FOR SELECT cp.plan_handle FROM sys.dm_exec_cached_plans cp CROSS APPLY sys.dm_exec_sql_text(cp.plan_handle) t WHERE t.text LIKE ''%VarcharDeclSeek%''; OPEN c; FETCH NEXT FROM c INTO @h; WHILE @@FETCH_STATUS = 0 BEGIN DBCC FREEPROCCACHE(@h) WITH NO_INFOMSGS; FETCH NEXT FROM c INTO @h; END; CLOSE c; DEALLOCATE c;');

query I
SELECT count(*) FROM mssql_scan('vd', 'SELECT 1 AS hit FROM sys.dm_exec_cached_plans cp CROSS APPLY sys.dm_exec_sql_text(cp.plan_handle) t WHERE t.text LIKE ''(@p0%VarcharDeclSeek%'' ');
----
0

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE v = 'ñu';
----
20001

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE w = 'ñu';
----
20001

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE u = 'ñu';
----
20001

query I
SELECT id FROM vd.dbo.VarcharDeclSeek WHERE u = 'ыы';
----
20002

# SQL_ collation, ñ: declared varchar(20), Index Seek — the #361 case.
query I
SELECT count(*) >= 1 FROM mssql_scan('vd', 'SELECT 1 AS hit FROM sys.dm_exec_cached_plans cp CROSS APPLY sys.dm_exec_sql_text(cp.plan_handle) t CROSS APPLY sys.dm_exec_query_plan(cp.plan_handle) p WHERE t.text LIKE ''(@p0 varchar(20))%VarcharDeclSeek%([[]v] = @p0)%'' AND CAST(p.query_plan AS nvarchar(max)) LIKE ''%PhysicalOp="Index Seek"%''');
----
true

# Windows collation, ñ: varchar(20), seek.
query I
SELECT count(*) >= 1 FROM mssql_scan('vd', 'SELECT 1 AS hit FROM sys.dm_exec_cached_plans cp CROSS APPLY sys.dm_exec_sql_text(cp.plan_handle) t CROSS APPLY sys.dm_exec_query_plan(cp.plan_handle) p WHERE t.text LIKE ''(@p0 varchar(20))%VarcharDeclSeek%([[]w] = @p0)%'' AND CAST(p.query_plan AS nvarchar(max)) LIKE ''%PhysicalOp="Index Seek"%''');
----
true

# UTF-8 column, ñ: the database's page holds it, so varchar(20) and a seek.
query I
SELECT count(*) >= 1 FROM mssql_scan('vd', 'SELECT 1 AS hit FROM sys.dm_exec_cached_plans cp CROSS APPLY sys.dm_exec_sql_text(cp.plan_handle) t CROSS APPLY sys.dm_exec_query_plan(cp.plan_handle) p WHERE t.text LIKE ''(@p0 varchar(20))%VarcharDeclSeek%([[]u] = @p0)%'' AND CAST(p.query_plan AS nvarchar(max)) LIKE ''%PhysicalOp="Index Seek"%''');
----
true

# UTF-8 column, ы: the database's page cannot hold it — nvarchar(20), as #321
# requires. Only the declaration is asserted: whether the optimizer seeks
# through the convert on a UTF-8 column is its call, not this change's.
query I
SELECT count(*) >= 1 FROM mssql_scan('vd', 'SELECT 1 AS hit FROM sys.dm_exec_cached_plans cp CROSS APPLY sys.dm_exec_sql_text(cp.plan_handle) t WHERE t.text LIKE ''(@p0 nvarchar(20))%VarcharDeclSeek%([[]u] = @p0)%'' ');
----
true

statement ok
SELECT mssql_exec('vd', 'DROP TABLE dbo.VarcharDeclSeek');

statement ok
SET mssql_exec_invalidate_cache = false;

statement ok
DETACH vd;

# name: test/sql/transaction/transaction_metadata_warm.test
# description: What a transaction loaded or changed, and the shared cache lacks, is loaded into it after the transaction ends -- up to 5 tables (issue #383)
# group: [transaction]
# issue: 383

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# Inside a transaction a catalog miss is loaded on the pinned connection into
# the transaction's own cache and never into the shared one (#380). Alone,
# that made every transaction of a transaction-only workload (DuckLake) pay a
# metadata round trip per table it touched. After COMMIT or ROLLBACK the
# tables the transaction loaded or changed, and the shared cache now lacks,
# are loaded into it on an IDLE pool connection -- committed state, taken
# after the transaction -- one by one, and only when there are at most 5 of
# them: the load runs on COMMIT's path, so more is left to lazy loading
# (review of #386). Inside a transaction the shared cache is read too, into
# the transaction's own layer. Not on a pool of one connection.
#
# The lever: mssql_test_fail_metadata_after_rows = 1 makes any metadata query
# fail. A read that succeeds under it ran none.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS w383 (TYPE mssql);

statement ok
SELECT mssql_exec('w383', 'DROP TABLE IF EXISTS dbo.w383_t, dbo.w383_rb; DROP TABLE IF EXISTS w383.t1; DROP TABLE IF EXISTS w383.t2; DROP TABLE IF EXISTS w383.t3; DROP TABLE IF EXISTS w383.t4; DROP TABLE IF EXISTS w383.t5; DROP TABLE IF EXISTS w383.t6; DROP TABLE IF EXISTS w383.t7; DROP TABLE IF EXISTS w383.t8; DROP TABLE IF EXISTS w383.t9; DROP TABLE IF EXISTS w383.t10; DROP SCHEMA IF EXISTS w383');

statement ok
SELECT mssql_exec('w383', 'CREATE TABLE dbo.w383_t (id int NOT NULL PRIMARY KEY); INSERT INTO dbo.w383_t VALUES (1), (2)');

statement ok
SELECT mssql_exec('w383', 'EXEC(''CREATE SCHEMA w383''); CREATE TABLE w383.t1 (id int NOT NULL); CREATE TABLE w383.t2 (id int NOT NULL); CREATE TABLE w383.t3 (id int NOT NULL); CREATE TABLE w383.t4 (id int NOT NULL); CREATE TABLE w383.t5 (id int NOT NULL); CREATE TABLE w383.t6 (id int NOT NULL); CREATE TABLE w383.t7 (id int NOT NULL); CREATE TABLE w383.t8 (id int NOT NULL); CREATE TABLE w383.t9 (id int NOT NULL); CREATE TABLE w383.t10 (id int NOT NULL);');

statement ok
SELECT mssql_invalidate_cache('w383');

#------------------------------------------------------------------------------
# A few tables: loaded one by one after COMMIT.
#------------------------------------------------------------------------------

statement ok
BEGIN;

query I
SELECT count(*) FROM w383.dbo.w383_t;
----
2

statement ok
COMMIT;

statement ok
SET mssql_test_fail_metadata_after_rows = 1;

# The next transaction reads it from the shared cache: no metadata query.
statement ok
BEGIN;

query I
SELECT count(*) FROM w383.dbo.w383_t;
----
2

statement ok
COMMIT;

# Neither does another connection in autocommit.
query I con2
SELECT count(*) FROM w383.dbo.w383_t;
----
2

statement ok
RESET mssql_test_fail_metadata_after_rows;

#------------------------------------------------------------------------------
# More than 5 tables missing: nothing is loaded after COMMIT, and the next
# transaction loads on its own -- which the lever turns into an error.
#------------------------------------------------------------------------------

statement ok
BEGIN;

query I
SELECT (SELECT count(*) FROM w383.w383.t1) + (SELECT count(*) FROM w383.w383.t2) + (SELECT count(*) FROM w383.w383.t3)
     + (SELECT count(*) FROM w383.w383.t4) + (SELECT count(*) FROM w383.w383.t5) + (SELECT count(*) FROM w383.w383.t6);
----
0

statement ok
COMMIT;

statement ok
SET mssql_test_fail_metadata_after_rows = 1;

statement ok
BEGIN;

statement error
SELECT count(*) FROM w383.w383.t1;
----
mssql_test_fail_metadata_after_rows

statement ok
ROLLBACK;

statement ok
RESET mssql_test_fail_metadata_after_rows;

#------------------------------------------------------------------------------
# After ROLLBACK the warm-up loads COMMITTED state. The transaction adds a
# column on its pinned connection and reads the table with it; the rollback
# forgets the table in the shared cache, and the warm-up reloads it without
# the column. Under the lever the next read succeeds only if the warm-up ran,
# and shows only if it loaded the committed shape. (Removing the warm-up makes
# the DESCRIBE fail on the lever; a warm-up that published the transaction's
# view would show `extra`.)
#------------------------------------------------------------------------------

statement ok
SET mssql_exec_invalidate_cache = true;

statement ok
BEGIN;

statement ok
SELECT mssql_exec('w383', 'ALTER TABLE dbo.w383_t ADD extra int NULL');

query II
SELECT count(*), count(extra) FROM w383.dbo.w383_t;
----
2	0

statement ok
ROLLBACK;

statement ok
SET mssql_exec_invalidate_cache = false;

statement ok
SET mssql_test_fail_metadata_after_rows = 1;

query T
SELECT column_name FROM (DESCRIBE w383.dbo.w383_t);
----
id

statement ok
RESET mssql_test_fail_metadata_after_rows;

#------------------------------------------------------------------------------
# A table the transaction dropped is not loaded after COMMIT (it cannot be),
# and is gone for the next statement.
#------------------------------------------------------------------------------

statement ok
SELECT mssql_exec('w383', 'CREATE TABLE dbo.w383_rb (id int NOT NULL)');

statement ok
SELECT mssql_invalidate_cache('w383');

statement ok
BEGIN;

query I
SELECT count(*) FROM w383.dbo.w383_rb;
----
0

statement ok
DROP TABLE w383.dbo.w383_rb;

statement ok
COMMIT;

statement error
SELECT count(*) FROM w383.dbo.w383_rb;
----
does not exist

statement error con2
SELECT count(*) FROM w383.dbo.w383_rb;
----
does not exist

statement ok
SELECT mssql_exec('w383', 'DROP TABLE IF EXISTS dbo.w383_t; DROP TABLE IF EXISTS w383.t1; DROP TABLE IF EXISTS w383.t2; DROP TABLE IF EXISTS w383.t3; DROP TABLE IF EXISTS w383.t4; DROP TABLE IF EXISTS w383.t5; DROP TABLE IF EXISTS w383.t6; DROP TABLE IF EXISTS w383.t7; DROP TABLE IF EXISTS w383.t8; DROP TABLE IF EXISTS w383.t9; DROP TABLE IF EXISTS w383.t10; DROP SCHEMA IF EXISTS w383');

statement ok
DETACH w383;

#------------------------------------------------------------------------------
# A table the shared cache's listing does not know is not "absent" inside a
# transaction: after `preload` the listing of dbo is loaded, and a table
# created behind the catalog's back (mssql_exec, no invalidation) is found in a
# transaction exactly as in autocommit -- it used to be refused there as
# "does not exist" (review of #386).
#------------------------------------------------------------------------------

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS w383p (TYPE mssql, preload true);

statement ok
SELECT mssql_exec('w383p', 'DROP TABLE IF EXISTS dbo.w383_new; CREATE TABLE dbo.w383_new (id int NOT NULL)');

statement ok
BEGIN;

query I
SELECT count(*) FROM w383p.dbo.w383_new;
----
0

statement ok
COMMIT;

query I
SELECT count(*) FROM w383p.dbo.w383_new;
----
0

statement ok
SELECT mssql_exec('w383p', 'DROP TABLE dbo.w383_new');

statement ok
DETACH w383p;

#------------------------------------------------------------------------------
# The table filter holds across the warm-up: a table it hides that a
# transaction created is not loaded into the shared cache at COMMIT, and stays
# hidden inside the next transaction.
#------------------------------------------------------------------------------

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS w383f (TYPE mssql, table_filter '^TestSimplePK$');

statement ok
SELECT mssql_exec('w383f', 'DROP TABLE IF EXISTS dbo.w383_hidden');

statement ok
BEGIN;

statement ok
CREATE TABLE w383f.dbo.w383_hidden (id INTEGER);

statement ok
COMMIT;

statement ok
BEGIN;

statement error
SELECT count(*) FROM w383f.dbo.w383_hidden;
----
does not exist

statement ok
ROLLBACK;

statement error
SELECT count(*) FROM w383f.dbo.w383_hidden;
----
does not exist

statement ok
SELECT mssql_exec('w383f', 'DROP TABLE IF EXISTS dbo.w383_hidden');

statement ok
DETACH w383f;

#------------------------------------------------------------------------------
# A pool of one connection: no warm-up -- the next transaction loads again,
# which the lever turns into an error.
#------------------------------------------------------------------------------

statement ok
SET mssql_connection_limit = 1;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS w383one (TYPE mssql);

statement ok
SELECT mssql_invalidate_cache('w383one');

statement ok
BEGIN;

query I
SELECT count(*) > 0 FROM w383one.dbo.TestSimplePK;
----
true

statement ok
COMMIT;

statement ok
SET mssql_test_fail_metadata_after_rows = 1;

statement ok
BEGIN;

statement error
SELECT count(*) FROM w383one.dbo.TestSimplePK;
----
mssql_test_fail_metadata_after_rows

statement ok
ROLLBACK;

statement ok
RESET mssql_test_fail_metadata_after_rows;

statement ok
DETACH w383one;

statement ok
RESET mssql_connection_limit;

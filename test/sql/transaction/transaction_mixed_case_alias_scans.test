# name: test/sql/transaction/transaction_mixed_case_alias_scans.test
# description: A raw mssql_scan naming the catalog in another case shares the pinned connection with a catalog scan (issue #239)
# group: [mssql]
# issue: 239

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# The planner materialises the catalog scans of a catalog that a transaction
# reads more than once, so they cannot hold the ONE pinned connection at the
# same time. It counts those scans per catalog, and the two producers of that
# key spell it differently: a catalog scan carries
# MSSQLCatalog::GetContextName() (the alias as ATTACHed), a raw mssql_scan the
# user's literal first argument. Keyed by case, `mssql_scan('CASEMIX', ...)`
# beside `casemix.dbo.t` tallied as two catalogs of one scan each and neither
# reached the "more than one" threshold. DuckDB's own catalog lookup is
# case-insensitive, so the query is legal however the user spells the alias.
#
# WHAT THIS TEST IS, EXACTLY. It pins that both spellings work end to end
# inside a transaction. It is NOT the regression guard for the tally: measured
# both ways, this shape passes on the build with the case-sensitive tally too,
# because a raw scan materialises at InitGlobal unconditionally inside a
# transaction (spec 075) and the two scans here never hold the pinned
# connection at once. The tally fix is a consistency fix — the key must agree
# with DuckDB's case-insensitive catalog names, as the sink set already does —
# and no shape was found that fails without it. If one is ever found, it
# belongs here.
#
# The query shape is the one transaction_multi_scan_materialization.test
# explains: a correlated subquery in a PREDICATE, which plans as
# LEFT_DELIM_JOIN and initialises both sides before draining either.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS casemix (TYPE mssql);

statement ok
SELECT mssql_exec('casemix', 'IF OBJECT_ID(''dbo.CaseMixChild'',''U'') IS NOT NULL DROP TABLE dbo.CaseMixChild');

statement ok
SELECT mssql_exec('casemix', 'IF OBJECT_ID(''dbo.CaseMixParent'',''U'') IS NOT NULL DROP TABLE dbo.CaseMixParent');

statement ok
SELECT mssql_exec('casemix', 'CREATE TABLE dbo.CaseMixParent (id INT PRIMARY KEY, name VARCHAR(50))');

statement ok
SELECT mssql_exec('casemix', 'CREATE TABLE dbo.CaseMixChild (cid INT PRIMARY KEY, pid INT, v VARCHAR(50))');

# Enough rows that each scan spans several chunks; at a handful the sources
# never overlap and even a broken build passes.
statement ok
SELECT mssql_exec('casemix', 'INSERT INTO dbo.CaseMixParent (id, name) SELECT TOP 5000 ROW_NUMBER() OVER (ORDER BY (SELECT NULL)), ''p'' FROM sys.all_objects a CROSS JOIN sys.all_objects b');

statement ok
SELECT mssql_exec('casemix', 'INSERT INTO dbo.CaseMixChild (cid, pid, v) SELECT TOP 12000 ROW_NUMBER() OVER (ORDER BY (SELECT NULL)), (ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) % 5000) + 1, ''v'' FROM sys.all_objects a CROSS JOIN sys.all_objects b');

statement ok
SET threads = 1;

# The raw scan names the catalog in upper case, the catalog scan carries the
# ATTACHed spelling. One catalog, two scans.
statement ok
BEGIN;

query I
SELECT count(*) FROM mssql_scan('CASEMIX', 'SELECT id FROM dbo.CaseMixParent') p
WHERE p.id > (SELECT count(*) FROM casemix.dbo.CaseMixChild c WHERE c.pid = p.id);
----
4997

statement ok
COMMIT;

# The same query with the alias spelled as ATTACHed, which always tallied as
# one catalog: it must keep working.
statement ok
BEGIN;

query I
SELECT count(*) FROM mssql_scan('casemix', 'SELECT id FROM dbo.CaseMixParent') p
WHERE p.id > (SELECT count(*) FROM casemix.dbo.CaseMixChild c WHERE c.pid = p.id);
----
4997

statement ok
COMMIT;

statement ok
SELECT mssql_exec('casemix', 'DROP TABLE dbo.CaseMixChild; DROP TABLE dbo.CaseMixParent');

statement ok
DETACH casemix;

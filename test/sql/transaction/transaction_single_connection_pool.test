# name: test/sql/transaction/transaction_single_connection_pool.test
# description: A catalog whose pool holds ONE connection works in a transaction and in autocommit -- metadata, listing, rowid DML, CTAS, INSERT ... SELECT (issue #380)
# group: [transaction]
# issue: 380

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# With mssql_connection_limit = 1 (fixed at ATTACH) everything a statement
# does has to share the one connection:
#
#   * in a transaction, it is pinned -- so the metadata loads go on it too;
#     before, they asked the pool for a second one and failed with
#     "pool timed out (1 active of 1)";
#   * a CTAS in a transaction runs whole on it: the checks, the CREATE and the
#     rows (as INSERT statements -- a bulk load cannot share the connection
#     with the source scan), inside the transaction, so ROLLBACK undoes it;
#   * in autocommit the scans and the sink take turns at the pool, so a scan
#     of the catalog the plan writes into is materialised first, as it is in
#     a transaction; a CTAS loads with statements, which take their
#     connection only at the first batch.
#
# A short acquire timeout makes any path that still asks for a second
# connection fail in seconds instead of thirty.
#
# UPDATE / DELETE / MERGE count as sinks too (spec 080 PR 1): their feeding
# scan is materialised, in autocommit as in a transaction, and their batches
# go out as the rows arrive. Before, in autocommit their batches waited for
# the connection the scan held.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
SET mssql_connection_limit = 1;

statement ok
SET mssql_acquire_timeout = 3;

# Threads, so a CTAS's sink init and its source scan's drain can meet on the
# one connection (review of #382).
statement ok
SET threads = 4;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS one380 (TYPE mssql);

#------------------------------------------------------------------------------
# A table with no key (spec 080 D3, rung 3): the stage is filled and joined on
# the statement's one connection, after the source scan gave it back.
#------------------------------------------------------------------------------

statement ok
SELECT mssql_exec('one380', 'DROP TABLE IF EXISTS dbo.one380_kl; CREATE TABLE dbo.one380_kl (id int NOT NULL, v varchar(4) NULL); INSERT INTO dbo.one380_kl SELECT TOP (3000) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)), NULL FROM sys.all_objects a CROSS JOIN sys.all_objects b');

query I
UPDATE one380.dbo.one380_kl SET v = 'u' WHERE id <= 1200;
----
1200

query I
DELETE FROM one380.dbo.one380_kl WHERE id > 1800;
----
1200

statement ok
BEGIN;

query I
UPDATE one380.dbo.one380_kl SET v = 't' WHERE id > 600;
----
1200

query I
DELETE FROM one380.dbo.one380_kl WHERE v = 'u';
----
600

statement ok
ROLLBACK;

query II
SELECT count(*), count(*) FILTER (WHERE v = 'u') FROM one380.dbo.one380_kl;
----
1800	1200

statement ok
SELECT mssql_exec('one380', 'DROP TABLE IF EXISTS dbo.one380_src, dbo.one380_ctas_range, dbo.one380_ctas_rb, dbo.one380_ctas_self, dbo.one380_ac_ctas, dbo.one380_ac_ins, dbo.one380_ac_copy, dbo.one380_ac_raw, dbo.one380_ac_local, dbo.one380_ac_bind, dbo.one380_kl');

statement ok
SELECT mssql_exec('one380', 'CREATE TABLE dbo.one380_src (id int NOT NULL PRIMARY KEY, v nvarchar(10) NULL); INSERT INTO dbo.one380_src SELECT TOP 2500 ROW_NUMBER() OVER (ORDER BY (SELECT NULL)), N''x'' FROM sys.all_columns a CROSS JOIN sys.all_columns b');

statement ok
SELECT mssql_exec('one380', 'CREATE TABLE dbo.one380_ac_ins (id int NOT NULL, v nvarchar(10) NULL)');

statement ok
SELECT mssql_invalidate_cache('one380');

#------------------------------------------------------------------------------
# Transaction: first touch, listing, rowid UPDATE -- all on the pinned one.
#------------------------------------------------------------------------------

statement ok
BEGIN;

query I
SELECT count(*) FROM one380.dbo.one380_src;
----
2500

query I
SELECT count(*) > 0 FROM duckdb_tables() WHERE database_name = 'one380' AND schema_name = 'dbo';
----
true

query I
UPDATE one380.dbo.one380_src SET v = 'y' WHERE id <= 10;
----
10

query I
SELECT count(*) FROM one380.dbo.one380_src WHERE v = 'y';
----
10

statement ok
ROLLBACK;

query I
SELECT count(*) FROM one380.dbo.one380_src WHERE v = 'y';
----
0

#------------------------------------------------------------------------------
# Transaction: CTAS from a DuckDB source, committed.
#------------------------------------------------------------------------------

statement ok
BEGIN;

query I
CREATE TABLE one380.dbo.one380_ctas_range AS SELECT i::INTEGER AS id FROM range(1500) t(i);
----
1500

query I
SELECT count(*) FROM one380.dbo.one380_ctas_range;
----
1500

statement ok
COMMIT;

query I
SELECT count(*) FROM one380.dbo.one380_ctas_range;
----
1500

#------------------------------------------------------------------------------
# Transaction: CTAS, rolled back -- the table was created inside the
# transaction, so it is gone, not left behind empty.
#------------------------------------------------------------------------------

statement ok
BEGIN;

statement ok
CREATE TABLE one380.dbo.one380_ctas_rb AS SELECT i::INTEGER AS id FROM range(10) t(i);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM mssql_scan('one380', 'SELECT OBJECT_ID(''dbo.one380_ctas_rb'') AS o') WHERE o IS NOT NULL;
----
0

statement error
SELECT count(*) FROM one380.dbo.one380_ctas_rb;
----
does not exist

#------------------------------------------------------------------------------
# Transaction: CTAS reading the catalog it writes into.
#------------------------------------------------------------------------------

statement ok
BEGIN;

query I
CREATE TABLE one380.dbo.one380_ctas_self AS SELECT id, v FROM one380.dbo.one380_src;
----
2500

query I
SELECT count(*) FROM one380.dbo.one380_ctas_self;
----
2500

statement ok
COMMIT;

query I
SELECT count(*) FROM one380.dbo.one380_ctas_self;
----
2500

#------------------------------------------------------------------------------
# Autocommit: CTAS and INSERT ... SELECT reading the catalog they write into.
#------------------------------------------------------------------------------

query I
CREATE TABLE one380.dbo.one380_ac_ctas AS SELECT id, v FROM one380.dbo.one380_src;
----
2500

query I
SELECT count(*) FROM one380.dbo.one380_ac_ctas;
----
2500

query I
INSERT INTO one380.dbo.one380_ac_ins SELECT id, v FROM one380.dbo.one380_src;
----
2500

query I
SELECT count(*) FROM one380.dbo.one380_ac_ins;
----
2500

# COPY from the catalog it writes into, and CTAS / INSERT from a raw
# mssql_scan of it (review of #382): the bulk load takes the one connection on
# its first chunk, and the raw scan is materialised as a catalog scan is.
statement ok
COPY (SELECT id, v FROM one380.dbo.one380_src) TO 'mssql://one380/dbo/one380_ac_copy' (FORMAT 'bcp', CREATE_TABLE true);

query I
SELECT count(*) FROM one380.dbo.one380_ac_copy;
----
2500

query I
CREATE TABLE one380.dbo.one380_ac_raw AS SELECT * FROM mssql_scan('one380', 'SELECT id, v FROM dbo.one380_src');
----
2500

query I
INSERT INTO one380.dbo.one380_ac_ins SELECT * FROM mssql_scan('one380', 'SELECT id, v FROM dbo.one380_src WHERE id <= 10');
----
10

# A raw scan the server cannot describe runs at BIND: its drain has the same
# condition, or the stream holds the only connection while the binder resolves
# the CTAS target (review of #389).
query I
CREATE TABLE one380.dbo.one380_ac_bind AS SELECT * FROM mssql_scan('one380', 'SELECT 1 AS id INTO #one380_bx; SELECT id FROM #one380_bx');
----
1

# A COPY into a #temp target keeps its connection from init to the end of the
# load, as it does on any pool: given back to the pool between the DDL and the
# load, the connection would be reset first, and the reset drops the table the
# init created (self-review of #388). After the statement the table goes with
# the next reset, as on a larger pool; a #temp meant to outlive the COPY is
# loaded inside a transaction, whose pinned connection is not reset.
statement ok
COPY (SELECT i::INTEGER AS id FROM range(100) t(i)) TO 'mssql://one380/#one380_tmp' (FORMAT 'bcp', CREATE_TABLE true);

# A CTAS from a local source keeps its bulk load on a pool of one (it used to
# be turned into INSERT statements for nothing).
query I
CREATE TABLE one380.dbo.one380_ac_local AS SELECT i::INTEGER AS id FROM range(3000) t(i);
----
3000

query I
SELECT count(*) FROM one380.dbo.one380_ac_local;
----
3000

#------------------------------------------------------------------------------
# Autocommit: UPDATE / DELETE / MERGE over the catalog they write into, each
# past one batch (500 rows) and fed by one streaming scan (spec 080 PR 1).
#------------------------------------------------------------------------------

query I
UPDATE one380.dbo.one380_src SET v = 'u' WHERE id <= 1200;
----
1200

query I
DELETE FROM one380.dbo.one380_src WHERE id > 1800;
----
700

# Two actions, both past one batch: they take turns at the one connection.
# With one INSERT action DuckDB runs the actions in parallel, so the one that
# waits does so for as long as the other's Finalize takes. The acquire timeout
# is read at ATTACH, so this block uses an alias of its own with a generous one:
# a test of the behaviour, not of the CI machine's speed (review of #423).
statement ok
SET mssql_acquire_timeout = 60;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS one380m (TYPE mssql);

statement ok
SET mssql_acquire_timeout = 3;

query I
MERGE INTO one380m.dbo.one380_src AS t USING (SELECT i::INTEGER AS id FROM range(1, 3001) r(i)) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = 'm'
WHEN NOT MATCHED THEN INSERT VALUES (s.id, 'n');
----
3000

statement ok
DETACH one380m;

query II
SELECT count(*) FILTER (WHERE v = 'm'), count(*) FILTER (WHERE v = 'n') FROM one380.dbo.one380_src;
----
1800	1200

#------------------------------------------------------------------------------
# Transaction: the same shapes on the pinned connection, the batches sent as
# the rows arrive (they used to wait for the end of the statement).
#------------------------------------------------------------------------------

statement ok
BEGIN;

query I
UPDATE one380.dbo.one380_src SET v = 't' WHERE id <= 1500;
----
1500

query I
DELETE FROM one380.dbo.one380_src WHERE id > 2400;
----
600

query I
MERGE INTO one380.dbo.one380_src AS t USING (SELECT i::INTEGER AS id FROM range(1501, 3601) r(i)) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = 'x'
WHEN NOT MATCHED THEN INSERT VALUES (s.id, 'y');
----
2100

query III
SELECT count(*) FILTER (WHERE v = 't'), count(*) FILTER (WHERE v = 'x'), count(*) FILTER (WHERE v = 'y') FROM one380.dbo.one380_src;
----
1500	900	1200

statement ok
ROLLBACK;

query I
SELECT count(*) FROM one380.dbo.one380_src;
----
3000

statement ok
SELECT mssql_exec('one380', 'DROP TABLE IF EXISTS dbo.one380_src, dbo.one380_ctas_range, dbo.one380_ctas_rb, dbo.one380_ctas_self, dbo.one380_ac_ctas, dbo.one380_ac_ins, dbo.one380_ac_copy, dbo.one380_ac_raw, dbo.one380_ac_local, dbo.one380_ac_bind');

statement ok
DETACH one380;

statement ok
RESET mssql_connection_limit;

statement ok
RESET mssql_acquire_timeout;

statement ok
RESET threads;

# name: test/sql/transaction/transaction_metadata_pinned.test
# description: Metadata inside an explicit transaction loads on the pinned connection and never enters the shared cache (issue #380)
# group: [transaction]
# issue: 380

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# A table created inside a transaction (COPY, mssql_exec) and read in the same
# transaction used to hang until mssql_metadata_timeout: the catalog loaded its
# metadata on a POOL connection, which waits on the schema lock of the
# transaction's uncommitted CREATE. The load now goes on the transaction's
# pinned connection, into a cache that lives and dies with the transaction:
# the catalog's shared cache is read, invalidated, never written from inside
# a transaction -- else a ROLLBACK leaves a phantom behind and another
# connection finds the uncommitted table in the cache.
#
# The metadata timeout is short so that a regression fails in seconds rather
# than hanging the suite for the default five minutes.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
SET mssql_metadata_timeout = 10;

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS tm380 (TYPE mssql);

statement ok
SELECT mssql_exec('tm380', 'DROP TABLE IF EXISTS dbo.tm380_copy, dbo.tm380_exec, dbo.tm380_commit, dbo.tm380_drop, dbo.tm380_src, dbo.tm380_ctas1, dbo.tm380_ctas2, dbo.tm380_ctas3, dbo.tm380_nokey; IF OBJECT_ID(''tm380s.t'') IS NOT NULL DROP TABLE tm380s.t; IF SCHEMA_ID(''tm380s'') IS NOT NULL EXEC(''DROP SCHEMA tm380s''); IF SCHEMA_ID(''tm380x'') IS NOT NULL EXEC(''DROP SCHEMA tm380x'')');

statement ok
SELECT mssql_exec('tm380', 'CREATE TABLE dbo.tm380_drop (id int NOT NULL)');

statement ok
SELECT mssql_invalidate_cache('tm380');

# The shared listing is loaded before any transaction, without the tables the
# transactions below create.
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'tm380' AND table_name LIKE 'tm380_%';
----
1

#------------------------------------------------------------------------------
# COPY creates a table in a transaction; the same transaction reads it, lists
# it; ROLLBACK removes it everywhere.
#------------------------------------------------------------------------------

statement ok
BEGIN;

statement ok
COPY (SELECT i::INTEGER AS id FROM range(3) t(i)) TO 'mssql://tm380/dbo/tm380_copy' (FORMAT 'bcp', CREATE_TABLE true);

query I
SELECT count(*) FROM tm380.dbo.tm380_copy;
----
3

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'tm380' AND table_name LIKE 'tm380_%';
----
2

statement ok
ROLLBACK;

statement error
SELECT count(*) FROM tm380.dbo.tm380_copy;
----
does not exist

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'tm380' AND table_name LIKE 'tm380_%';
----
1

# Another connection does not see it either.
statement error con2
SELECT count(*) FROM tm380.dbo.tm380_copy;
----
does not exist

#------------------------------------------------------------------------------
# mssql_exec DDL in a transaction, the cache told by mssql_invalidate_cache()
# -- which is allowed inside a transaction, unlike a reload.
#------------------------------------------------------------------------------

statement ok
BEGIN;

statement ok
SELECT mssql_exec('tm380', 'CREATE TABLE dbo.tm380_exec (id int NOT NULL, v nvarchar(10) NULL); INSERT INTO dbo.tm380_exec VALUES (1, N''a''), (2, N''b'')');

statement ok
SELECT mssql_invalidate_cache('tm380', 'dbo');

query IT
SELECT id, v FROM tm380.dbo.tm380_exec ORDER BY id;
----
1	a
2	b

statement error
SELECT mssql_refresh_cache('tm380');
----
cannot run inside a transaction that has used an MSSQL catalog

statement ok
ROLLBACK;

# The refusal aborted the transaction; the table is gone with it.
statement error
SELECT count(*) FROM tm380.dbo.tm380_exec;
----
does not exist

# A DuckDB transaction that has not used the catalog has nothing uncommitted
# on it: preload runs (review of #382 -- the refusal used to fire for any open
# DuckDB transaction).
statement ok
BEGIN;

# Review of #382: the refusal asks whether this transaction has used MSSQL at
# all, not merely whether one is open. A transaction that has touched no MSSQL
# catalog holds no pinned connection and nothing uncommitted on any server, so a
# bulk load of committed metadata into the shared cache is safe and allowed --
# refusing it broke scripts that wrap unrelated work in BEGIN.
statement ok
SELECT mssql_preload_catalog('tm380');

# Once the transaction HAS used an MSSQL catalog, it is refused again.
query I
SELECT count(*) FROM tm380.dbo.tm380_drop;
----
0

statement error
SELECT mssql_preload_catalog('tm380');
----
cannot run inside a transaction that has used an MSSQL catalog

statement ok
ROLLBACK;

# Reading the SCHEMA LIST does not count as using the catalog (review of
# db73be6). LookupSchema and ScanSchemas both go through SchemaListCache, which
# used to ask MSSQLTransaction::Get(...).Metadata(...) unconditionally -- and
# that CREATES this catalog's transaction, so a schema lookup that answered from
# the shared list and took no connection still flipped
# HasUsedAnyMSSQLCatalogInTransaction and got the preload above refused.
#
# The list is warmed in autocommit first, so the read inside the transaction is
# a pure cache hit: if the shortcut ever stops applying, the load takes a
# connection, the transaction is created after all, and the preload fails here.
query I
SELECT count(*) > 0 FROM duckdb_schemas() WHERE database_name = 'tm380';
----
true

statement ok
BEGIN;

query I
SELECT count(*) > 0 FROM duckdb_schemas() WHERE database_name = 'tm380';
----
true

statement ok
SELECT mssql_preload_catalog('tm380');

statement ok
ROLLBACK;

# mssql_exec DDL detection is word-based (review of #382): a keyword inside a
# literal is not DDL, so it does not make the transaction distrust the shared
# cache. The table is in the shared cache (read above in autocommit); the lever
# is on before BEGIN, so the transaction's own cache is created with it; a
# read that stayed on the shared entry runs no metadata query, and one that the
# old substring match sent to the server fails.
query I
SELECT count(*) FROM tm380.dbo.tm380_drop;
----
0

statement ok
SET mssql_test_fail_metadata_after_rows = 1;

statement ok
BEGIN;

query I
SELECT count(*) FROM tm380.dbo.tm380_drop;
----
0

statement ok
SELECT mssql_exec('tm380', 'UPDATE dbo.tm380_drop SET id = id WHERE ''created'' = ''dropped''');

query I
SELECT count(*) FROM tm380.dbo.tm380_drop;
----
0

statement ok
ROLLBACK;

statement ok
RESET mssql_test_fail_metadata_after_rows;

#------------------------------------------------------------------------------
# COMMIT publishes: the shared cache forgets what the transaction changed, and
# another connection loads the committed table.
#------------------------------------------------------------------------------

statement ok
SET mssql_exec_invalidate_cache = true;

statement ok
BEGIN;

statement ok
SELECT mssql_exec('tm380', 'CREATE TABLE dbo.tm380_commit (id int NOT NULL); INSERT INTO dbo.tm380_commit VALUES (7)');

query I
SELECT id FROM tm380.dbo.tm380_commit;
----
7

statement ok
COMMIT;

query I con2
SELECT id FROM tm380.dbo.tm380_commit;
----
7

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'tm380' AND table_name LIKE 'tm380_%';
----
2

#------------------------------------------------------------------------------
# DROP TABLE inside a transaction: gone for the transaction at once. Catalog
# DDL runs on a pool connection and autocommits (spec 057), so ROLLBACK does
# not bring it back -- and the shared cache must not either.
#------------------------------------------------------------------------------

statement ok
BEGIN;

statement ok
DROP TABLE tm380.dbo.tm380_drop;

statement error
SELECT count(*) FROM tm380.dbo.tm380_drop;
----
does not exist

statement ok
ROLLBACK;

statement error
SELECT count(*) FROM tm380.dbo.tm380_drop;
----
does not exist

statement ok
SET mssql_exec_invalidate_cache = false;

#------------------------------------------------------------------------------
# Review of #382, High: a CTAS reading the catalog it writes into, in a
# transaction, with threads -- its existence checks on the pinned connection
# must wait for the source scan draining on it (MaterializeMutex).
#------------------------------------------------------------------------------

statement ok
SET threads = 4;

statement ok
SELECT mssql_exec('tm380', 'DROP TABLE IF EXISTS dbo.tm380_src, dbo.tm380_ctas1, dbo.tm380_ctas2, dbo.tm380_ctas3; CREATE TABLE dbo.tm380_src (id int NOT NULL); INSERT INTO dbo.tm380_src SELECT TOP 20000 ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) FROM sys.all_columns a CROSS JOIN sys.all_columns b');

statement ok
SELECT mssql_invalidate_cache('tm380', 'dbo');

statement ok
BEGIN;

query I
CREATE TABLE tm380.dbo.tm380_ctas1 AS SELECT id FROM tm380.dbo.tm380_src;
----
20000

query I
CREATE TABLE tm380.dbo.tm380_ctas2 AS SELECT id FROM tm380.dbo.tm380_src WHERE id % 2 = 0;
----
10000

query I
CREATE TABLE tm380.dbo.tm380_ctas3 AS SELECT a.id FROM tm380.dbo.tm380_src a JOIN tm380.dbo.tm380_ctas1 b ON a.id = b.id;
----
20000

statement ok
COMMIT;

statement ok
RESET threads;

#------------------------------------------------------------------------------
# Review of #382, Medium: mssql_exec DDL under mssql_exec_invalidate_cache =
# false, in a transaction -- a rowid key learned on the pinned connection from
# an index that is then rolled back must not reach the shared entry.
#------------------------------------------------------------------------------

statement ok
SELECT mssql_exec('tm380', 'DROP TABLE IF EXISTS dbo.tm380_nokey; CREATE TABLE dbo.tm380_nokey (id int NOT NULL, v int NULL); INSERT INTO dbo.tm380_nokey VALUES (1, 0), (2, 0)');

statement ok
SELECT mssql_invalidate_cache('tm380', 'dbo', 'tm380_nokey');

# The shared entry exists before the transaction.
query I
SELECT count(*) FROM tm380.dbo.tm380_nokey;
----
2

statement ok
BEGIN;

statement ok
SELECT mssql_exec('tm380', 'CREATE UNIQUE INDEX ux_tm380_nokey ON dbo.tm380_nokey (id)');

query I
DELETE FROM tm380.dbo.tm380_nokey WHERE id = 1;
----
1

statement ok
ROLLBACK;

# The index is gone with the transaction; so is the key learned from it.
statement error
DELETE FROM tm380.dbo.tm380_nokey WHERE id = 1;
----
tm380_nokey

query I
SELECT count(*) FROM tm380.dbo.tm380_nokey;
----
2

#------------------------------------------------------------------------------
# Review of #382, Medium: CREATE SCHEMA in a transaction whose schema list is
# already loaded -- a table can be created in it at once.
#------------------------------------------------------------------------------

statement ok
SELECT mssql_exec('tm380', 'IF OBJECT_ID(''tm380s.t'') IS NOT NULL DROP TABLE tm380s.t; IF SCHEMA_ID(''tm380s'') IS NOT NULL EXEC(''DROP SCHEMA tm380s'')');

statement ok
SELECT mssql_invalidate_cache('tm380');

statement ok
BEGIN;

query I
SELECT count(*) > 0 FROM duckdb_schemas() WHERE database_name = 'tm380';
----
true

statement ok
CREATE SCHEMA tm380.tm380s;

statement ok
CREATE TABLE tm380.tm380s.t (id INTEGER);

statement ok
COMMIT;

query I
SELECT count(*) FROM tm380.tm380s.t;
----
0

#------------------------------------------------------------------------------
# Review of 0e12914: LookupSchema's FAST path must read the same schema list
# ScanSchemas does. mssql_exec DDL under mssql_exec_invalidate_cache = false
# marks the transaction's own layer (MarkChangedLocally), so the shared list --
# which still holds the dropped schema, that being the committed state -- must
# not answer the hit path. The CREATE SCHEMA case above goes through DuckDB's
# own DDL, which invalidates the shared cache and so never reaches this branch.
#------------------------------------------------------------------------------

statement ok
SELECT mssql_exec('tm380', 'IF SCHEMA_ID(''tm380x'') IS NULL EXEC(''CREATE SCHEMA tm380x'')');

statement ok
SELECT mssql_invalidate_cache('tm380');

statement ok
SET mssql_exec_invalidate_cache = false;

# Load the shared schema list, so the fast path has something to hit.
query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'tm380' AND schema_name = 'tm380x';
----
1

statement ok
BEGIN;

statement ok
SELECT mssql_exec('tm380', 'DROP SCHEMA tm380x');

# Before the fix the fast path read metadata_cache_ directly, found tm380x in
# the still-committed shared list and handed back a live schema entry.
statement error
CREATE TABLE tm380.tm380x.t (id INTEGER);
----
not found

statement ok
ROLLBACK;

# The ROLLBACK put the schema back; drop it for real.
statement ok
SELECT mssql_exec('tm380', 'IF SCHEMA_ID(''tm380x'') IS NOT NULL EXEC(''DROP SCHEMA tm380x'')');

statement ok
SELECT mssql_exec('tm380', 'DROP TABLE tm380s.t; DROP SCHEMA tm380s; DROP TABLE IF EXISTS dbo.tm380_src, dbo.tm380_ctas1, dbo.tm380_ctas2, dbo.tm380_ctas3, dbo.tm380_nokey');

statement ok
SELECT mssql_exec('tm380', 'DROP TABLE IF EXISTS dbo.tm380_copy, dbo.tm380_exec, dbo.tm380_commit, dbo.tm380_drop');

statement ok
DETACH tm380;

statement ok
RESET mssql_metadata_timeout;

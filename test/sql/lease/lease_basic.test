# name: test/sql/lease/lease_basic.test
# description: Issue #189 — mssql_lease/mssql_release acceptance test (TARGET STATE).
#              This test documents the fix proposed in
#              docs/proposals/issue-189-connection-lease-proposal.md and is written
#              against the API that proposal settles on, NOT against today's
#              behavior. It currently FAILS at the first statement below with a
#              binder error (mssql_lease is not a registered function) and is
#              expected to start passing once Phases 1-3 of the proposal's
#              implementation plan ship (MSSQLConnectionLease + ConnectionProvider
#              routing + the two scalar functions). Do not "fix" this test by
#              loosening its assertions — it is intentionally red.
#
#              See docs/proposals/issue-189-repro/ instead for a live repro of the
#              CURRENT (buggy) behavior via genuine SQL Server containers.
# group: [mssql]

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS lease_basic (TYPE mssql);

# ---------------------------------------------------------------------------
# Baseline (works today): without a lease, a ## table created by mssql_exec
# does not survive being read back — proves the test harness reaches a live
# server and that the underlying bug is really present, not a setup mistake.
# ---------------------------------------------------------------------------

statement ok
SELECT mssql_exec('lease_basic', 'SELECT 1 AS x INTO ##lease_basic_baseline');

# Churn the pool so the creating connection's RESET_CONNECTION flag fires.
statement ok
SELECT mssql_scan('lease_basic', 'SELECT 1');

statement error
SELECT * FROM mssql_scan('lease_basic', 'SELECT COUNT(*) AS c FROM ##lease_basic_baseline');
----
Invalid object name

# ---------------------------------------------------------------------------
# Target behavior: with a lease held, the same sequence must survive.
# ---------------------------------------------------------------------------

# mssql_lease returns the leased connection's SPID (BIGINT), matching @@SPID
# observed through mssql_exec/mssql_scan on the same context while held.
query I
SELECT mssql_lease('lease_basic') > 0;
----
true

query I
SELECT mssql_exec('lease_basic', 'SELECT 1 AS x INTO ##lease_basic_shared');
----
1

# SPID stability: two independent mssql_scan calls against this context hit
# the SAME physical connection while the lease is held.
query I
SELECT a.spid = b.spid
FROM (SELECT * FROM mssql_scan('lease_basic', 'SELECT @@SPID AS spid')) a,
     (SELECT * FROM mssql_scan('lease_basic', 'SELECT @@SPID AS spid')) b;
----
true

# Churn the pool with unrelated pooled statements. Because these do not use
# the lease, they must not disturb the leased connection's session state.
statement ok
SELECT mssql_scan('lease_basic', 'SELECT 1');

statement ok
SELECT mssql_scan('lease_basic', 'SELECT 2');

statement ok
SELECT mssql_scan('lease_basic', 'SELECT 3');

# The ## table survives the churn above — this is the assertion that fails
# today (see the baseline block: it currently does NOT survive step 1 of the
# churn, exactly as documented in the proposal's R1 reproduction).
query I
SELECT * FROM mssql_scan('lease_basic', 'SELECT COUNT(*) AS c FROM ##lease_basic_shared');
----
1

# Double-lease on the same context is a strict error (recommended design:
# no idempotent re-lease, to avoid masking logic errors).
statement error
SELECT mssql_lease('lease_basic');
----
lease already held

# Release drops the session: reset fires on next reuse.
query I
SELECT mssql_release('lease_basic');
----
true

# Releasing again (no lease held) returns false rather than erroring.
query I
SELECT mssql_release('lease_basic');
----
false

# Churn the pool once more so the released connection's reset fires.
statement ok
SELECT mssql_scan('lease_basic', 'SELECT 1');

statement error
SELECT * FROM mssql_scan('lease_basic', 'SELECT COUNT(*) AS c FROM ##lease_basic_shared');
----
Invalid object name

statement ok
DETACH lease_basic;

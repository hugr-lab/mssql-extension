# name: test/sql/copy/copy_connection_leak.test
# description: Test COPY TO connection leak prevention on errors
# group: [copy]

require mssql

# Skip if no test server available
require-env MSSQL_TEST_SERVER

statement ok
ATTACH '{MSSQL_TEST_SERVER}' AS db (TYPE mssql);

# This file counts connections, so it has to pin the number a COPY is allowed to
# open. Spec 057 step 7 let a successful COPY take one bulk-load session per
# worker thread, and the counts below — written when there was exactly one —
# started reporting 2 created where they expect 1 on any machine with more than
# one thread. That is the feature working, not a leak: `active_connections` stays
# 0 either way, which is what this file is actually about.
#
# One writer restores the shape these assertions describe. Parallel writers have
# their own coverage in parallel_writers.test.
statement ok
SET mssql_copy_parallel_writers = 1;

# Create test data
statement ok
CREATE TABLE test_data AS SELECT i AS id, 'row' || i::VARCHAR AS name FROM range(10) t(i);

# Create data with type mismatch (VARCHAR for INT column)
statement ok
CREATE TABLE varchar_data AS SELECT 'not_a_number' AS id FROM range(5) t(i);

#
# T012: Test bind phase errors don't leak connections
#

# Store initial pool stats.
# Schema note (#152): mssql_pool_stats() no longer exposes a `pool_size` column
# (the configured limit is not surfaced); use `total_connections` (current live
# count = idle + active) instead. `total_connections_created` was renamed to
# `connections_created`. After ATTACH the pool holds a single idle connection.
query IIII
SELECT total_connections, idle_connections, active_connections, connections_created FROM mssql_pool_stats('db');
----
1	1	0	1

# Try COPY to non-existent catalog (should fail before connection acquired)
statement error
COPY test_data TO 'nonexistent_catalog.dbo.test' (FORMAT 'bcp');
----
does not exist

# Verify pool stats unchanged
query IIII
SELECT total_connections, idle_connections, active_connections, connections_created FROM mssql_pool_stats('db');
----
1	1	0	1

#
# T013: Test sink phase errors release connections
#

# Create a target table with INT column
statement ok
SELECT mssql_exec('db', 'IF OBJECT_ID(''dbo.int_table'', ''U'') IS NOT NULL DROP TABLE dbo.int_table');

statement ok
SELECT mssql_exec('db', 'CREATE TABLE dbo.int_table (id INT)');

# Get current pool stats
query IIII
SELECT total_connections, idle_connections, active_connections, connections_created FROM mssql_pool_stats('db');
----
1	1	0	1

# COPY with type mismatch (VARCHAR to INT). Until spec 064 this errored at BIND
# — the pair check ran before the sink existed, so this block never tested what
# its title says. The pair is now admitted for the all-NULL case and the data
# check fires on the FIRST CHUNK, genuinely inside the sink, with INSERT BULK
# already open on the connection.
statement error
COPY varchar_data TO 'db.dbo.int_table' (FORMAT 'bcp', CREATE_TABLE false);
----
type mismatch

# NOT leaked (active = 0) — and not pooled either: a connection abandoned
# mid-INSERT BULK is dirty, and the error path destroys it rather than hand the
# next statement a broken stream. total = 0 IS the correct release here.
query IIII
SELECT total_connections, idle_connections, active_connections, connections_created FROM mssql_pool_stats('db');
----
0	0	0	1

# Cleanup
statement ok
SELECT mssql_exec('db', 'DROP TABLE dbo.int_table');

#
# T014: Test finalize phase errors release connections
#

# This is harder to test directly - finalize errors typically occur during
# network issues. We test that normal completion releases connections.

# Get current pool stats. connections_created is 2: T013 destroyed its dirty
# connection, so the cleanup mssql_exec above opened a fresh one.
query III
SELECT idle_connections, active_connections, connections_created FROM mssql_pool_stats('db');
----
1	0	2

# Run a successful COPY
statement ok
COPY test_data TO 'db.dbo.test_finalize' (FORMAT 'bcp', REPLACE true);

# Verify connection was released after successful COPY
query III
SELECT idle_connections, active_connections, connections_created FROM mssql_pool_stats('db');
----
1	0	2

# Cleanup
statement ok
DROP TABLE IF EXISTS db.dbo.test_finalize;

#
# T015: Test multiple failed COPYs don't leak connections
#

# Store initial stats
query III
SELECT idle_connections, active_connections, connections_created FROM mssql_pool_stats('db');
----
1	0	2

# Run 10 failing COPY operations
loop i 0 10

# Try to COPY to non-existent table with CREATE_TABLE=false
statement error
COPY test_data TO 'db.dbo.nonexistent_table_{i}' (FORMAT 'bcp', CREATE_TABLE false);
----
does not exist

endloop

# Verify no connections leaked after all failures — these fail at bind (the
# table check), on a clean pooled connection, so nothing is created or lost.
query III
SELECT idle_connections, active_connections, connections_created FROM mssql_pool_stats('db');
----
1	0	2

# Cleanup
statement ok
DROP TABLE test_data;

statement ok
DROP TABLE varchar_data;

statement ok
DETACH db;

# name: test/sql/copy/copy_udt_columns.test
# description: COPY no longer drops CLR UDT columns of an existing target in silence (issue #353)
# group: [copy]

# Environment variables required:
#   MSSQL_TESTDB_DSN - Connection string to test database
#
# The target-metadata query joined sys.types on system_type_id, and no sys.types
# row satisfies that for a CLR UDT (system_type_id 240). So a geometry,
# geography or hierarchyid column never reached the resolver at all: a source
# column feeding one was silently ignored and its values lost, and a NOT NULL
# target failed with "Cannot insert the value NULL into column ..." about a
# value the user had in fact supplied.
#
# The join is gone from all eight metadata queries — the COPY resolver's four
# and the four catalog ones spec 076 optimised, which is the half of the issue
# that was pure optimisation. The type name comes from
# ISNULL(TYPE_NAME(c.system_type_id), TYPE_NAME(c.user_type_id)), which is both
# correct for UDTs and measurably cheaper (497 µs -> 115 µs on a 102-column
# table) — so the column is visible, and a source that feeds it is refused by
# name instead of ignored.
#
# What did NOT change: a column no source feeds is still left out of the load
# and the server fills it, which is what made the old behaviour look fine.

require mssql

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '{MSSQL_TESTDB_DSN}' AS udtc (TYPE mssql);

statement ok
SELECT mssql_exec('udtc', 'IF OBJECT_ID(''dbo.UdtCopyTgt'') IS NOT NULL DROP TABLE dbo.UdtCopyTgt');

statement ok
SELECT mssql_exec('udtc', 'CREATE TABLE dbo.UdtCopyTgt (id INT NOT NULL PRIMARY KEY, g GEOMETRY NULL, h HIERARCHYID NULL, n INT NULL)');

statement ok
SELECT mssql_invalidate_cache('udtc');

# --- the bug: a source column named like the spatial column. It used to be
# accepted, report success and land NULL.
statement error
COPY (SELECT 1 AS id, '\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x40\x00\x00\x00\x00\x00\x00\x10\x40'::BLOB AS g, 7 AS n) TO 'mssql://udtc/dbo/UdtCopyTgt' (FORMAT 'bcp', CREATE_TABLE false);
----
the bulk-load wire cannot carry

# --- the message names the column and the type, because the user has to know
# which of their columns to remove.
statement error
COPY (SELECT 1 AS id, '/1/' AS h, 7 AS n) TO 'mssql://udtc/dbo/UdtCopyTgt' (FORMAT 'bcp', CREATE_TABLE false);
----
column 'h' of table '[dbo].[UdtCopyTgt]' has type hierarchyid

# --- nothing landed from either attempt: the refusal is at init, before a row
# is encoded. That is the whole point of refusing there rather than on the
# chunk that first carries a value — past a flush boundary those earlier
# batches are already committed, and a partial write is a poor answer to an
# issue about losing data.
query I
SELECT count(*) FROM udtc.dbo.UdtCopyTgt;
----
0

# --- and a source that omits the UDT columns still loads exactly as before,
# with the server filling them.
statement ok
COPY (SELECT 2 AS id, 8 AS n) TO 'mssql://udtc/dbo/UdtCopyTgt' (FORMAT 'bcp', CREATE_TABLE false);

query III
SELECT * FROM mssql_scan('udtc', 'SELECT id, n, CASE WHEN g IS NULL AND h IS NULL THEN 1 ELSE 0 END AS both_null FROM dbo.UdtCopyTgt');
----
2	8	1

# --- a CONSTANT NULL source for the UDT column loads. `NULL AS g` is the
# ordinary way to say "leave this column alone", and it worked before #353 —
# by accident, because the join hid the column entirely. It keeps working: the
# column is dropped from the load exactly like an omitted one and the server
# fills it. (It cannot be DECLARED instead: the type mapping gives geometry the
# VARCHAR fallback, and an nvarchar column against a geometry target makes the
# server refuse the whole INSERT BULK.)
#
# What makes this safe is the SOURCE TYPE, not the values: DuckDB types a bare
# NULL as SQLNULL and it is still SQLNULL here, and such a column has no other
# value it could hold. A typed source is refused instead — see the chunk
# boundary case below, which is what would otherwise partially load.
statement ok
COPY (SELECT 3 AS id, NULL AS g, NULL AS h, 9 AS n) TO 'mssql://udtc/dbo/UdtCopyTgt' (FORMAT 'bcp', CREATE_TABLE false);

query III
SELECT * FROM mssql_scan('udtc', 'SELECT id, n, CASE WHEN g IS NULL AND h IS NULL THEN 1 ELSE 0 END AS both_null FROM dbo.UdtCopyTgt WHERE id = 3');
----
3	9	1

# --- a TYPED null is NOT the same thing and is refused, which is what the
# message now says out loud. `CAST(NULL AS VARCHAR)` carries a type, so bind
# cannot know the column stays empty, and admitting it would be the partial-load
# trade again.
statement error
COPY (SELECT 4 AS id, CAST(NULL AS VARCHAR) AS h, 9 AS n) TO 'mssql://udtc/dbo/UdtCopyTgt' (FORMAT 'bcp', CREATE_TABLE false);
----
a TYPED null is not

# --- a TYPED source whose values only appear after a chunk boundary is refused
# at init, and nothing lands. 10000 rows crosses DuckDB's 2048-row vector many
# times over, so the first value is far from the first chunk; if the refusal
# had been left per-chunk, the rows before it would already be on the server.
# The row count is asserted, not just the error, because that is the half that
# would regress silently.
statement error
COPY (SELECT i AS id, CASE WHEN i > 5000 THEN '/1/' END AS h, i AS n FROM range(10000) t(i)) TO 'mssql://udtc/dbo/UdtCopyTgt' (FORMAT 'bcp', CREATE_TABLE false);
----
the bulk-load wire cannot carry

query I
SELECT count(*) FROM udtc.dbo.UdtCopyTgt WHERE id > 100;
----
0

# --- and when every matching column is dropped that way, the message says so
# rather than claiming no column matched — a different mistake with a different
# fix. It also has to survive the bare `catch (...)` around the metadata load,
# which used to turn this into a fallback that let the server complain instead.
statement error
COPY (SELECT NULL AS g) TO 'mssql://udtc/dbo/UdtCopyTgt' (FORMAT 'bcp', CREATE_TABLE false);
----
there is nothing to load

statement ok
SELECT mssql_exec('udtc', 'DROP TABLE dbo.UdtCopyTgt');

# =============================================================================
# rowversion: refused too, and that loses nothing. Measured by exempting the
# type and running the load — the server answers error 273, "Cannot insert an
# explicit value into a timestamp column". So the refusal moves a mid-stream
# server error to a named one at init. sql_variant is the same story with a
# different message: "Operand type clash: nvarchar(max) is incompatible with
# sql_variant" — it does NOT convert implicitly, as one might assume.
# =============================================================================

statement ok
SELECT mssql_exec('udtc', 'IF OBJECT_ID(''dbo.UdtRowver'') IS NOT NULL DROP TABLE dbo.UdtRowver');

statement ok
SELECT mssql_exec('udtc', 'CREATE TABLE dbo.UdtRowver (id INT NOT NULL PRIMARY KEY, rv ROWVERSION, v SQL_VARIANT NULL, n INT NULL)');

statement ok
SELECT mssql_invalidate_cache('udtc');

statement error
COPY (SELECT 1 AS id, 'x' AS rv, 5 AS n) TO 'mssql://udtc/dbo/UdtRowver' (FORMAT 'bcp', CREATE_TABLE false);
----
the bulk-load wire cannot carry

statement error
COPY (SELECT 1 AS id, 'anything' AS v, 5 AS n) TO 'mssql://udtc/dbo/UdtRowver' (FORMAT 'bcp', CREATE_TABLE false);
----
the bulk-load wire cannot carry

# --- omitting them loads, and the server generates the rowversion itself.
statement ok
COPY (SELECT 4 AS id, 11 AS n) TO 'mssql://udtc/dbo/UdtRowver' (FORMAT 'bcp', CREATE_TABLE false);

query III
SELECT * FROM mssql_scan('udtc', 'SELECT id, n, CASE WHEN rv IS NOT NULL AND v IS NULL THEN 1 ELSE 0 END AS ok FROM dbo.UdtRowver');
----
4	11	1

statement ok
SELECT mssql_exec('udtc', 'DROP TABLE dbo.UdtRowver');

# =============================================================================
# The metadata queries lost a join. These pin that nothing else moved.
# =============================================================================

statement ok
SELECT mssql_exec('udtc', 'IF OBJECT_ID(''dbo.UdtShapes'') IS NOT NULL DROP TABLE dbo.UdtShapes');

statement ok
SELECT mssql_exec('udtc', 'CREATE TABLE dbo.UdtShapes (id INT NOT NULL PRIMARY KEY, g GEOMETRY NULL, gg GEOGRAPHY NULL, h HIERARCHYID NULL, v SQL_VARIANT NULL, n NVARCHAR(10) NULL, d DECIMAL(9,3) NULL)');

statement ok
SELECT mssql_invalidate_cache('udtc');

# --- the catalog reports the same types it always did. It never had this bug:
# the catalog queries already used a LEFT JOIN with a TYPE_NAME fallback, so
# CLR UDT columns were visible there. This is here as the regression guard for
# the resolver change, and for the identical substitution those four queries
# got in the same change. Both spatial types map to DuckDB GEOMETRY, which is
# why `gg` is not its own thing.
query II
SELECT column_name, data_type FROM duckdb_columns() WHERE table_name = 'UdtShapes' ORDER BY column_index;
----
id	INTEGER
g	GEOMETRY
gg	GEOMETRY
h	VARCHAR
v	VARCHAR
n	MSSQL_NVARCHAR(10)
d	DECIMAL(9,3)

# --- and the rows still read.
statement ok
SELECT mssql_exec('udtc', 'INSERT INTO dbo.UdtShapes (id, n, d) VALUES (1, N''x'', 1.5)');

query III
SELECT id, n, d FROM udtc.dbo.UdtShapes;
----
1	x	1.500

statement ok
SELECT mssql_exec('udtc', 'DROP TABLE dbo.UdtShapes');

statement ok
DETACH udtc;

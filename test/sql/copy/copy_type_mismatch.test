# name: test/sql/copy/copy_type_mismatch.test
# description: Test COPY TO type mismatch error messages
# group: [copy]

require mssql

# Skip if no test server available
require-env MSSQL_TEST_SERVER

statement ok
ATTACH '${MSSQL_TEST_SERVER}' AS db (TYPE mssql);

#
# T021: Test VARCHAR to INT mismatch detection
#

# Create source with VARCHAR data
statement ok
CREATE TABLE varchar_source AS SELECT 'text_value' AS id, 'name' AS name FROM range(5) t(i);

# Create target with INT column
statement ok
SELECT mssql_exec('db', 'IF OBJECT_ID(''dbo.int_target'', ''U'') IS NOT NULL DROP TABLE dbo.int_target');

statement ok
SELECT mssql_exec('db', 'CREATE TABLE dbo.int_target (id INT, name NVARCHAR(100))');

# Try COPY - should fail with type mismatch error mentioning column name
statement error
COPY varchar_source TO 'db.dbo.int_target' (FORMAT 'bcp', CREATE_TABLE false);
----
type mismatch

# Cleanup
statement ok
SELECT mssql_exec('db', 'DROP TABLE dbo.int_target');

statement ok
DROP TABLE varchar_source;

#
# T022: Test compatible type conversions (should succeed)
#

# Create source with BIGINT data
statement ok
CREATE TABLE bigint_source AS SELECT i::BIGINT AS id FROM range(5) t(i);

# Create target with INT column (narrowing is allowed by BCP)
statement ok
SELECT mssql_exec('db', 'IF OBJECT_ID(''dbo.int_target'', ''U'') IS NOT NULL DROP TABLE dbo.int_target');

statement ok
SELECT mssql_exec('db', 'CREATE TABLE dbo.int_target (id INT)');

# BIGINT into an INT column now SUCCEEDS, range-checked per row (issue #153, spec 057).
#
# History, because this block has said the opposite twice. It first read "COPY should succeed"
# and expected `statement ok`; the check and this test landed in the same commit (3c8ac8e, spec
# 025) contradicting each other, and CI did not run .test files so nothing caught it (#192). It
# was then changed to `statement error` with the rationale that IsTypeCompatible is
# "deliberately widening-only".
#
# That rationale did not survive measurement. The widening-only policy it described never
# worked: TINYINT -> int, SMALLINT -> bigint and INTEGER -> bigint were all ACCEPTED by the
# validator and then died in the encoder with
#
#   INTERNAL Error: Expected unified vector format of type INT64, but found type INT32
#
# because EncodeToBcp picked the read width from the TARGET column while reading the SOURCE
# vector's memory. So the table advertised conversions the encoder could not perform, and the
# only thing "strict" achieved for narrowing was to reject the one case it could have done
# safely. Meanwhile DECIMAL(21,1) -> decimal(18,2) was waved through and silently moved the
# decimal point.
#
# With the encoder reading the source's own width and range-checking the target's, narrowing is
# safe: a value that does not fit raises before the batch is sent, naming the column and the
# accepted range, instead of wrapping or letting SQL Server abort the stream mid-load. And it
# removes real friction — DuckDB's range(), COUNT() and integer literals are all BIGINT, so
# every append to an `int` column previously needed an explicit cast.
statement ok
COPY bigint_source TO 'db.dbo.int_target' (FORMAT 'bcp', CREATE_TABLE false);

query II
SELECT COUNT(*), SUM(id) FROM db.dbo.int_target;
----
5	10

statement ok
SELECT mssql_exec('db', 'TRUNCATE TABLE dbo.int_target');

# A value that does not fit is refused client-side, by value and not by type.
statement error
COPY (SELECT 2147483648::BIGINT AS id) TO 'db.dbo.int_target' (FORMAT 'bcp', CREATE_TABLE false);
----
out of range for the target column

# An explicit cast remains the supported route and must keep working.
statement ok
COPY (SELECT id::INTEGER AS id FROM bigint_source) TO 'db.dbo.int_target' (FORMAT 'bcp', CREATE_TABLE false);

# Verify data
query I
SELECT COUNT(*) FROM db.dbo.int_target;
----
5

# Cleanup
statement ok
SELECT mssql_exec('db', 'DROP TABLE dbo.int_target');

statement ok
DROP TABLE bigint_source;

#
# T023: Test error message format contains column name and types
#

# Create source with incompatible types.
# A literal DATE, not CURRENT_DATE: the latter lives in the icu extension, which the test runner
# does not load, so this failed with "Scalar Function with name current_date is not in the
# catalog". The value is irrelevant here — only the DATE-vs-VARCHAR mismatch matters.
statement ok
CREATE TABLE date_source AS SELECT DATE '2024-01-15' AS date_col FROM range(3) t(i);

# Create target with VARCHAR column (incompatible)
statement ok
SELECT mssql_exec('db', 'IF OBJECT_ID(''dbo.varchar_target'', ''U'') IS NOT NULL DROP TABLE dbo.varchar_target');

statement ok
SELECT mssql_exec('db', 'CREATE TABLE dbo.varchar_target (date_col VARCHAR(10))');

# Note: DATE to VARCHAR might actually work in some cases via implicit conversion
# Let's test a more strict mismatch: BLOB to INT
statement ok
CREATE TABLE blob_source AS SELECT '\x0102'::BLOB AS data_col FROM range(3) t(i);

statement ok
SELECT mssql_exec('db', 'IF OBJECT_ID(''dbo.int_target2'', ''U'') IS NOT NULL DROP TABLE dbo.int_target2');

statement ok
SELECT mssql_exec('db', 'CREATE TABLE dbo.int_target2 (data_col INT)');

# COPY should fail with clear error message
statement error
COPY blob_source TO 'db.dbo.int_target2' (FORMAT 'bcp', CREATE_TABLE false);
----
type mismatch

# Cleanup
statement ok
SELECT mssql_exec('db', 'DROP TABLE IF EXISTS dbo.varchar_target');

statement ok
SELECT mssql_exec('db', 'DROP TABLE IF EXISTS dbo.int_target2');

statement ok
DROP TABLE date_source;

statement ok
DROP TABLE blob_source;

statement ok
DETACH db;

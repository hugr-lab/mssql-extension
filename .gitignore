# Build artifacts
build/
out/
bin/
obj/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.duckdb_extension

# vcpkg
vcpkg/
vcpkg_installed/
# vcpkg's binary cache (files provider). CI-only, but anyone reproducing a CI
# failure locally by exporting the same VCPKG_BINARY_SOURCES gets one too.
vcpkg_bincache/

# IDE files
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile.local

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
*.bak
# The committed backup samples (spec 085 task 10): synthetic, made on a clean instance by
# test/data/backup/generate.sh. No other .bak is ever committed (spec 085 T4).
!test/data/backup/*.bak

# Environment
.env
.env.local

.cache/clangd

# test output
duckdb_unittest_tempdir/
future-spec/
future-specs/
posts/

# unclebob/crapper's report. `crapper` writes .metrics/crap.edn on every run,
# and five CI gates under scripts/ now carry fixtures that invite running it,
# so an accidental `git add -A` would otherwise commit a snapshot of one
# machine's scores -- stale the next time anyone touches a function.
.metrics/

# The download-metrics chart is generated, not committed: it is published to
# GitHub Pages by .github/workflows/pages.yml and embedded in the README from
# there. A local run of scripts/update_download_metrics.py drops a copy here for
# eyeballing; committing it would resurrect a file that goes stale weekly.
docs/assets/download-metrics.svg

# Docusaurus docs site
website/node_modules/
website/build/
# The hugr-lab.com (IONOS) copy of the docs: DOCS_TARGET=ionos, pages.yml
website/build-ionos/
website/.docusaurus/

# Python bytecode (e.g. test/kerberos/gateway helpers imported locally)
__pycache__/
*.pyc

# Joern CPGs and scan reports (joern/README.md). A CPG is a build artifact of
# the current working tree and the report is only meaningful beside the tree it
# came from; both are regenerated by `make joern-cpg && make joern-scan`.
joern/out/

# spec 091: the generator's second-collation probes; byte-identical to cp<NNN>.psv by the
# emitter's own check at generation time, so not kept
tools/code_pages/data/*.alt.psv

# local design / research scratch (not committed)
design/
